{% liquid
  assign title = metaobject.title.value | default: 'Promotion'
  assign label = metaobject.label.value | default: 'Current offer'
  assign description = metaobject.description.value
  assign image = metaobject.image.value
  assign offer = metaobject.offer_value.value | default: 'Current offer'
  assign code = metaobject.code.value
  assign expiry = metaobject.expiry.value
  assign locations = metaobject.locations.value | default: 'All 7 Southern California stores'
  assign terms = metaobject.terms.value
  assign shop_link = metaobject.primary_link.value | default: metaobject.link.value | default: '/pages/tire-search'
  assign shop_cta = metaobject.primary_cta.value | default: metaobject.cta.value | default: 'Shop this offer'
%}

<style>
  .apd{--navy:#0d274e;--navy-2:#102f5f;--red:#d11f2c;--red-dark:#a91620;--ink:#122b55;--muted:#607091;--line:#d8e0eb;--pale:#f4f6fa;color:var(--ink);background:#fff;font-family:Montserrat,Arial,sans-serif}.apd *{box-sizing:border-box}.apd a{text-decoration:none}.apd .w{width:min(1150px,100%);padding:0 26px;margin:auto}.apd h1,.apd h2,.apd h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-weight:800;letter-spacing:.01em;text-transform:uppercase}.apd .crumb{border-bottom:1px solid var(--line);background:#f5f7fb;padding:13px 0;font-size:13px;color:var(--muted)}.apd .crumb a{color:var(--ink);font-weight:800}.apd .eyebrow{font-size:11px;line-height:1.1;letter-spacing:.13em;font-weight:900;text-transform:uppercase;color:var(--red)}.apd .hero{background:linear-gradient(135deg,#0b2142 0%,#153b75 100%);padding:52px 0 30px;color:#fff}.apd .tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:17px}.apd .tag{border:1px solid #627799;color:#d7e0ef;border-radius:4px;padding:7px 10px;font:800 11px ui-monospace,Consolas,monospace;letter-spacing:.06em;text-transform:uppercase}.apd .tag.red{background:var(--red);border-color:var(--red);color:#fff}.apd .tag.live{border-color:#19986f;color:#8ff1c3}.apd .hero-copy{display:grid;grid-template-columns:1.25fr .9fr;gap:48px;align-items:center}.apd h1{font-size:clamp(31px,4vw,50px);line-height:1.08;margin:0}.apd .lead{margin:0;color:#dbe5f4;font-size:17px;line-height:1.55}.apd .promo-image{margin-top:27px;overflow:hidden;border:1px solid rgba(255,255,255,.35);border-radius:14px;background:#fff}.apd .promo-image img{display:block;width:100%;height:auto;max-height:510px;object-fit:contain;background:#fff}.apd .action-row{border-top:1px solid rgba(225,235,249,.22);margin-top:25px;padding-top:22px;display:flex;align-items:center;gap:13px;flex-wrap:wrap}.apd .code-box{border:2px dashed #8597b2;border-radius:9px;padding:9px 14px;min-width:225px}.apd .code-box small{display:block;color:#bdcce1;font:800 10px ui-monospace,Consolas,monospace;letter-spacing:.13em;text-transform:uppercase}.apd .code-box b{display:block;margin-top:4px;font:800 20px ui-monospace,Consolas,monospace;letter-spacing:.04em}.apd .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 19px;border:1px solid transparent;border-radius:7px;color:#fff;background:var(--red);box-shadow:0 4px 0 var(--red-dark);font-size:12px;font-weight:900;text-transform:uppercase}.apd .button:hover{transform:translateY(-1px)}.apd .button.outline{color:#fff;background:transparent;border-color:#adbdd5;box-shadow:none}.apd .valid{margin-left:auto;text-align:right;color:#b9c7dc;font-size:12px}.apd .valid b{display:block;color:#fff;margin-top:4px}.apd .facts{display:grid;grid-template-columns:repeat(4,1fr);position:relative;margin-top:-1px;border:1px solid var(--line);border-radius:0 0 14px 14px;overflow:hidden;background:#fff;box-shadow:0 15px 26px rgba(7,28,63,.1)}.apd .fact{min-height:84px;padding:20px 21px;border-right:1px solid var(--line)}.apd .fact:last-child{border:0}.apd .fact small{display:block;margin-bottom:7px;color:var(--muted);font:800 10px ui-monospace,Consolas,monospace;letter-spacing:.13em;text-transform:uppercase}.apd .fact b{font-size:15px}.apd .section{padding:70px 0}.apd .section.alt{background:var(--pale)}.apd .head{text-align:center;max-width:720px;margin:0 auto 30px}.apd h2{font-size:clamp(25px,3vw,35px);line-height:1.15;margin:8px 0 12px}.apd .head p{margin:0;color:var(--muted);line-height:1.6}.apd .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.apd .how{padding:26px;border:1px solid var(--line);border-radius:12px;background:#fff}.apd .how-num{display:grid;place-items:center;width:34px;height:34px;margin-bottom:15px;border-radius:50%;background:var(--navy-2);color:#fff;font-weight:900}.apd .how h3{font-size:16px;margin:0 0 8px}.apd .how p{margin:0;color:var(--muted);line-height:1.6;font-size:14px}.apd .detail-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:27px;align-items:start}.apd .copy{color:#495c7e;line-height:1.75}.apd .copy h1,.apd .copy h2,.apd .copy h3{font-family:Montserrat,Arial,sans-serif;font-size:19px;letter-spacing:0;text-transform:none}.apd .copy a{color:var(--red);font-weight:800}.apd .terms{padding:25px;border:1px solid var(--line);border-radius:12px;background:#fff;color:#566784;font-size:14px;line-height:1.7}.apd .terms h3{font-size:15px;margin:0 0 10px}.apd .faq{max-width:870px;margin:auto;border-top:1px solid var(--line)}.apd .faq details{border-bottom:1px solid var(--line);padding:0}.apd .faq summary{position:relative;list-style:none;padding:21px 35px 21px 0;cursor:pointer;font-weight:800;color:var(--ink)}.apd .faq summary::-webkit-details-marker{display:none}.apd .faq summary:after{content:'+';position:absolute;right:2px;top:13px;color:var(--red);font-size:28px;font-weight:400}.apd .faq details[open] summary:after{content:'–'}.apd .faq .answer{padding:0 36px 20px 0;color:var(--muted);line-height:1.7}.apd .stores{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.apd .store{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#fff;color:var(--ink)}.apd .store img{display:block;width:100%;height:122px;object-fit:cover}.apd .store-body{padding:15px}.apd .store h3{font-family:Montserrat,Arial,sans-serif;font-size:16px;letter-spacing:0;text-transform:none;margin:0 0 7px}.apd .store p{margin:3px 0;color:var(--muted);font-size:12px;line-height:1.45}.apd .store strong,.apd .store span{color:var(--red);font-size:12px;font-weight:900}.apd .store span{display:block;margin-top:10px;text-transform:uppercase}.apd .related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.apd .related-card{overflow:hidden;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink)}.apd .related-card img{display:block;width:100%;height:156px;object-fit:cover}.apd .related-card div{padding:19px}.apd .related-card h3{font-family:Montserrat,Arial,sans-serif;font-size:16px;letter-spacing:0;text-transform:none;margin:0 0 8px}.apd .related-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.apd .related-card span{display:block;margin-top:13px;color:var(--red);font-size:12px;font-weight:900;text-transform:uppercase}.apd .center{text-align:center;margin-top:28px}.apd .final{padding:66px 0;background:var(--navy);color:#fff;text-align:center}.apd .final h2{margin-top:0}.apd .final p{margin:0 auto 25px;max-width:650px;color:#d4dff0;line-height:1.65}.apd .final .button.outline{margin-left:9px}@media(max-width:850px){.apd .hero-copy,.apd .detail-grid{grid-template-columns:1fr;gap:22px}.apd .stores{grid-template-columns:repeat(2,1fr)}.apd .facts{grid-template-columns:repeat(2,1fr)}.apd .fact:nth-child(2){border-right:0}.apd .fact:nth-child(-n+2){border-bottom:1px solid var(--line)}.apd .valid{margin-left:0;text-align:left}}@media(max-width:620px){.apd .w{padding:0 18px}.apd .hero{padding-top:35px}.apd .section{padding:48px 0}.apd .how-grid,.apd .stores,.apd .related{grid-template-columns:1fr}.apd .facts{grid-template-columns:1fr}.apd .fact{border-right:0;border-bottom:1px solid var(--line)}.apd .action-row{align-items:stretch}.apd .code-box,.apd .button{width:100%}.apd .final .button.outline{margin:14px 0 0}}
</style>

<main class="apd">
  {% render 'ats-offer-header' %}
  <div class="crumb"><div class="w"><a href="/">Home</a> &nbsp;›&nbsp; <a href="/pages/promotions">Promotions</a> &nbsp;›&nbsp; {{ title }}</div></div>

  <section class="hero"><div class="w">
    <div class="tags"><span class="tag">{{ label }}</span>{% if code != blank %}<span class="tag red">Promo code</span>{% endif %}{% if expiry != blank %}<span class="tag live">Live · ends {{ expiry }}</span>{% endif %}</div>
    <div class="hero-copy"><h1>{{ title }}</h1>{% if description != blank %}<p class="lead">{{ description }}</p>{% endif %}</div>
    {% if image != blank %}<div class="promo-image"><img src="{{ image | image_url: width: 2000 }}" alt="{{ title | escape }}"></div>{% endif %}
    <div class="action-row">
      {% if code != blank %}<div class="code-box"><small>Promo code</small><b>{{ code }}</b></div>{% endif %}
      <a class="button" href="{{ shop_link }}">{{ shop_cta }} →</a><a class="button outline" href="/pages/locations">Find a store</a>
      {% if expiry != blank %}<div class="valid">Valid through <b>{{ expiry }}</b></div>{% endif %}
    </div>
  </div></section>

  <div class="w"><div class="facts"><div class="fact"><small>Offer ends</small><b>{{ expiry | default: 'See offer terms' }}</b></div><div class="fact"><small>Valid at</small><b>{{ locations }}</b></div><div class="fact"><small>Included</small><b>Free mount &amp; balance</b></div><div class="fact"><small>Qualifies</small><b>Set of four wheels</b></div></div></div>

  <section class="section"><div class="w"><div class="head"><div class="eyebrow">How to use it</div><h2>Three Ways to Redeem</h2><p>Same discount whichever route you take.</p></div><div class="how-grid"><article class="how"><div class="how-num">1</div><h3>Shop online</h3><p>Use <b>{{ code | default: 'your offer code' }}</b> at checkout and select the offer that fits your vehicle.</p></article><article class="how"><div class="how-num">2</div><h3>Visit a store</h3><p>Bring this offer to any American Tire Stores location. An advisor will apply it at the counter.</p></article><article class="how"><div class="how-num">3</div><h3>Call ahead</h3><p>Call your nearest location to confirm availability for your wheel size before you visit.</p></article></div></div></section>

  <section class="section alt"><div class="w"><div class="detail-grid"><div><div class="eyebrow">Offer details</div><div class="copy">{{ metaobject.body | metafield_tag }}</div></div><aside class="terms"><h3>Terms &amp; conditions</h3>{% if terms != blank %}{{ terms | newline_to_br }}{% else %}Offer availability, eligibility and final price are confirmed by the selected store. See an advisor for exclusions and full offer details.{% endif %}</aside></div></div></section>

  <section class="section"><div class="w"><div class="head"><div class="eyebrow">Questions</div><h2>About This Offer</h2></div><div class="faq"><details open><summary>Do I need the promo code if I buy in store?</summary><div class="answer">No. Mention the offer to an advisor and they will apply it at the counter. The code is only needed for online checkout.</div></details><details><summary>Can I combine this with a tire rebate?</summary><div class="answer">Manufacturer rebates and other offers may have their own conditions. Ask an advisor to confirm which current offers can be combined.</div></details><details><summary>Does the discount apply to a set of two?</summary><div class="answer">This offer applies to a qualifying set of four wheels unless the offer terms state otherwise.</div></details><details><summary>Is mounting and balancing really free?</summary><div class="answer">Free mount and balance applies only when included in this promotion and with the qualifying purchase. Your advisor can confirm fitment and installation details.</div></details><details><summary>Which stores honour this offer?</summary><div class="answer">This promotion is valid at all seven American Tire Stores locations, subject to stock availability.</div></details></div></div></section>

  <section class="section alt"><div class="w"><div class="head"><div class="eyebrow">Where to redeem</div><h2>Valid at All Seven Stores</h2><p>Mon–Fri 8am–6pm · Sat 8am–5pm · call ahead to check stock in your size.</p></div><div class="stores">
    <a class="store" href="/pages/location-ventura-ca"><img src="{{ 'ats-locations-inline-05.jpg' | asset_url }}" alt="American Tire Stores Ventura storefront"><div class="store-body"><h3>Ventura</h3><p>5100 Telegraph Rd, Ventura, CA 93003</p><p><strong>(805) 644-3330</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-thousand-oaks-ca"><img src="{{ 'ats-locations-inline-06.jpg' | asset_url }}" alt="American Tire Stores Thousand Oaks storefront"><div class="store-body"><h3>Thousand Oaks</h3><p>621 E Thousand Oaks Blvd, Thousand Oaks, CA 91360</p><p><strong>(805) 495-7103</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-los-angeles-ca"><img src="{{ 'ats-locations-inline-07.jpg' | asset_url }}" alt="American Tire Stores Los Angeles storefront"><div class="store-body"><h3>Los Angeles</h3><p>1174 N. Western Ave., Los Angeles, CA 90029</p><p><strong>(323) 372-9372</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-glendale-ca"><img src="{{ 'ats-locations-inline-08.jpg' | asset_url }}" alt="American Tire Stores Glendale storefront"><div class="store-body"><h3>Glendale</h3><p>737 S Glendale Ave, Glendale, CA 91205</p><p><strong>(818) 243-3191</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-glendale-ii-ca"><img src="{{ 'ats-locations-inline-09.jpg' | asset_url }}" alt="American Tire Stores Glendale II storefront"><div class="store-body"><h3>Glendale II</h3><p>601 S Brand Blvd, Glendale, CA 91204</p><p><strong>(818) 244-7600</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-bellflower-ca"><img src="{{ 'ats-locations-inline-10.jpg' | asset_url }}" alt="American Tire Stores Bellflower storefront"><div class="store-body"><h3>Bellflower</h3><p>9509 Alondra Blvd, Bellflower, CA 90706</p><p><strong>(562) 804-4737</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
    <a class="store" href="/pages/location-cathedral-city-ca"><img src="{{ 'ats-locations-inline-11.jpg' | asset_url }}" alt="American Tire Stores Cathedral City storefront"><div class="store-body"><h3>Cathedral City</h3><p>68406 E Palm Canyon Dr, Cathedral City, CA 92234</p><p><strong>(760) 469-9510</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>
  </div></div></section>

  <section class="section"><div class="w"><div class="head"><div class="eyebrow">More like this</div><h2>Other Wheel Promotions</h2><p>Explore current savings on qualifying wheel sets.</p></div><div class="related"><a class="related-card" href="/pages/promotions"><img src="{{ 'ats-promo-wheel-02.jpg' | asset_url }}" alt="Lock Offroad wheels promotion"><div><h3>Lock Offroad — $40 Off Set of 4</h3><p>Save $40 on a set of four Lock Offroad wheels.</p><span>View offer →</span></div></a><a class="related-card" href="/pages/promotions"><img src="{{ 'ats-promo-wheel-03.jpg' | asset_url }}" alt="Raceline wheels promotion"><div><h3>Raceline — $40 Off Set of 4</h3><p>Save $40 on a set of four Raceline wheels.</p><span>View offer →</span></div></a><a class="related-card" href="/pages/promotions"><img src="{{ 'ats-promo-wheel-04.jpg' | asset_url }}" alt="TIS wheels promotion"><div><h3>TIS Wheels — $40 Off Set of 4</h3><p>Save $40 on a set of four TIS wheels.</p><span>View offer →</span></div></a></div><div class="center"><a class="button" href="/pages/promotions">All promotions →</a></div></div></section>

  <section class="final"><div class="w"><h2>Ready to Save {{ offer }}?</h2><p>{% if code != blank %}Use code <b>{{ code }}</b> online, or bring it to any of our seven Southern California stores.{% else %}Browse current offers and visit any of our seven Southern California stores.{% endif %}</p><a class="button" href="{{ shop_link }}">{{ shop_cta }} →</a><a class="button outline" href="/pages/financing">Finance from $0 down</a></div></section>
</main>
