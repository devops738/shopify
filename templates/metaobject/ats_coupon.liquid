{% liquid
  assign title = metaobject.title.value | default: 'Service coupon'
  assign label = metaobject.label.value | default: 'Service coupon'
  assign description = metaobject.description.value
  assign image = metaobject.image.value
  assign offer = metaobject.offer_value.value | default: 'Current coupon'
  assign code = metaobject.code.value
  assign expiry = metaobject.expiry.value
  assign locations = metaobject.locations.value | default: 'All 7 Southern California stores'
  assign terms = metaobject.terms.value
  assign primary_link = metaobject.primary_link.value | default: '/pages/services'
  assign primary_cta = metaobject.primary_cta.value | default: 'Book a service'
%}

<style>
.acd{--navy:#0d274e;--navy2:#102f5f;--red:#d11f2c;--red-dark:#a91620;--ink:#122b55;--muted:#607091;--line:#d8e0eb;--pale:#f4f6fa;background:#fff;color:var(--ink);font-family:Montserrat,Arial,sans-serif}.acd *{box-sizing:border-box}.acd a{text-decoration:none}.acd .w{width:min(1150px,100%);padding:0 26px;margin:auto}.acd h1,.acd h2,.acd h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-weight:800;letter-spacing:.01em;text-transform:uppercase}.acd .crumb{border-bottom:1px solid var(--line);background:#f5f7fb;padding:13px 0;font-size:13px;color:var(--muted)}.acd .crumb a{color:var(--ink);font-weight:800}.acd .eyebrow{font-size:11px;letter-spacing:.13em;font-weight:900;text-transform:uppercase;color:var(--red)}
.acd .hero{background:linear-gradient(165deg,#0e2247 0%,#0c1e3a 58%,#132c55 100%);padding:52px 0 30px;color:#fff}.acd .tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:17px}.acd .tag{border:1px solid #627799;color:#d7e0ef;border-radius:4px;padding:7px 10px;font:800 11px ui-monospace,Consolas,monospace;letter-spacing:.06em;text-transform:uppercase}.acd .tag.red{background:var(--red);border-color:var(--red);color:#fff}.acd .tag.live{border-color:#19986f;color:#8ff1c3}.acd .hero-copy{display:grid;grid-template-columns:1.25fr .9fr;gap:48px;align-items:center}.acd h1{font-size:clamp(31px,4vw,50px);line-height:1.08;margin:0}.acd .lead{margin:0;color:#dbe5f4;font-size:17px;line-height:1.55}.acd .coupon-image{margin-top:27px;overflow:hidden;border:1px solid rgba(255,255,255,.35);border-radius:14px;background:#fff}.acd .coupon-image img{display:block;width:100%;height:auto;max-height:510px;object-fit:contain;background:#fff}.acd .action-row{border-top:1px solid rgba(225,235,249,.22);margin-top:25px;padding-top:22px;display:flex;align-items:center;gap:13px;flex-wrap:wrap}.acd .code-box{border:2px dashed #8597b2;border-radius:9px;padding:9px 14px;min-width:225px}.acd .code-box small{display:block;color:#bdcce1;font:800 10px ui-monospace,Consolas,monospace;letter-spacing:.13em;text-transform:uppercase}.acd .code-box b{display:block;margin-top:4px;font:800 20px ui-monospace,Consolas,monospace;letter-spacing:.04em}.acd .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 19px;border:1px solid transparent;border-radius:7px;color:#fff;background:var(--red);box-shadow:0 4px 0 var(--red-dark);font-size:12px;font-weight:900;text-transform:uppercase;cursor:pointer}.acd .button.outline{color:#fff;background:transparent;border-color:#adbdd5;box-shadow:none}.acd .valid{margin-left:auto;text-align:right;color:#b9c7dc;font-size:12px}.acd .valid b{display:block;color:#fff;margin-top:4px}
.acd .facts{display:grid;grid-template-columns:repeat(4,1fr);position:relative;margin-top:-1px;border:1px solid var(--line);border-radius:0 0 14px 14px;overflow:hidden;background:#fff;box-shadow:0 15px 26px rgba(7,28,63,.1)}.acd .fact{min-height:84px;padding:20px 21px;border-right:1px solid var(--line)}.acd .fact:last-child{border:0}.acd .fact small{display:block;margin-bottom:7px;color:var(--muted);font:800 10px ui-monospace,Consolas,monospace;letter-spacing:.13em;text-transform:uppercase}.acd .fact b{font-size:15px}.acd .section{padding:70px 0}.acd .section.alt{background:var(--pale)}.acd .head{text-align:center;max-width:720px;margin:0 auto 30px}.acd h2{font-size:clamp(25px,3vw,35px);line-height:1.15;margin:8px 0 12px}.acd .head p{margin:0;color:var(--muted);line-height:1.6}
.acd .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.acd .how{padding:26px;border:1px solid var(--line);border-radius:12px;background:#fff}.acd .how-num{display:grid;place-items:center;width:34px;height:34px;margin-bottom:15px;border-radius:50%;background:var(--navy2);color:#fff;font-weight:900}.acd .how h3{font-size:16px;margin:0 0 8px}.acd .how p{margin:0;color:var(--muted);line-height:1.6;font-size:14px}.acd .detail-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:27px;align-items:start}.acd .copy{color:#495c7e;line-height:1.75}.acd .copy h1,.acd .copy h2,.acd .copy h3{font-family:Montserrat,Arial,sans-serif;font-size:19px;letter-spacing:0;text-transform:none}.acd .copy a{color:var(--red);font-weight:800}.acd .terms{padding:25px;border:1px solid var(--line);border-radius:12px;background:#fff;color:#566784;font-size:14px;line-height:1.7}.acd .terms h3{font-size:15px;margin:0 0 10px}.acd .faq{max-width:870px;margin:auto;border-top:1px solid var(--line)}.acd .faq details{border-bottom:1px solid var(--line)}.acd .faq summary{position:relative;list-style:none;padding:21px 35px 21px 0;cursor:pointer;font-weight:800;color:var(--ink)}.acd .faq summary::-webkit-details-marker{display:none}.acd .faq summary:after{content:'+';position:absolute;right:2px;top:13px;color:var(--red);font-size:28px;font-weight:400}.acd .faq details[open] summary:after{content:'–'}.acd .faq .answer{padding:0 36px 20px 0;color:var(--muted);line-height:1.7}
.acd .stores{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.acd .store{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#fff;color:var(--ink)}.acd .store img{display:block;width:100%;height:122px;object-fit:cover}.acd .store-body{padding:15px}.acd .store h3{font-family:Montserrat,Arial,sans-serif;font-size:16px;letter-spacing:0;text-transform:none;margin:0 0 7px}.acd .store p{margin:3px 0;color:var(--muted);font-size:12px;line-height:1.45}.acd .store strong,.acd .store span{color:var(--red);font-size:12px;font-weight:900}.acd .store span{display:block;margin-top:10px;text-transform:uppercase}.acd .related{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.acd .related-card{overflow:hidden;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink)}.acd .related-card img{display:block;width:100%;height:156px;object-fit:cover}.acd .related-card div{padding:19px}.acd .related-card h3{font-family:Montserrat,Arial,sans-serif;font-size:16px;letter-spacing:0;text-transform:none;margin:0 0 8px}.acd .related-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.acd .related-card span{display:block;margin-top:13px;color:var(--red);font-size:12px;font-weight:900;text-transform:uppercase}.acd .center{text-align:center;margin-top:28px}.acd .final{padding:66px 0;background:var(--navy);color:#fff;text-align:center}.acd .final h2{margin-top:0}.acd .final p{margin:0 auto 25px;max-width:650px;color:#d4dff0;line-height:1.65}.acd .final .button.outline{margin-left:9px}@media(max-width:850px){.acd .hero-copy,.acd .detail-grid{grid-template-columns:1fr;gap:22px}.acd .stores{grid-template-columns:repeat(2,1fr)}.acd .facts{grid-template-columns:repeat(2,1fr)}.acd .fact:nth-child(2){border-right:0}.acd .fact:nth-child(-n+2){border-bottom:1px solid var(--line)}.acd .valid{margin-left:0;text-align:left}}@media(max-width:620px){.acd .w{padding:0 18px}.acd .hero{padding-top:35px}.acd .section{padding:48px 0}.acd .how-grid,.acd .stores,.acd .related{grid-template-columns:1fr}.acd .facts{grid-template-columns:1fr}.acd .fact{border-right:0;border-bottom:1px solid var(--line)}.acd .action-row{align-items:stretch}.acd .code-box,.acd .button{width:100%}.acd .final .button.outline{margin:14px 0 0}}
@media print{body{background:#fff!important}.acd{color:#111!important;background:#fff!important}.acd>*:not(.hero){display:none!important}.acd .hero{display:block!important;padding:0!important;background:#fff!important;color:#111!important}.acd .hero .w{max-width:760px!important;padding:0!important}.acd .tags,.acd .action-row{display:none!important}.acd .hero-copy{display:block!important;margin:0 0 14px}.acd h1{font-size:28px!important;color:#111!important}.acd .lead{color:#444!important;font-size:14px!important;max-width:720px}.acd .coupon-image{width:min(558px,100%)!important;margin:12px 0 18px!important;border:0!important;border-radius:0!important;box-shadow:none!important}.acd .coupon-image img{max-height:none!important;object-fit:contain!important}.acd .hero + .w{display:none!important}.acd .hero~.section{display:none!important}.acd .hero~.section:nth-of-type(3){display:block!important;padding:0!important;background:#fff!important}.acd .hero~.section:nth-of-type(3) .detail-grid{display:block!important}.acd .hero~.section:nth-of-type(3) .detail-grid>div{display:none!important}.acd .hero~.section:nth-of-type(3) .terms{display:block!important;width:min(760px,100%)!important;border:1px solid #999!important;border-radius:0!important;padding:14px 16px!important;color:#222!important;background:#fff!important;font-size:13px!important}.acd .hero~.section:nth-of-type(3) .terms h3{color:#111!important;font-size:14px!important}.acd .hero~.section:nth-of-type(3) .terms br{line-height:1.7} @page{size:auto;margin:14mm}}
</style>

<main class="acd">
  {% render 'ats-offer-header' %}
  <div class="crumb"><div class="w"><a href="/">Home</a> &nbsp;›&nbsp; <a href="/pages/coupons">Coupons</a> &nbsp;›&nbsp; {{ title }}</div></div>
  <section class="hero"><div class="w">
    <div class="tags"><span class="tag">{{ label }}</span>{% if code != blank %}<span class="tag red">Coupon code</span>{% endif %}{% if expiry != blank %}<span class="tag live">Live · ends {{ expiry }}</span>{% endif %}</div>
    <div class="hero-copy"><h1>{{ title }}</h1>{% if description != blank %}<p class="lead">{{ description }}</p>{% endif %}</div>
    {% if image != blank %}<div class="coupon-image"><img src="{{ image | image_url: width: 2000 }}" alt="{{ title | escape }}"></div>{% endif %}
    <div class="action-row">{% if code != blank %}<div class="code-box"><small>Coupon code</small><b>{{ code }}</b></div>{% endif %}<a class="button" href="{{ primary_link }}">{{ primary_cta }} →</a><button type="button" class="button outline" onclick="window.print()">Print coupon</button>{% if expiry != blank %}<div class="valid">Valid through <b>{{ expiry }}</b></div>{% endif %}</div>
  </div></section>
  <div class="w"><div class="facts"><div class="fact"><small>Offer ends</small><b>{{ expiry | default: 'See coupon terms' }}</b></div><div class="fact"><small>Valid at</small><b>{{ locations }}</b></div><div class="fact"><small>Offer</small><b>{{ offer }}</b></div><div class="fact"><small>Redeem</small><b>Show or print coupon</b></div></div></div>
  <section class="section"><div class="w"><div class="head"><div class="eyebrow">How to use it</div><h2>Three ways to redeem</h2><p>Use the coupon in the way that is most convenient for you.</p></div><div class="how-grid"><article class="how"><div class="how-num">1</div><h3>Show your coupon</h3><p>Open this page on your phone or print it before your appointment.</p></article><article class="how"><div class="how-num">2</div><h3>Book service</h3><p>Book at your selected store, then mention the coupon to an advisor.</p></article><article class="how"><div class="how-num">3</div><h3>Redeem in store</h3><p>Present the coupon at the counter. Eligibility is confirmed before service begins.</p></article></div></div></section>
  <section class="section alt"><div class="w"><div class="detail-grid"><div><div class="eyebrow">Coupon details</div><div class="copy">{{ metaobject.body | metafield_tag }}</div></div><aside class="terms"><h3>Terms &amp; conditions</h3>{% if terms != blank %}{{ terms | newline_to_br }}{% else %}Present this coupon at your selected American Tire Stores location. Offer availability and eligibility are confirmed by the store.{% endif %}</aside></div></div></section>
  <section class="section"><div class="w"><div class="head"><div class="eyebrow">Questions</div><h2>About this coupon</h2></div><div class="faq"><details open><summary>Do I need to print the coupon?</summary><div class="answer">No. Showing this page on your phone at the counter works the same way. The print option is available if you prefer paper.</div></details><details><summary>Can I combine this with another offer?</summary><div class="answer">Coupons and current offers may have their own conditions. Ask an advisor to confirm which offers can be combined.</div></details><details><summary>Which stores accept this coupon?</summary><div class="answer">This coupon is valid at all seven American Tire Stores locations, subject to service availability.</div></details></div></div></section>
  <section class="section alt"><div class="w"><div class="head"><div class="eyebrow">Where to redeem</div><h2>Valid at all seven stores</h2><p>Mon–Fri 8am–6pm · Sat 8am–5pm · call ahead to check same-day availability.</p></div><div class="stores">
    {% assign store_data = 'Ventura|5100 Telegraph Rd, Ventura, CA 93003|(805) 644-3330|location-ventura-ca|ats-locations-inline-05.jpg;Thousand Oaks|621 E Thousand Oaks Blvd, Thousand Oaks, CA 91360|(805) 495-7103|location-thousand-oaks-ca|ats-locations-inline-06.jpg;Los Angeles|1174 N. Western Ave., Los Angeles, CA 90029|(323) 372-9372|location-los-angeles-ca|ats-locations-inline-07.jpg;Glendale|737 S Glendale Ave, Glendale, CA 91205|(818) 243-3191|location-glendale-ca|ats-locations-inline-08.jpg;Glendale II|601 S Brand Blvd, Glendale, CA 91204|(818) 244-7600|location-glendale-ii-ca|ats-locations-inline-09.jpg;Bellflower|9509 Alondra Blvd, Bellflower, CA 90706|(562) 804-4737|location-bellflower-ca|ats-locations-inline-10.jpg;Cathedral City|68406 E Palm Canyon Dr, Cathedral City, CA 92234|(760) 469-9510|location-cathedral-city-ca|ats-locations-inline-11.jpg' | split: ';' %}
    {% for item in store_data %}{% assign s = item | split: '|' %}<a class="store" href="/pages/{{ s[3] }}"><img src="{{ s[4] | asset_url }}" alt="American Tire Stores {{ s[0] }} storefront"><div class="store-body"><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p><p><strong>{{ s[2] }}</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span>View store →</span></div></a>{% endfor %}
  </div></div></section>
  <section class="section"><div class="w"><div class="head"><div class="eyebrow">More like this</div><h2>Other service coupons</h2><p>Browse other current coupon savings.</p></div><div class="related">{% assign count = 0 %}{% for coupon in shop.metaobjects.ats_coupon.values %}{% if coupon.system.id != metaobject.system.id and count < 3 %}<a class="related-card" href="{{ coupon.system.url }}">{% if coupon.image.value != blank %}<img src="{{ coupon.image.value | image_url: width: 800 }}" alt="{{ coupon.title.value | escape }}">{% endif %}<div><h3>{{ coupon.title.value }}</h3><p>{{ coupon.description.value }}</p><span>View coupon →</span></div></a>{% assign count = count | plus: 1 %}{% endif %}{% endfor %}</div><div class="center"><a class="button" href="/pages/coupons">All coupons →</a></div></div></section>
  <section class="final"><div class="w"><h2>Ready to book?</h2><p>Show this coupon on your phone or print it, then book a slot at your nearest store.</p><a class="button" href="{{ primary_link }}">{{ primary_cta }} →</a><a class="button outline" href="/pages/coupons">View all coupons</a></div></section>
</main>
