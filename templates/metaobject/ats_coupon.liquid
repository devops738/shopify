{% liquid
  assign title = metaobject.title.value | default: 'Coupon'
  assign label = metaobject.label.value | default: 'Printable coupon'
  assign description = metaobject.description.value
  assign image = metaobject.image.value
  assign code = metaobject.code.value
  assign offer = metaobject.offer_value.value | default: 'Current coupon'
  assign expiry = metaobject.expiry.value
  assign locations = metaobject.locations.value | default: 'All 7 Southern California stores'
  assign terms = metaobject.terms.value
  assign primary_link = metaobject.primary_link.value | default: metaobject.link.value | default: '/pages/services'
  assign primary_cta = metaobject.primary_cta.value | default: metaobject.cta.value | default: 'Book a service'
%}
<style>
  .acd{--navy:#102e5c;--red:#d21f2b;--ink:#102b56;--muted:#687897;--line:#dbe2ec;--pale:#f4f6fa;background:#fff;color:var(--ink);font-family:Montserrat,Arial,sans-serif}.acd *{box-sizing:border-box}.acd a{text-decoration:none}.acd .w{width:min(1100px,100%);padding:0 24px;margin:auto}.acd .crumb{padding:14px 0;background:#f5f7fb;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}.acd .crumb a{color:var(--ink);font-weight:800}.acd .hero{padding:54px 0;background:var(--pale)}.acd .hero-grid{display:grid;grid-template-columns:1fr .86fr;gap:42px;align-items:center}.acd .eye{color:var(--red);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.acd h1,.acd h2{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-weight:800;line-height:1.1;text-transform:uppercase}.acd h1{font-size:clamp(30px,4vw,52px);margin:11px 0}.acd .lead{color:var(--muted);line-height:1.65}.acd .code{display:inline-block;margin:12px 0 20px;border:2px dashed var(--red);border-radius:9px;background:#fff;padding:10px 14px;color:var(--red);font:800 20px ui-monospace,Consolas,monospace;letter-spacing:.06em}.acd .image{min-height:300px;border-radius:15px;overflow:hidden;background:var(--navy)}.acd .image img{display:block;width:100%;height:100%;object-fit:cover}.acd .btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border-radius:7px;background:var(--red);box-shadow:0 4px 0 #a4141d;color:#fff;font-size:12px;font-weight:900;text-transform:uppercase}.acd .btn.outline{margin-left:9px;background:#fff;color:var(--ink);border:2px solid var(--ink);box-shadow:none}.acd .panel{position:relative;margin:-29px auto 58px;padding:27px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 22px 45px rgba(10,31,62,.1)}.acd .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}.acd .fact{padding:15px;border-radius:10px;background:var(--pale)}.acd .fact small{display:block;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.acd .fact b{display:block;margin-top:5px}.acd .detail{display:grid;grid-template-columns:1.25fr .75fr;gap:28px}.acd .copy{color:#536583;line-height:1.75}.acd .copy h1,.acd .copy h2,.acd .copy h3{font-family:Montserrat,Arial,sans-serif;text-transform:none;font-size:19px}.acd .terms{padding:22px;border-radius:12px;background:var(--pale);color:#566784;line-height:1.7}.acd .terms h2{font-size:17px;margin-top:0}.acd .final{padding:52px 0;background:var(--navy);color:#fff;text-align:center}.acd .final h2{margin-top:0}.acd .final p{max-width:600px;margin:0 auto 22px;color:#d6e0ef;line-height:1.65}@media(max-width:760px){.acd .hero-grid,.acd .detail,.acd .facts{grid-template-columns:1fr}.acd .w{padding:0 18px}.acd .hero{padding:38px 0}.acd .btn,.acd .btn.outline{width:100%;margin:12px 0 0}.acd .panel{margin-top:0;border-radius:0}}
</style>
<main class="acd">{% render 'ats-offer-header' %}<div class="crumb"><div class="w"><a href="/">Home</a> › <a href="/pages/coupons">Coupons</a> › {{ title }}</div></div><section class="hero"><div class="w hero-grid"><div><div class="eye">{{ label }}</div><h1>{{ title }}</h1>{% if description != blank %}<p class="lead">{{ description }}</p>{% endif %}{% if code != blank %}<div class="code">{{ code }}</div>{% endif %}<div><a class="btn" href="{{ primary_link }}">{{ primary_cta }} →</a><button class="btn outline" type="button" onclick="window.print()">Print coupon</button></div></div><div class="image">{% if image != blank %}<img src="{{ image | image_url: width: 1200 }}" alt="{{ title | escape }}">{% endif %}</div></div></section><section class="w"><div class="panel"><div class="facts"><div class="fact"><small>Coupon</small><b>{{ offer }}</b></div><div class="fact"><small>Valid through</small><b>{{ expiry | default: 'See coupon terms' }}</b></div><div class="fact"><small>Available at</small><b>{{ locations }}</b></div></div><div class="detail"><div class="copy">{{ metaobject.body | metafield_tag }}</div><aside class="terms"><h2>Terms &amp; conditions</h2>{% if terms != blank %}{{ terms | newline_to_br }}{% else %}Present this coupon at your selected American Tire Stores location. Offer availability and eligibility are confirmed by the store.{% endif %}</aside></div></div></section><section class="final"><div class="w"><h2>Ready to save?</h2><p>Show this coupon on your phone or print it before visiting your nearest American Tire Stores location.</p><a class="btn" href="{{ primary_link }}">{{ primary_cta }} →</a></div></section></main>
