<body>
  {{ content_for_layout }}
  <style>
  .ats-call-btn{height:50px;padding:0 18px;border-radius:8px;background:#13315f;color:#fff;box-shadow:0 4px 0 #081a33;font-family:'Montserrat',system-ui,sans-serif;font-weight:900;font-size:12px;line-height:1.05;text-align:center;text-transform:uppercase;letter-spacing:.02em;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border:0;cursor:pointer}
  .ats-call-btn:hover{background:#0f2749}
  .ats-call-btn:active{transform:translateY(3px);box-shadow:0 1px 0 #081a33}
  .ats-call-pop{position:fixed;top:96px;right:24px;width:min(360px,calc(100vw - 32px));background:#fff;border:1px solid #dde2ea;border-radius:12px;box-shadow:0 26px 64px -20px rgba(0,0,0,.42);padding:16px;z-index:9999;display:none;color:#122240;text-align:left}
  .ats-call-pop.show{display:block}
  .ats-call-pop h4{font-family:'Montserrat',system-ui,sans-serif;font-size:13px;font-weight:900;color:#13315f;text-transform:uppercase;margin:0 0 8px}
  .ats-call-pop p{font-size:12.5px;color:#54617a;line-height:1.45;margin:0 0 12px}
  .ats-call-pop select{width:100%;height:44px;border:1.5px solid #dde2ea;border-radius:8px;background:#fff;color:#122240;font-family:'Montserrat',system-ui,sans-serif;font-size:13px;font-weight:700;padding:0 11px;margin-bottom:10px}
  .ats-call-pop .ats-call-now{width:100%;height:46px;border-radius:8px;background:#c51f28;color:#fff;box-shadow:0 4px 0 #86121a;font-family:'Montserrat',system-ui,sans-serif;font-weight:900;font-size:12px;text-transform:uppercase;letter-spacing:.02em;border:0;cursor:pointer}
  .ats-call-pop .ats-call-now:disabled{background:#b8beca;box-shadow:0 4px 0 #9299a6;cursor:not-allowed}
  @media(max-width:700px){.ats-call-btn{height:46px;padding:0 13px;font-size:11px}.ats-call-pop{top:82px;left:16px;right:16px;width:auto}}
  </style>
  <script>
  (function(){
    const ATS_CALL_STORES=[
      {id:52820,city:'Ventura',addr:'5100 Telegraph Rd',phone:'(805) 644-3330'},
      {id:52819,city:'Thousand Oaks',addr:'621 E Thousand Oaks Blvd',phone:'(805) 495-7103'},
      {id:61758,city:'Los Angeles',addr:'1174 N Western Ave',phone:'(323) 372-9372'},
      {id:52816,city:'Glendale',addr:'737 S Glendale Ave',phone:'(818) 243-3191'},
      {id:52818,city:'Glendale II',addr:'601 S Brand Blvd',phone:'(818) 244-7600'},
      {id:52814,city:'Bellflower',addr:'9509 Alondra Blvd',phone:'(562) 804-4737'},
      {id:52815,city:'Cathedral City',addr:'68406 E Palm Canyon Dr',phone:'(760) 469-9510'}
    ];
    function phoneDigits(phone){return String(phone||'').replace(/\D/g,'').replace(/^1/,'');}
    function hasPhone(phone){return phoneDigits(phone).length===10;}
    function tel(phone){return 'tel:+1'+phoneDigits(phone);}
    function readJson(key){try{const raw=localStorage.getItem(key)||sessionStorage.getItem(key);return raw?JSON.parse(raw):null}catch(e){return null}}
    function selectedStore(){
      const saved=readJson('atsTireConnectStore');
      if(saved){
        const id=saved.location_id||saved.locationId||saved.id;
        const known=ATS_CALL_STORES.find(s=>String(s.id)===String(id));
        if(known)return known;
      }
      const id=localStorage.getItem('atsTireConnectLocationId')||sessionStorage.getItem('atsTireConnectLocationId')||localStorage.getItem('tcLocationId')||sessionStorage.getItem('tcLocationId');
      if(id){const known=ATS_CALL_STORES.find(s=>String(s.id)===String(id));if(known)return known;}
      const select=document.getElementById('hstore');
      if(select&&select.value!==''){
        const direct=ATS_CALL_STORES.find(s=>String(s.id)===String(select.value));
        if(direct)return direct;
        const byIndex=/^\d+$/.test(String(select.value))?ATS_CALL_STORES[Number(select.value)]:null;
        if(byIndex)return byIndex;
      }
      return null;
    }
    function saveStore(store){
      try{
        const payload={name:'American Tire Stores — '+store.city,city:store.city,address:store.addr,addr:store.addr,phone:store.phone,id:store.id,location_id:store.id,locationId:store.id};
        localStorage.setItem('atsTireConnectStore',JSON.stringify(payload));
        sessionStorage.setItem('atsTireConnectStore',JSON.stringify(payload));
        ['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(store.id));sessionStorage.setItem(k,String(store.id));});
      }catch(e){}
    }
    function buildPopup(anchor){
      let pop=document.getElementById('atsCallPop');
      if(pop)return pop;
      pop=document.createElement('div');
      pop.className='ats-call-pop';
      pop.id='atsCallPop';
      pop.innerHTML='<h4>Select a store to call</h4><p>Choose the location first, then we’ll route the call to that store.</p><select id="atsCallStore"><option value="">Choose location…</option></select><button class="ats-call-now" id="atsCallNow" disabled>Call selected store</button>';
      document.body.appendChild(pop);
      const sel=pop.querySelector('#atsCallStore');
      ATS_CALL_STORES.forEach(s=>sel.add(new Option(s.city+' — '+s.phone,String(s.id))));
      sel.addEventListener('change',function(){
        const store=ATS_CALL_STORES.find(s=>String(s.id)===String(sel.value));
        pop.querySelector('#atsCallNow').disabled=!store;
      });
      pop.querySelector('#atsCallNow').addEventListener('click',function(){
        const store=ATS_CALL_STORES.find(s=>String(s.id)===String(sel.value));
        if(!store)return;
        saveStore(store);
        window.location.href=tel(store.phone);
      });
      return pop;
    }
    function init(){
      const right=document.querySelector('.brand-right');
      const appt=right&&right.querySelector('.appt-btn');
      if(!right||!appt||right.querySelector('.ats-call-btn'))return;
      const btn=document.createElement('button');
      btn.type='button';
      btn.className='ats-call-btn';
      btn.textContent='Call Store';
      appt.insertAdjacentElement('beforebegin',btn);
      btn.addEventListener('click',function(e){
        e.preventDefault();
        const store=selectedStore();
        if(store&&hasPhone(store.phone)){window.location.href=tel(store.phone);return;}
        const pop=buildPopup(btn);
        pop.classList.add('show');
        const sel=pop.querySelector('#atsCallStore');
        if(sel)sel.focus();
      });
      document.addEventListener('click',function(e){
        const pop=document.getElementById('atsCallPop');
        if(pop&&pop.classList.contains('show')&&!e.target.closest('#atsCallPop')&&!e.target.closest('.ats-call-btn'))pop.classList.remove('show');
      });
      document.addEventListener('keydown',function(e){const pop=document.getElementById('atsCallPop');if(e.key==='Escape'&&pop)pop.classList.remove('show');});
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
  })();
  </script>
  <style>
  #shopbook-section .tc-panel.ats-single-widget-panel,
  #shopbook-section #ats-location-widget,
  #shopbook-section #ats-appointment-widget,
  #shopbook-section #ats-shop-widget,
  #shopbook-section .tc-widget-target{
    height:auto!important;
    max-height:none!important;
    overflow:visible!important;
    contain:none!important;
  }
  #shopbook-section #ats-appointment-widget iframe,
  #shopbook-section #ats-shop-widget iframe,
  #shopbook-section .tc-widget-target iframe{
    width:100%!important;
    max-width:100%!important;
    min-height:720px!important;
  }
  </style>
  <script>
  (function(){
    function tcExpansionGuard(){
      var section=document.getElementById('shopbook-section');
      if(!section)return;
      var shell=document.getElementById('ats-location-widget');
      var panel=document.getElementById('ats-widget-panel');
      var root=document.getElementById('ats-appointment-widget')||document.getElementById('ats-shop-widget');
      if(!shell||!panel||!root)return;
      function measure(){
        var roots=[root,shell,panel].filter(Boolean);
        roots.forEach(function(el){
          el.style.height='auto';
          el.style.maxHeight='none';
          el.style.overflow='visible';
        });
        var rootHeight=Math.max(root.scrollHeight||0, root.getBoundingClientRect().height||0);
        var shellHeight=Math.max(shell.scrollHeight||0, shell.getBoundingClientRect().height||0);
        var needed=Math.max(rootHeight,shellHeight,260);
        if(needed>260){
          root.style.minHeight=needed+'px';
          shell.style.minHeight=needed+'px';
          panel.style.minHeight=(needed+70)+'px';
        }
        root.querySelectorAll('iframe').forEach(function(frame){
          var frameNeeded=Math.max(720, needed);
          frame.style.minHeight=frameNeeded+'px';
          frame.style.height=frameNeeded+'px';
        });
      }
      function schedule(){
        [0,80,180,360,700,1200].forEach(function(t){setTimeout(measure,t);});
      }
      schedule();
      root.addEventListener('click',schedule,true);
      root.addEventListener('change',schedule,true);
      shell.addEventListener('click',schedule,true);
      if(window.ResizeObserver){
        try{new ResizeObserver(schedule).observe(root);new ResizeObserver(schedule).observe(shell);}catch(e){}
      }
      if(window.MutationObserver){
        try{new MutationObserver(schedule).observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['class','style','aria-expanded']});}catch(e){}
      }
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',tcExpansionGuard);else tcExpansionGuard();
    window.addEventListener('load',tcExpansionGuard);
    document.addEventListener('click',function(e){
      if(e.target&&e.target.closest&&e.target.closest('#shopbook-section'))setTimeout(tcExpansionGuard,120);
    },true);
  })();
  </script>
