.tc-overlay.show{display:flex}
.tc-panel{width:min(1440px,98vw);height:94vh;max-height:94vh;background:#fff;border-radius:18px;box-shadow:0 30px 90px rgba(0,0,0,.38);overflow:hidden;display:flex;flex-direction:column}
