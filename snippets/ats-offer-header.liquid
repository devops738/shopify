<div class="promo"><div class="wrap">
  <span><b>Buy 3, Get 1 FREE</b> on most tires</span><span>·</span>
  <span>Financing from <b>$0 down</b></span><span>·</span><a href="/pages/promotions">See offers →</a>
</div></div>
<header>
  <div class="hbar-brand"><div class="wrap">
    <a href="/" class="logo" aria-label="American Tire Stores"><img src="{{ 'ats-locations-inline-01.png' | asset_url }}" alt="American Tire Stores"></a>
    <div class="brand-right">
      <div class="hgarage">
        <label class="hg-field hg-store" id="storeField"><span class="hg-ic"><img src="{{ 'ats-inline-01.png' | asset_url }}" alt=""></span><span class="hg-txt"><small>Selected Store <span class="hg-pen">✎</span></small><select id="hstore" onchange="if(window.onHStore)onHStore()"><option value="">Choose…</option><option value="0">Ventura</option><option value="1">Thousand Oaks</option><option value="2">Valencia</option><option value="3">Hollywood</option><option value="4">Glendale</option><option value="5">Glendale II</option><option value="6">Bellflower</option><option value="7">Costa Mesa</option><option value="8">Cathedral City</option></select></span></label>
        <div class="hg-sep"></div>
        <button class="hg-field hg-veh" id="vehField" type="button" onclick="if(window.toggleVeh)toggleVeh()"><span class="hg-ic"><img src="{{ 'ats-inline-02.png' | asset_url }}" alt=""></span><span class="hg-txt"><small>My Vehicle <span class="hg-pen">✎</span></small><b id="vehVal">Not selected…</b></span></button>
        <div class="veh-pop" id="vehPop"><div class="gp-row"><select id="hyear" onchange="if(window.hOnYear)hOnYear()"><option value="" disabled selected hidden>Select</option><option value="2024">2024</option><option value="2022">2022</option><option value="2020">2020</option><option value="2018">2018</option></select><select id="hmake" onchange="if(window.hOnMake)hOnMake()" disabled><option value="" disabled selected hidden>Select</option></select></div><div class="gp-row" style="grid-template-columns:1fr"><select id="hmodel" onchange="if(window.hOnModel)hOnModel()" disabled><option value="" disabled selected hidden>Select</option></select></div></div>
      </div>
      <a class="btn btn-red appt-btn" href="/pages/services">Book a Quick<br>Appointment</a>
      <button class="nav-toggle" id="ats-mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="ats-mobile-nav"><span></span><span></span><span></span></button>
    </div>
  </div></div>
  <div class="hbar-nav"><div class="wrap"><nav class="mainnav" aria-label="Main">
    <a href="/pages/tire-search">Tire Search</a><a href="/pages/wheel-brands">Wheel Search</a><a href="/pages/catalog">Packages</a><a href="/pages/services">Services</a><a href="/pages/locations">Locations</a><a href="/pages/promotions">Promotions</a><a href="/pages/coupons">Coupons</a><a href="/pages/financing">Financing</a>
  </nav></div></div>
</header>
<nav class="ats-mobile-nav" id="ats-mobile-nav" aria-label="Mobile navigation" hidden>
  <a href="/pages/tire-search">Tire Search</a><a href="/pages/wheel-brands">Wheel Search</a><a href="/pages/catalog">Packages</a><a href="/pages/services">Services</a><a href="/pages/locations">Locations</a><a href="/pages/promotions">Promotions</a><a href="/pages/coupons">Coupons</a><a href="/pages/financing">Financing</a>
</nav>
<style>
  .ats-mobile-nav{display:none}
  @media(max-width:980px){.ats-mobile-nav.show{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#dde2ea;border-bottom:1px solid #dde2ea;position:relative;z-index:39}.ats-mobile-nav a{background:#fff;color:#122240;padding:14px 20px;font:700 13px Montserrat,Arial,sans-serif;text-decoration:none}.ats-mobile-nav a:hover{background:#f4f6fa;color:#c51f28}}
  @media(max-width:480px){.ats-mobile-nav.show{grid-template-columns:1fr}.ats-mobile-nav a{padding:12px 24px}}
</style>
<script>
(() => {
  const stores=[
    {id:52820,city:'Ventura',addr:'3059 E Main St',phone:'(805) 826-1788'},
    {id:52819,city:'Thousand Oaks',addr:'621 E Thousand Oaks Blvd',phone:'(805) 379-1910'},
    {id:null,city:'Valencia',addr:'23510 Valencia Blvd, Unit A',phone:'(661) 596-1444'},
    {id:61758,city:'Hollywood',addr:'1174 N. Western Ave.',phone:'(323) 372-9372'},
    {id:52816,city:'Glendale',addr:'737 S Glendale Ave',phone:'(818) 243-3191'},
    {id:52818,city:'Glendale II',addr:'1130 S Central Ave',phone:'(818) 547-2010'},
    {id:52814,city:'Bellflower',addr:'9509 Alondra Blvd',phone:'(562) 804-4737'},
    {id:null,city:'Costa Mesa',addr:'2049 Harbor Blvd',phone:'(949) 802-6419'},
    {id:52815,city:'Cathedral City',addr:'68406 E Palm Canyon Dr',phone:'(760) 469-9510'}
  ];
  const makes={2024:{Toyota:['Camry','RAV4','Corolla','Tacoma'],Honda:['Civic','CR-V','Accord'],Ford:['F-150','Explorer','Escape']},2022:{Toyota:['Camry','RAV4','Highlander'],Honda:['Civic','CR-V','Pilot'],Ford:['F-150','Bronco','Mustang']},2020:{Toyota:['Corolla','RAV4','4Runner'],Honda:['Accord','CR-V'],Jeep:['Wrangler','Grand Cherokee']},2018:{Toyota:['Camry','Tacoma'],Honda:['Civic','Accord'],Nissan:['Altima','Rogue']}};
  const byId=id=>document.getElementById(id), option=(el,values)=>{el.innerHTML='<option value="" disabled selected hidden>Select</option>'+values.map(v=>'<option value="'+v+'">'+v+'</option>').join('');el.disabled=!values.length;};
  const persist=store=>{try{const data={name:'American Tire Stores — '+store.city,city:store.city,address:store.addr,addr:store.addr,phone:store.phone,id:store.id,location_id:store.id,locationId:store.id};localStorage.setItem('atsTireConnectStore',JSON.stringify(data));sessionStorage.setItem('atsTireConnectStore',JSON.stringify(data));if(store.id)['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(store.id));sessionStorage.setItem(k,String(store.id));});}catch(e){}};
  const init=()=>{const store=byId('hstore'),field=byId('storeField'),vehicle=byId('vehField'),pop=byId('vehPop'),year=byId('hyear'),make=byId('hmake'),model=byId('hmodel'),value=byId('vehVal');if(!store||!vehicle)return;
    try{const saved=JSON.parse(localStorage.getItem('atsTireConnectStore')||sessionStorage.getItem('atsTireConnectStore')||'null');const index=stores.findIndex(s=>saved&&(s.id&&String(s.id)===String(saved.id)||s.city===saved.city));if(index>=0){store.value=String(index);field.classList.add('set');}}catch(e){}
    store.addEventListener('change',()=>{const picked=stores[Number(store.value)];field.classList.toggle('set',!!picked);if(picked)persist(picked);});
    vehicle.addEventListener('click',()=>pop.classList.toggle('show'));
    year.addEventListener('change',()=>option(make,Object.keys(makes[year.value]||{})));
    make.addEventListener('change',()=>option(model,(makes[year.value]||{})[make.value]||[]));
    model.addEventListener('change',()=>{value.textContent=[year.value,make.value,model.value].filter(Boolean).join(' ')||'Not selected…';vehicle.classList.toggle('set',!!model.value);pop.classList.remove('show');});
    document.addEventListener('click',e=>{if(pop.classList.contains('show')&&!e.target.closest('#vehPop')&&!e.target.closest('#vehField'))pop.classList.remove('show');});
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();

  // Several legacy page sections include their original, hidden header and
  // initialise its old seven-store select by id.  Run after those scripts so
  // the visible shared header always exposes the current nine-store list.
  const restoreStoreList=()=>{
    const store=byId('hstore');
    if(!store) return;
    const selected=store.value;
    store.innerHTML='<option value="">Choose…</option>'+stores.map((item,index)=>'<option value="'+index+'">'+item.city+'</option>').join('');
    if(selected!=='' && stores[Number(selected)]) store.value=selected;
  };
  setTimeout(restoreStoreList,0);
  window.addEventListener('load',restoreStoreList,{once:true});
  const mobileToggle=byId('ats-mobile-nav-toggle'), mobileNav=byId('ats-mobile-nav');
  if(mobileToggle&&mobileNav) mobileToggle.addEventListener('click',()=>{const open=!mobileNav.classList.contains('show');mobileNav.classList.toggle('show',open);mobileNav.hidden=!open;mobileToggle.setAttribute('aria-expanded',String(open));});
})();
</script>
