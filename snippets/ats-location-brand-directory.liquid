{%- comment -%} The same tire and wheel brand assets used on the homepage. {%- endcomment -%}
<section class="ats-location-brand-directory" aria-labelledby="ats-location-brands-title">
  <div class="ats-location-brand-directory__inner">
    <div class="ats-location-brand-directory__heading">
      <p>Shop by brand</p>
      <h2 id="ats-location-brands-title">Tires and wheels for every drive</h2>
      <span>Browse the brands available through American Tire Stores, then choose your location for local fitment and availability.</span>
    </div>
    <div class="ats-location-brand-directory__groups">
      <div class="ats-location-brand-directory__group">
        <h3>Tire brands</h3>
        <div class="ats-location-brand-directory__logos">
          <a href="/pages/tire-search"><img src="{{ 'ats-inline-23.png' | asset_url }}" alt="Michelin tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-24.png' | asset_url }}" alt="Goodyear tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-25.png' | asset_url }}" alt="Continental tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-26.png' | asset_url }}" alt="Pirelli tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-27.png' | asset_url }}" alt="Falken tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-28.png' | asset_url }}" alt="Hankook tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-29.png' | asset_url }}" alt="Yokohama tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-30.png' | asset_url }}" alt="Nitto tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-31.png' | asset_url }}" alt="Kumho tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-32.png' | asset_url }}" alt="General tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-33.png' | asset_url }}" alt="Nexen tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-34.png' | asset_url }}" alt="Sumitomo tires" loading="lazy"></a>
        </div>
      </div>
      <div class="ats-location-brand-directory__group">
        <h3>Wheel brands</h3>
        <div class="ats-location-brand-directory__logos">
          <a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-american-racing.png' | asset_url }}" alt="American Racing wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-fuel-offroad.png' | asset_url }}" alt="Fuel Offroad wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-kmc.png' | asset_url }}" alt="KMC wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-method-race.png' | asset_url }}" alt="Method Race Wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-asanti.png' | asset_url }}" alt="Asanti wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-black-rhino.png' | asset_url }}" alt="Black Rhino wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-raceline.png' | asset_url }}" alt="Raceline wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-lock-offroad.png' | asset_url }}" alt="Lock Offroad wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-tis.png' | asset_url }}" alt="TIS wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-vision.png' | asset_url }}" alt="Vision wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-xd.png' | asset_url }}" alt="XD wheels" loading="lazy"></a><a href="/pages/wheel-brands"><img src="{{ 'ats-wheel-page-xxr.png' | asset_url }}" alt="XXR wheels" loading="lazy"></a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .ats-location-brand-directory{padding:66px 24px;background:#f4f6fa;color:#122240;font-family:Montserrat,system-ui,sans-serif}.ats-location-brand-directory__inner{max-width:1200px;margin:auto}.ats-location-brand-directory__heading{text-align:center;max-width:760px;margin:0 auto 32px}.ats-location-brand-directory__heading p{margin:0 0 9px;color:#d21f2a;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.ats-location-brand-directory__heading h2{margin:0 0 12px;color:#13315f;font-family:'Akira Expanded','Archivo',sans-serif!important;font-size:clamp(22px,3vw,32px);line-height:1.15;text-transform:uppercase}.ats-location-brand-directory__heading span{color:#596782;font-size:14px;line-height:1.6}.ats-location-brand-directory__groups{display:grid;grid-template-columns:1fr 1fr;gap:20px}.ats-location-brand-directory__group{background:#fff;border:1px solid #dce2ec;border-radius:14px;padding:22px}.ats-location-brand-directory__group h3{margin:0 0 15px;color:#13315f;font-family:'Akira Expanded','Archivo',sans-serif!important;font-size:14px;text-transform:uppercase}.ats-location-brand-directory__logos{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.ats-location-brand-directory__logos a{height:58px;border:1px solid #e1e6ee;border-radius:7px;display:flex;align-items:center;justify-content:center;padding:8px;background:#fff;transition:border-color .15s,transform .15s}.ats-location-brand-directory__logos a:hover{border-color:#d21f2a;transform:translateY(-2px)}.ats-location-brand-directory__logos img{max-width:100%;max-height:30px;width:auto;height:auto;object-fit:contain}@media(max-width:760px){.ats-location-brand-directory{padding:48px 18px}.ats-location-brand-directory__groups{grid-template-columns:1fr}.ats-location-brand-directory__logos{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
