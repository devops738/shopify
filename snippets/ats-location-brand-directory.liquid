{%- comment -%} The same tire and wheel brand assets used on the homepage. {%- endcomment -%}
<section class="ats-location-brand-directory" aria-labelledby="ats-location-brands-title">
  <div class="ats-location-brand-directory__inner">
    <div class="ats-location-brand-directory__heading">
      <p>Brands</p>
      <h2 id="ats-location-brands-title">Shop tires and wheels by brand</h2>
      <span>Compare premium, all-season, performance, and budget-friendly tires side by side. Every brand links to a search filtered to your vehicle and store, so you only see tires that actually fit.</span>
    </div>
    <div class="ats-location-brand-directory__rail"><button type="button" aria-label="Previous tire brands" class="ats-location-brand-directory__arrow">‹</button><div class="ats-location-brand-directory__logos"><a href="/pages/tire-search"><img src="{{ 'ats-inline-23.png' | asset_url }}" alt="Michelin tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-27.png' | asset_url }}" alt="Falken tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-31.png' | asset_url }}" alt="Kumho tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-35.png' | asset_url }}" alt="Kelly tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-24.png' | asset_url }}" alt="Goodyear tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-28.png' | asset_url }}" alt="Hankook tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-32.png' | asset_url }}" alt="General tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-36.png' | asset_url }}" alt="Atturo tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-25.png' | asset_url }}" alt="Continental tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-29.png' | asset_url }}" alt="Yokohama tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-33.png' | asset_url }}" alt="Nexen tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-37.png' | asset_url }}" alt="Arroyo tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-26.png' | asset_url }}" alt="Pirelli tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-30.png' | asset_url }}" alt="Nitto tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-34.png' | asset_url }}" alt="Sumitomo tires" loading="lazy"></a><a href="/pages/tire-search"><img src="{{ 'ats-inline-38.png' | asset_url }}" alt="Lionhart tires" loading="lazy"></a></div><button type="button" aria-label="More tire brands" class="ats-location-brand-directory__arrow">›</button></div>
    <div class="ats-location-brand-directory__dots" aria-hidden="true"><b></b><i></i><i></i></div>
    <div class="ats-location-brand-directory__actions"><a class="ats-location-brand-directory__button ats-location-brand-directory__button--red" href="/pages/tire-search">View all tire brands</a><a class="ats-location-brand-directory__button" href="/pages/wheel-brands">View all wheel brands</a></div>
  </div>
</section>
<style>
  .ats-location-brand-directory{padding:62px 24px;background:#f4f6fa;color:#122240;font-family:Montserrat,system-ui,sans-serif}.ats-location-brand-directory__inner{max-width:1000px;margin:auto}.ats-location-brand-directory__heading{text-align:center;max-width:900px;margin:0 auto 28px}.ats-location-brand-directory__heading p{margin:0 0 9px;color:#d21f2a;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.ats-location-brand-directory__heading h2{margin:0 0 12px;color:#13315f;font-family:'Akira Expanded','Archivo',sans-serif!important;font-size:clamp(22px,3vw,32px);line-height:1.15;text-transform:uppercase}.ats-location-brand-directory__heading span{display:block;color:#596782;font-size:14px;line-height:1.6}.ats-location-brand-directory__rail{display:flex;align-items:center;gap:12px}.ats-location-brand-directory__logos{flex:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.ats-location-brand-directory__logos a{height:82px;border:1px solid #dce2ec;border-radius:10px;display:flex;align-items:center;justify-content:center;padding:14px;background:#fff;transition:border-color .15s,transform .15s}.ats-location-brand-directory__logos a:hover{border-color:#d21f2a;transform:translateY(-2px)}.ats-location-brand-directory__logos img{max-width:100%;max-height:34px;width:auto;height:auto;object-fit:contain}.ats-location-brand-directory__arrow{width:38px;height:38px;flex:0 0 38px;border:1px solid #cbd6e5;border-radius:50%;background:#fff;color:#13315f;font-size:28px;line-height:1;cursor:pointer}.ats-location-brand-directory__dots{display:flex;justify-content:center;gap:6px;margin:22px 0 17px}.ats-location-brand-directory__dots>*{width:7px;height:7px;border-radius:50%;background:#c6d1e1}.ats-location-brand-directory__dots b{width:19px;border-radius:8px;background:#d21f2a}.ats-location-brand-directory__actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.ats-location-brand-directory__button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 23px;border:1.5px solid #13315f;border-radius:22px;background:#fff;color:#13315f;font-size:12px;font-weight:800;text-transform:uppercase;text-decoration:none}.ats-location-brand-directory__button--red{border-color:#d21f2a;background:#d21f2a;color:#fff}@media(max-width:720px){.ats-location-brand-directory{padding:48px 18px}.ats-location-brand-directory__arrow{display:none}.ats-location-brand-directory__logos{grid-template-columns:repeat(2,minmax(0,1fr))}.ats-location-brand-directory__logos a{height:72px}#ats-location-widget,.tc-widget-target,.tc-panel,.tc-mount,#ats-appointment-widget,#ats-shop-widget{width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;overflow:hidden!important}#ats-location-widget iframe,.tc-widget-target iframe,#ats-appointment-widget iframe,#ats-shop-widget iframe{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important}.tc-panel{padding-left:12px!important;padding-right:12px!important}}
</style>
