<style>
  .nap-soc{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:17px 0 20px}
  .nap-soc__lbl{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:800;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:#55627d}
  .nap-soc__link{width:48px;height:48px;border:2px solid #dfe5ef;border-radius:50%;display:grid;place-items:center;background:#fff;transition:border-color .15s,transform .15s}
  .nap-soc__link:hover{border-color:#13315f;transform:translateY(-2px)}
  .nap-soc__link svg{display:block;width:25px;height:25px}
  .nap-soc__link--facebook svg{width:26px;height:26px}
  .nap-soc__link--yelp svg{width:25px;height:25px}
  @media(max-width:560px){.nap-soc{gap:10px;margin:14px 0 18px}.nap-soc__lbl{width:100%;font-size:12px}.nap-soc__link{width:44px;height:44px}}
</style>
<div class="nap-soc" aria-label="Find American Tire Stores {{ city }} online">
  <span class="nap-soc__lbl">Find us on</span>
  <a class="nap-soc__link" href="{{ google }}" target="_blank" rel="noopener noreferrer" aria-label="Find American Tire Stores {{ city }} on Google">
