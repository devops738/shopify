    <svg viewBox="0 0 24 24" fill="#FF1A1A" aria-hidden="true"><path d="M12.1 1.4c1.2 0 2.1.6 2.3 1.8l.6 4.1c.1.6-.2 1.1-.8 1.3l-3.7 1.3c-.5.2-1.1-.1-1.2-.7L8.6 3.5c-.2-1.2.4-2 1.6-2.1l1.9 0zm5.7 9.2c.8-.1 1.5.4 1.7 1.1.2.8-.2 1.5-.9 1.8l-4.1 1.5c-.6.2-1.2-.1-1.4-.7-.2-.6.1-1.2.6-1.5l4.1-2.2zm-5.1 5.6c.5.5.5 1.2.1 1.7l-2.6 3.5c-.5.6-1.3.7-1.9.2-.6-.5-.7-1.3-.2-1.9l2.6-3.5c.5-.6 1.3-.6 1.9 0zm7.6.6c.5.4.6 1.1.3 1.6-.3.6-1 .8-1.6.5l-3.5-1.8c-.5-.3-.7-.9-.5-1.4.3-.5.9-.8 1.4-.6l3.9 1.7zM7.2 12.1c.3.6 0 1.3-.6 1.5l-3.9 1.1c-.7.2-1.4-.2-1.6-.9-.2-.7.2-1.4.9-1.6l3.9-1.1c.6-.2 1.3.1 1.4.9z"/></svg>
