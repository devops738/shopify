<style>
{% if page.handle == 'promotions' %}
#ats-page-content .final{box-sizing:border-box;width:100vw;max-width:none;margin-left:calc(50% - 50vw);padding:48px 24px;background:#14356a;color:white;text-align:center}
{% endif %}
.pk-ctx[hidden]{display:none!important}
@media(max-width:760px){
 #wh-widget>.wrap{padding-left:12px!important;padding-right:12px!important}
 #wh-widget #wh-mount,#pkg-widget #pkgMount{box-sizing:border-box;width:100%!important;max-width:100%!important;padding:8px!important;margin-left:0!important;margin-right:0!important;min-width:0}
 #wh-mount iframe,#pkgMount iframe{width:100%!important;max-width:100%!important;border:0}
 .fit-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:14px!important}
 .fit-chip{min-width:0}.fit-chip .fc-body{padding:12px!important}.fit-chip .fc-sz{font-size:16px!important;overflow-wrap:anywhere}.fit-chip .fc-lbl{overflow-wrap:anywhere}
 #brandDir .brand-grid:not([hidden]){display:grid;grid-auto-flow:column;grid-template-columns:none;grid-template-rows:repeat(4,84px);grid-auto-columns:calc((100% - 12px)/2);gap:12px;overflow-x:auto;max-width:100%;scroll-snap-type:x mandatory;padding-bottom:12px}
 #brandDir .brand-grid .brand-tile{box-sizing:border-box;height:84px;min-width:0;padding:10px;scroll-snap-align:start}
 #brandDir .brand-grid .brand-tile img{max-width:100%;max-height:48px;object-fit:contain}
}
@media(max-width:760px){
 #brands .brand-rail,#brandDir .brand-rail{grid-template-rows:repeat(2,84px);grid-auto-columns:calc((100% - 14px)/2);gap:14px;min-width:0;max-width:100%}
 #brands .brand-rail .blogo,#brandDir .brand-rail .blogo{width:auto;min-width:0;height:84px;padding:10px}
 #brands .blogo-img,#brandDir .blogo-img{max-width:100%;max-height:46px;object-fit:contain}
 .wh-rev{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}
 .wh-rev-card{min-width:0;padding:14px!important;overflow-wrap:anywhere}
 .wh-rev-card:last-child:nth-child(odd){grid-column:1/-1;justify-self:center;width:calc(50% - 6px);box-sizing:border-box}
 .loc-cards,.svc-locs,.pk-locs,.tp-locs{grid-template-columns:1fr!important;gap:16px!important}
 .loc-cards .loc-card{min-width:0;width:100%;padding:0;overflow:hidden}
}
{% if page.handle contains 'location-' %}
 .loc-hero .loc-cta{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 14px;width:100%}
 .loc-hero .loc-cta .btn{width:100%;min-width:0;min-height:64px;white-space:normal;text-align:center;padding:12px;font-size:14px;line-height:1.35;box-sizing:border-box}
 .loc-hero .loc-cta .ats-local-call{border:2px solid #c91b28;color:#c91b28;background:#fff}
 .mcta{display:none!important}
 .hd-grid a,.hd-grid b{color:#122240}
 @media(max-width:600px){.loc-hero .loc-cta .btn{font-size:12px;min-height:58px}.cta-row{display:flex;flex-wrap:wrap;gap:14px}.cta-row .btn{white-space:normal;max-width:100%}}
{% endif %}
</style>
<script>
document.addEventListener('DOMContentLoaded',function(){
 const path=location.pathname;
 if(path==='/pages/services'){
   const grid=document.querySelector('.svc-locs');
   if(grid&&!grid.textContent.includes('Signal Hill')){
     const card=document.createElement('article');card.className='svc-loc-card';
     card.innerHTML='<div style="aspect-ratio:16/9;background:#edf1f7;display:grid;place-items:center;color:#c91b28;font-weight:800">COMING SOON</div><div class="svc-loc-card__body"><h3>Signal Hill</h3><p>Signal Hill, CA</p><p>Coming soon</p></div>';
     grid.append(card);
   }
 }
 if(path.includes('/location-')){
   const hero=document.querySelector('.loc-hero');
   const actions=hero&&hero.querySelector('.loc-cta');
   const phone=hero&&hero.querySelector('.nap a[href^="tel:"]');
   if(actions&&phone&&!actions.querySelector('.ats-local-call')){
     const call=document.createElement('a');call.className='btn ats-local-call';
     function sync(){call.href=phone.href;call.textContent='☎ Call '+phone.textContent.replace(/[^0-9()+\-\s]/g,'').trim();}
     sync();actions.insertBefore(call,actions.children[1]);
     new MutationObserver(sync).observe(phone,{childList:true,subtree:true,attributes:true,attributeFilter:['href']});
   }
   document.querySelectorAll('section').forEach(section=>{
     const title=section.querySelector('h2');
     if(title&&/what to expect|serving .+nearby communities/i.test(title.textContent))section.remove();
   });
   const walker=document.createTreeWalker(document.getElementById('ats-page-content')||document.body,NodeFilter.SHOW_TEXT);
   const texts=[];while(walker.nextNode())texts.push(walker.currentNode);
   texts.forEach(node=>{if(!node.parentElement.closest('script,style')&&/Available at this location/i.test(node.nodeValue))node.nodeValue=node.nodeValue.replace(/Available at this location/gi,'');});
 }
 if(path.includes('/service-')){
   const heading=document.querySelector('main h1');
   const section=heading&&heading.closest('section');
   const photo=section&&section.querySelector('img');
   if(photo&&heading){
     const parent=photo.parentNode,next=photo.nextSibling;
     const media=matchMedia('(max-width:800px)');
     function arrange(){if(media.matches)heading.after(photo);else parent.insertBefore(photo,next);}
     arrange();media.addEventListener('change',arrange);
   }
 }
});
</script>
