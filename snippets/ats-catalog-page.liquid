{% liquid
  assign page_kind = kind | default: 'tires'
  assign heading = 'Find tires that fit your vehicle'
  assign lead = 'Shop live local tire inventory by vehicle or tire size. Select your store to see fitment, pricing, and availability.'
  assign product_type = 'tire'
  assign hero_image = 'ats-tire-page-tires-bnnr-new.jpg'
  assign brand_list = 'Michelin|ats-tire-page-b3.jpg,PIRELLI|ats-tire-page-b2.jpg,NITTO|ats-tire-page-b1.jpg,Continental|ats-tire-page-continental.png,Goodyear|ats-tire-page-goodyear.png,Falken|ats-tire-page-falken.png,General|ats-tire-page-general.png,Kumho|ats-tire-page-kumho.png,Hankook|ats-tire-page-hankook.png,Yokohama|ats-tire-page-yokohama.png' | split: ','
  if page_kind == 'wheels'
    assign heading = 'Find wheels that fit your vehicle'
    assign lead = 'Browse custom, off-road, and performance wheels with live fitment confirmation from your selected store.'
    assign product_type = 'wheel'
    assign hero_image = 'ats-wheel-page-your-wheel-superstore-american-tire-stores-flat.jpg'
    assign brand_list = 'Black Rhino|ats-wheel-page-wheels-featured-black-rhino.jpg,Vision|ats-wheel-page-wheels-featured-vision.jpg,ICON|ats-wheel-page-wheels-featured-icon.jpg,Method Race|ats-wheel-page-method-race.png,Fuel Offroad|ats-wheel-page-fuel-offroad.png,KMC|ats-wheel-page-kmc.png,Raceline|ats-wheel-page-raceline.png,Lock Offroad|ats-wheel-page-lock-offroad.png,TIS|ats-wheel-page-tis.png,XXR|ats-wheel-page-xxr.png' | split: ','
  elsif page_kind == 'packages'
    assign heading = 'Build a tire and wheel package that fits'
    assign lead = 'Choose your vehicle and store to build a complete package. Mounting, balancing, TPMS reset, and torque-to-spec are included.'
    assign product_type = 'package'
    assign hero_image = 'ats-inline-08.jpg'
    assign brand_list = 'Daily Driver|ats-inline-06.jpg,Performance|ats-inline-07.jpg,Truck & SUV|ats-inline-08.jpg,Off-road|ats-inline-03.jpg' | split: ','
  endif
%}
<style>
.ats-catalog{--navy:#0c1e3a;--brand:#13315f;--red:#c51f28;--line:#dde2ea;--slate:#596982;font-family:Montserrat,Arial,sans-serif;color:#122240;background:#fff}.ats-catalog *{box-sizing:border-box}.ats-catalog .wrap{max-width:1200px;margin:auto;padding:0 24px}.ats-catalog .crumb{border-bottom:1px solid var(--line);padding:12px 0;color:#697791;font-size:13px}.ats-catalog .crumb a{color:var(--brand);font-weight:800;text-decoration:none}.ats-catalog .hero{position:relative;isolation:isolate;overflow:hidden;background:var(--navy);color:#fff}.ats-catalog .hero:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,23,50,.95),rgba(8,23,50,.83) 45%,rgba(8,23,50,.47));z-index:-1}.ats-catalog .hero-bg{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}.ats-catalog .hero .wrap{display:grid;grid-template-columns:minmax(0,1fr) 480px;gap:54px;padding-top:62px;padding-bottom:62px;align-items:center}.ats-catalog .eyebrow{color:#ff6370;font-size:11px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.ats-catalog h1,.ats-catalog h2,.ats-catalog h3{font-family:'Akira Expanded','Archivo',Montserrat,Arial,sans-serif;text-transform:uppercase;line-height:1.08}.ats-catalog h1{font-size:clamp(30px,4vw,52px);margin:12px 0}.ats-catalog .lead{font-size:16px;line-height:1.65;color:#d7e2f2;max-width:58ch}.ats-catalog .checks{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:20px;color:#fff;font-weight:700;font-size:13px}.ats-catalog .checks b{color:#5be293}.ats-catalog .finder{padding:24px;background:#fff;color:#122240;border-radius:14px;box-shadow:0 22px 55px -25px #000}.ats-catalog .finder h2{margin:0;font-size:19px;color:var(--brand)}.ats-catalog .finder p{font-size:13px;color:var(--slate);margin:6px 0 17px}.ats-catalog .fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ats-catalog label{display:block;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#596982}.ats-catalog select{width:100%;height:46px;margin-top:5px;border:1px solid var(--line);border-radius:7px;background:#fff;padding:0 10px;font:600 14px Montserrat,Arial,sans-serif;color:#122240}.ats-catalog .full{grid-column:1/-1}.ats-catalog .finder button,.ats-catalog .primary{width:100%;margin-top:14px;min-height:50px;border:0;border-radius:8px;background:var(--red);color:#fff;font:900 13px Montserrat,Arial,sans-serif;letter-spacing:.03em;text-transform:uppercase;box-shadow:0 4px 0 #86121a;cursor:pointer}.ats-catalog .trust{padding:12px 0 0;text-align:center;color:#697791;font-size:11px}.ats-catalog .section{padding:70px 0}.ats-catalog .section.alt{background:#f4f6fa}.ats-catalog .intro{text-align:center;max-width:760px;margin:0 auto 30px}.ats-catalog .intro h2{font-size:clamp(24px,3vw,35px);color:var(--brand);margin:9px 0}.ats-catalog .intro p{color:var(--slate);line-height:1.65}.ats-catalog .brand-rail{display:flex;overflow:auto;gap:14px;scroll-snap-type:x mandatory;padding:6px 2px 18px}.ats-catalog .brand-card{min-width:210px;min-height:118px;scroll-snap-align:start;display:flex;align-items:center;justify-content:center;padding:18px;border:1px solid var(--line);border-radius:12px;background:#fff;text-decoration:none;transition:.2s}.ats-catalog .brand-card:hover{transform:translateY(-3px);border-color:var(--brand);box-shadow:0 18px 35px -28px #10264a}.ats-catalog .brand-card img{max-width:160px;max-height:72px;object-fit:contain}.ats-catalog .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.ats-catalog .step{padding:25px;border:1px solid var(--line);border-radius:12px;background:#fff}.ats-catalog .num{display:grid;place-items:center;width:34px;height:34px;background:var(--red);border-radius:50%;color:#fff;font-weight:900;margin-bottom:14px}.ats-catalog .step h3{font-size:17px;color:var(--brand)}.ats-catalog .step p{font-size:14px;line-height:1.6;color:var(--slate)}.ats-catalog .widget{min-height:280px;border:1px solid var(--line);border-radius:14px;background:#fff;padding:20px;box-shadow:0 18px 40px -34px rgba(0,0,0,.5)}.ats-catalog .widget-status{display:flex;align-items:center;justify-content:center;min-height:220px;text-align:center;color:var(--slate);font-size:14px}.ats-shared-footer{background:#1b47a3;color:#fff;position:relative}.ats-shared-footer:before{content:'';height:4px;background:#c51f28;position:absolute;inset:0 0 auto}.ats-shared-footer .wrap{max-width:1200px;margin:auto;padding:48px 24px 28px}.footer-grid{display:grid;grid-template-columns:1.45fr repeat(4,1fr);gap:28px}.footer-logo{width:175px;height:auto;filter:brightness(0) invert(1);margin-bottom:13px}.ats-shared-footer h3{font:800 11px Montserrat,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;margin:0 0 12px}.ats-shared-footer p,.ats-shared-footer a{font-size:13px;color:#d3e0f5;line-height:1.65;text-decoration:none}.ats-shared-footer a{display:block;padding:2px 0}.ats-shared-footer a:hover{color:#fff}.footer-bottom{border-top:1px solid rgba(255,255,255,.2);padding-top:18px;margin-top:26px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:#c6d5ee;font-size:12px}@media(max-width:850px){.ats-catalog .hero .wrap{grid-template-columns:1fr;gap:30px}.ats-catalog .hero{background-position:center}.ats-catalog .steps{grid-template-columns:1fr}.footer-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.ats-catalog .wrap{padding:0 18px}.ats-catalog .hero .wrap{padding-top:44px;padding-bottom:44px}.ats-catalog .fields{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.ats-shared-footer .wrap{padding-left:18px;padding-right:18px}}
</style>
<main class="ats-catalog ats-catalog--{{ page_kind }}">
  {%- comment -%}
    The theme layout supplies the shared ATS header and footer to every
    non-homepage template. Rendering either here created a second navigation
    shell on tire, wheel, and package pages and caused the brand content to
    start below an incorrect header.
  {%- endcomment -%}
  <div class="crumb"><div class="wrap"><a href="/">Home</a> &nbsp;›&nbsp; {{ heading }}</div></div>
  <section class="hero"><img class="hero-bg" src="{{ hero_image | asset_url }}" alt="" aria-hidden="true"><div class="wrap"><div><div class="eyebrow">American Tire Stores · 9 Southern California locations</div><h1>{{ heading }}</h1><p class="lead">{{ lead }}</p><div class="checks"><span><b>✓</b> Live local availability</span><span><b>✓</b> Fitment verified</span><span><b>✓</b> Same-day installation</span></div></div><div class="finder"><h2>Start with your fit</h2><p>Select your vehicle and store. The live TireConnect catalog opens with your choices.</p><div class="fields"><label>Year<select id="atsY"><option value="">Select year</option><option>2026</option><option>2025</option><option>2024</option><option>2023</option><option>2022</option><option>2021</option><option>2020</option></select></label><label>Make<select id="atsM"><option value="">Select make</option><option>Toyota</option><option>Honda</option><option>Ford</option><option>Chevrolet</option><option>Jeep</option><option>Tesla</option></select></label><label class="full">Model<select id="atsModel"><option value="">Select model</option><option>Choose after make</option></select></label><label class="full">Choose your store<select id="atsStore"><option value="">Choose a store</option><option value="52820">Ventura — 3059 E Main St</option><option value="52819">Thousand Oaks — 621 E Thousand Oaks Blvd</option><option>Valencia — 23510 Valencia Blvd</option><option value="61758">Hollywood — 1174 N. Western Ave.</option><option value="52816">Glendale — 737 S Glendale Ave</option><option value="52818">Glendale 2 — 1130 S Central Ave</option><option value="52814">Bellflower — 9509 Alondra Blvd</option><option>Costa Mesa — 2049 Harbor Blvd</option><option value="52815">Cathedral City — 68406 E Palm Canyon Dr</option></select></label></div><button type="button" data-ats-open-widget>Find my {{ product_type }}s →</button><div class="trust">Pricing and availability are shown for your selected store.</div></div></div></section>
  <section class="section"><div class="wrap"><div class="intro"><div class="eyebrow">Shop by brand</div><h2>{% if page_kind == 'packages' %}Choose your package style{% else %}Popular {{ product_type }} brands{% endif %}</h2><p>Swipe or scroll through popular brands. Each selection keeps your vehicle and selected store in context.</p></div><div class="brand-rail">{% for item in brand_list %}{% assign pair = item | split: '|' %}<a class="brand-card" href="#ats-live-widget" data-brand="{{ pair[0] | escape }}"><img src="{{ pair[1] | asset_url }}" alt="{{ pair[0] }} {{ product_type }}"></a>{% endfor %}</div></div></section>
  <section class="section alt"><div class="wrap"><div class="intro"><div class="eyebrow">Live catalog</div><h2>Search {{ product_type }}s with TireConnect</h2><p>Enter your vehicle and selected store above, then use the live catalog below for exact fitment and local inventory.</p></div><div id="ats-live-widget" class="widget"><div class="widget-status">Loading the {{ product_type }} catalog…</div></div></div></section>
  <section class="section"><div class="wrap"><div class="intro"><div class="eyebrow">How it works</div><h2>Simple from search to installation</h2></div><div class="steps"><article class="step"><div class="num">1</div><h3>Choose your vehicle</h3><p>Start with year, make, and model so only compatible options are shown.</p></article><article class="step"><div class="num">2</div><h3>Set your store</h3><p>Local availability, installation options, and pricing are connected to your chosen store.</p></article><article class="step"><div class="num">3</div><h3>Finish with confidence</h3><p>Review fitment and book professional installation at any of our nine locations.</p></article></div></div></section>
</main>
<script>
(function(){const target=document.getElementById('ats-live-widget');if(!target)return;const type='{{ product_type }}';const status=target.querySelector('.widget-status');function selected(){return{year:document.getElementById('atsY').value,make:document.getElementById('atsM').value,model:document.getElementById('atsModel').value,locationId:document.getElementById('atsStore').value}}function open(){const v=selected();try{if(v.locationId)localStorage.setItem('atsTireConnectLocationId',v.locationId);localStorage.setItem('atsTireConnectVehicle',JSON.stringify(v))}catch(e){}if(typeof window.TCWidget==='undefined'){status.textContent='The live catalog could not load. Please refresh and try again.';return}target.innerHTML='';window.TCWidget.init({apikey:'c097aed9ad8c441bfff05ae020ca53f0',apiKey:'c097aed9ad8c441bfff05ae020ca53f0',container:'ats-live-widget',locationId:v.locationId,location_id:v.locationId,location_lock:!!v.locationId,locale:'en_US',allowed_products:[type],product_type:type,year:v.year,make:v.make,model:v.model,vehicle:v,redirect_url:location.pathname,catalog_url:location.pathname})}function load(){const s=document.createElement('script');s.src='https://app.tireconnect.ca/js/widget.js';s.async=true;s.onload=open;s.onerror=()=>status.textContent='Unable to load TireConnect. Please try again shortly.';document.head.appendChild(s)}document.querySelector('[data-ats-open-widget]').addEventListener('click',()=>{if(window.TCWidget)open();else load();document.getElementById('ats-live-widget').scrollIntoView({behavior:'smooth',block:'start'})});document.querySelectorAll('.brand-card').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();document.getElementById('ats-live-widget').scrollIntoView({behavior:'smooth',block:'start'});if(window.TCWidget)open();else load()}));load()})();
</script>
