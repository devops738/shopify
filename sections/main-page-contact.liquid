  /* reviews (match location page treatment) */
  .grev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:8px}
  .grev{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px 20px}
