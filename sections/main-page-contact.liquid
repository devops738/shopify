{{ 'ats-contact.css' | asset_url | stylesheet_tag }}
<div class="ats-netlify-port ats-contact">
<div class="crumbs"><div class="wrap"><a href="/">Home</a> <span>&rsaquo;</span> <b>Contact Us</b></div></div>
<section class="ct-hero"><div class="wrap">
  <div>
    <div class="sec-eye">We're here to help</div>
    <h1>Talk to Someone at Your Local Store</h1>
    <p class="lead">Nine stores across Southern California, each with its own phone line and service
      counter. For anything about a specific vehicle, quote or appointment, your store is the fastest
      route &mdash; they can see what's in stock and what the bay looks like today.</p>
    <div class="ct-quick">
      <a class="ct-q" href="#ct-stores" >
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1z"/></svg></span><span><small>Fastest</small><b>Call your store</b></span></a>
      <a class="ct-q" href="/pages/services">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span><span><small>Online</small><b>Book an appointment</b></span></a>
      <a class="ct-q" href="#ct-form" >
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span><span><small>Non-urgent</small><b>Send a message</b></span></a>
    </div>
  </div>
  <div class="ct-hero__img">
    <img src="{{ 'netlify-contact-04-e5b64083e3413436.jpg' | asset_url }}" alt="Inside an American Tire Stores showroom, with tire and wheel displays lining both walls"
         width="1000" height="750" fetchpriority="high" decoding="async">
  </div>
</div></section>

<section class="block" id="ct-routes"><div class="wrap">
