  .grev p{font-size:13px;line-height:1.55;color:var(--slate);margin:0}
  .rev-flag{font-size:11.5px;color:#9a6a1a;background:#fff7e6;border:1px dashed #d9a441;border-radius:6px;padding:8px 14px;margin:16px auto 0;max-width:640px;text-align:center}
  .final-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
