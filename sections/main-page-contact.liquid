  .qbrands-flag{font-size:11.5px;color:#9a6a1a;background:#fff7e6;border:1px dashed #d9a441;border-radius:6px;padding:6px 12px;margin:14px auto 0;max-width:560px;text-align:center}
  /* pricing reassurance */
  .price2{display:grid;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:center}
