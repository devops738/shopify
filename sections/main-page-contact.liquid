img class="lc-photo" src="{{ 'netlify-financing-19-582faf17016f2ac3.jpg' | asset_url }}" alt="American Tire Stores Hollywood storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Hollywood</div><div class="lc-addr">1174 N. Western Ave., Los Angeles, CA 90029</div><div class="lc-ph"><a class="store-call" href="tel:+13233729372">(323) 372-9372</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-hollywood-ca">Store details &rarr;</a></div><div class="loc-card"><a class="lc-shot" href="/pages/location-glendale-ca"><img class="lc-photo" src="{{ 'netlify-financing-20-196b5cddf165f34f.jpg' | asset_url }}" alt="American Tire Stores Glendale storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Glendale</div><div class="lc-addr">737 S Glendale Ave, Glendale, CA 91205</div><div class="lc-ph"><a class="store-call" href="tel:+18182433191">(818) 243-3191</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-glendale-ca">Store details &rarr;</a></div><div class="loc-card"><a class="lc-shot" href="/pages/location-glendale-ii-ca"><img class="lc-photo" src="{{ 'netlify-financing-21-3dd9a67fa7ded918.jpg' | asset_url }}" alt="American Tire Stores Glendale 2 storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Glendale 2</div><div class="lc-addr">1130 S Central Ave, Glendale, CA 91204</div><div class="lc-ph"><a class="store-call" href="tel:+18185472010">(818) 547-2010</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-glendale-ii-ca">Store details &rarr;</a></div><div class="loc-card"><a class="lc-shot" href="/pages/location-bellflower-ca"><img class="lc-photo" src="{{ 'netlify-financing-22-60c7e57b01287bb2.jpg' | asset_url }}" alt="American Tire Stores Bellflower storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Bellflower</div><div class="lc-addr">9509 Alondra Blvd, Bellflower, CA 90706</div><div class="lc-ph"><a class="store-call" href="tel:+15628044737">(562) 804-4737</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-bellflower-ca">Store details &rarr;</a></div><div class="loc-card"><a class="lc-shot" href="/pages/location-costa-mesa-ca"><img class="lc-photo" src="{{ 'netlify-financing-23-eafa51160dc4abe4.jpg' | asset_url }}" alt="American Tire Stores Costa Mesa storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Costa Mesa</div><div class="lc-addr">2049 Harbor Blvd, Costa Mesa, CA 92627</div><div class="lc-ph"><a class="store-call" href="tel:+19498026419">(949) 802-6419</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-costa-mesa-ca">Store details &rarr;</a></div><div class="loc-card"><a class="lc-shot" href="/pages/location-cathedral-city-ca"><img class="lc-photo" src="{{ 'netlify-financing-24-cb2ff932283299c3.jpg' | asset_url }}" alt="American Tire Stores Cathedral City storefront" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Cathedral City</div><div class="lc-addr">68406 E Palm Canyon Dr, Cathedral City, CA 92234</div><div class="lc-ph"><a class="store-call" href="tel:+17604699510">(760) 469-9510</a></div><div class="lc-hrs">Mon–Fri 8am–6pm · Sat 8am–5pm</div><a class="lc-link" href="/pages/location-cathedral-city-ca">Store details &rarr;</a></div><div class="loc-card loc-card--soon"><span class="lc-shot"><img class="lc-photo" src="{{ 'netlify-financing-25-7c8480f624f21c6a.jpg' | asset_url }}" alt="American Tire Stores Signal Hill - opening soon" width="760" height="428" style="height:auto" loading="lazy" decoding="async"></a><div class="lc-city">Signal Hill</div><div class="lc-addr">Signal Hill, CA</div><div class="lc-soon">Coming soon</div></div></div>
