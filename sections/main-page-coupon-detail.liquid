<style>
.ats-detail{--brand:#13315f;--red:#c51f28;--ink:#122240;--slate:#66738b;--line:#dde2ea;--bg:#f4f6fa;font-family:'Montserrat',system-ui,sans-serif;color:var(--ink);background:#fff}.ats-detail *{box-sizing:border-box}.ats-detail .wrap{max-width:1100px;margin:0 auto;padding:0 24px}.ats-detail .promo{background:var(--red);color:#fff;font-size:13px;font-weight:800}.ats-detail .promo .wrap{height:38px;display:flex;align-items:center;justify-content:center;gap:14px;max-width:none}.ats-detail .promo a{color:#fff;text-decoration:underline;font-weight:900}.ats-detail .hbar-brand{border-bottom:1px solid var(--line)}.ats-detail .hbar-brand .wrap{height:76px;display:flex;align-items:center;gap:20px;max-width:1200px}.ats-detail .logo img{height:40px;width:auto}.ats-detail .brand-right{margin-left:auto;display:flex;align-items:center;gap:12px}.ats-detail .hgarage{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}.ats-detail .hg-field{border:0;background:#fff;display:flex;padding:8px 14px;text-align:left}.ats-detail .hg-sep{width:1px;background:var(--line);margin:8px 0}.ats-detail .hg-txt{display:flex;flex-direction:column}.ats-detail .hg-txt small{font-size:9px;font-weight:900;text-transform:uppercase;color:var(--brand)}.ats-detail .hg-txt b,.ats-detail .hg-txt select{font-size:12px;color:#8b95a8;font-weight:800;border:0;background:transparent}.ats-detail .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;font-weight:900;text-transform:uppercase;text-decoration:none;border:0;cursor:pointer}.ats-detail .btn-red{background:var(--red);color:#fff;box-shadow:0 4px 0 #86121a;height:50px;padding:0 22px}.ats-detail .appt-btn{min-height:50px;padding:8px 18px;font-size:12px;line-height:1.05;text-align:center}.ats-detail .hbar-nav{border-bottom:1px solid var(--line)}.ats-detail .mainnav{height:50px;display:flex;justify-content:center;align-items:center;gap:26px;overflow:auto}.ats-detail .mainnav a{font-size:14px;font-weight:800;color:#081a33;text-decoration:none;white-space:nowrap}.ats-detail .hero{background:#f4f6fa;padding:58px 0}.ats-detail .hero-grid{display:grid;grid-template-columns:1fr .85fr;gap:42px;align-items:center}.ats-detail .eyebrow{display:block;color:var(--red);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.16em;margin-bottom:12px}.ats-detail h1,.ats-detail h2{font-family:'Akira Expanded','Archivo',sans-serif;text-transform:uppercase;line-height:1.08;margin:0}.ats-detail h1{font-size:clamp(30px,4vw,52px);color:var(--brand)}.ats-detail .lead{color:var(--slate);line-height:1.65;margin:18px 0 10px}.ats-detail .coupon-code{display:inline-flex;border:2px dashed var(--red);color:var(--red);border-radius:10px;padding:12px 16px;font-size:18px;font-weight:900;letter-spacing:.08em;background:#fff;margin:12px 0 18px}.ats-detail .hero-img{border-radius:16px;overflow:hidden;background:#0a1830;min-height:310px}.ats-detail .hero-img img{width:100%;height:100%;object-fit:cover;display:block}.ats-detail .panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;margin:-32px auto 54px;position:relative;z-index:2;box-shadow:0 24px 60px -42px rgba(0,0,0,.45)}.ats-detail .summary{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}.ats-detail .sum{background:var(--bg);border-radius:10px;padding:14px}.ats-detail .sum small{display:block;color:var(--slate);font-size:10px;font-weight:900;text-transform:uppercase}.ats-detail .sum b{display:block;color:var(--brand);font-size:15px;margin-top:4px}.ats-detail .content{display:grid;grid-template-columns:1fr .38fr;gap:30px}.ats-detail .copy{color:var(--slate);line-height:1.7}.ats-detail .terms{background:var(--bg);border-radius:12px;padding:20px}.ats-detail .terms h2{font-size:18px;color:var(--brand);margin-bottom:10px}.ats-detail .terms p{font-size:13px;color:var(--slate);line-height:1.6}.ats-detail .cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}.ats-detail .btn-outline{border:2px solid var(--brand);color:var(--brand);height:50px;padding:0 22px;background:#fff}@media(max-width:900px){.ats-detail .hero-grid,.ats-detail .content{grid-template-columns:1fr}.ats-detail .summary{grid-template-columns:1fr}.ats-detail .hgarage{display:none}}@media(max-width:680px){.ats-detail .logo img{height:32px}.ats-detail .appt-btn{display:none}}@media print{.ats-detail header,.ats-detail .promo,.ats-detail .cta-row{display:none!important}.ats-detail .hero{background:#fff!important}.ats-detail .panel{box-shadow:none;margin:20px auto;border:2px dashed var(--red)}}
</style>
{% assign detail_title = metaobject.title.value | default: section.settings.title %}
{% assign detail_label = metaobject.label.value | default: section.settings.label %}
{% assign detail_description = metaobject.description.value | default: section.settings.description %}
{% assign detail_image = metaobject.image.value | default: section.settings.image %}
{% assign detail_code = metaobject.code.value | default: section.settings.code %}
{% assign detail_offer = metaobject.offer_value.value | default: metaobject.code.value | default: section.settings.offer_value %}
{% assign detail_expiry = metaobject.expiry.value | default: section.settings.expiry %}
{% assign detail_locations = metaobject.locations.value | default: section.settings.locations %}
{% assign detail_body = metaobject.body.value | default: section.settings.body %}
{% assign detail_terms = metaobject.terms.value | default: section.settings.terms %}
{% assign detail_primary_link = metaobject.primary_link.value | default: metaobject.link.value | default: section.settings.primary_link %}
{% assign detail_primary_cta = metaobject.primary_cta.value | default: metaobject.cta.value | default: section.settings.primary_cta %}
<div class="ats-detail">
  {% render 'ats-offer-header' %}
  <section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow">{{ detail_label }}</span><h1>{{ detail_title }}</h1><p class="lead">{{ detail_description }}</p>{% if detail_code != blank %}<div class="coupon-code">{{ detail_code }}</div>{% endif %}<div class="cta-row"><a class="btn btn-red" href="{{ detail_primary_link }}">{{ detail_primary_cta }}</a><button class="btn btn-outline" onclick="window.print()" type="button">Print coupon</button><a class="btn btn-outline" href="/pages/coupons">Back to coupons</a></div></div><div class="hero-img">{% if detail_image != blank %}<img src="{{ detail_image | image_url: width: 1100 }}" alt="{{ detail_title | escape }}">{% endif %}</div></div></section>
  <section class="wrap"><div class="panel"><div class="summary"><div class="sum"><small>Coupon</small><b>{{ detail_offer }}</b></div><div class="sum"><small>Valid through</small><b>{{ detail_expiry }}</b></div><div class="sum"><small>Locations</small><b>{{ detail_locations }}</b></div></div><div class="content"><div class="copy">{{ detail_body }}</div><aside class="terms"><h2>Terms</h2><p>{{ detail_terms }}</p></aside></div></div></section>
</div>
{% schema %}
{"name":"Coupon detail - editable","settings":[{"type":"text","id":"label","label":"Label","default":"Coupon"},{"type":"text","id":"title","label":"Title","default":"$50 Off Brake Service Coupon"},{"type":"textarea","id":"description","label":"Description","default":"Show this coupon on your phone or print it before visiting American Tire Stores."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"code","label":"Coupon code","default":"BRAKE50"},{"type":"text","id":"offer_value","label":"Offer value","default":"$50 off"},{"type":"text","id":"expiry","label":"Expiry","default":"December 31, 2026"},{"type":"text","id":"locations","label":"Locations","default":"All locations"},{"type":"richtext","id":"body","label":"Body copy","default":"<p>Use this coupon toward eligible service at American Tire Stores. Present the coupon at checkout or show it on your phone.</p>"},{"type":"textarea","id":"terms","label":"Terms","default":"Cannot be combined with other offers. Valid only on eligible services. See store for complete details."},{"type":"url","id":"primary_link","label":"Primary CTA link"},{"type":"text","id":"primary_cta","label":"Primary CTA","default":"Book a service"}],"presets":[{"name":"Coupon detail - editable"}]}
{% endschema %}
