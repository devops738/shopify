function normalizeVehicleValues(v){return v.map(x=>typeof x==='string'||typeof x==='number'?String(x):String(x.name||x.value||x.label||x.year||x.make||x.model||x.trim||'')).filter(Boolean)}
function vehicleApi(endpoint,params={}){const url=new URL(`https://wl.tireconnect.ca/api/v2/vehicle/${endpoint}`);url.searchParams.set('key',TC_API_KEY);Object.entries(params).forEach(([k,v])=>{if(v)url.searchParams.set(k,v)});return fetch(url).then(r=>r.ok?r.json():Promise.reject()).then(valuesFromPayload).then(normalizeVehicleValues)}
function setLoading(sel,label){if(sel){sel.disabled=true;sel.innerHTML=`<option value="" disabled selected hidden>${label}</option>`}}
async function initVehicleDropdowns(){setLoading($('hyear'),'Select');try{const years=await vehicleApi('years');if(years.length){VEH={};years.forEach(y=>VEH[y]={});fillOpts($('hyear'),years,'Select');return}}catch(e){}VEH=JSON.parse(JSON.stringify(FALLBACK_VEH));fillOpts($('hyear'),Object.keys(VEH),'Select')}
async function loadMakesForYear(year){if(!year)return [];if(VEH[year]&&Object.keys(VEH[year]).length)return Object.keys(VEH[year]);setLoading($('hmake'),'Select');try{const makes=await vehicleApi('makes',{year});VEH[year]=VEH[year]||{};makes.forEach(m=>VEH[year][m]=VEH[year][m]||[]);return makes}catch(e){VEH[year]=VEH[year]||{};return Object.keys(VEH[year])}}
async function loadModelsForMake(year,make){if(!year||!make)return [];if(VEH[year]&&Array.isArray(VEH[year][make])&&VEH[year][make].length)return VEH[year][make];setLoading($('hmodel'),'Select');try{const models=await vehicleApi('models',{year,make});VEH[year]=VEH[year]||{};VEH[year][make]=models;return models}catch(e){VEH[year]=VEH[year]||{};VEH[year][make]=VEH[year][make]||[];return VEH[year][make]}}
function storageJson(keys){try{for(const k of keys){const raw=localStorage.getItem(k)||sessionStorage.getItem(k);if(raw){try{return JSON.parse(raw)}catch(e){return raw}}}}catch(e){}return null}
function persistTireConnectState(){try{if(st.store){const p={name:st.store.name,city:st.store.city,address:st.store.addr,addr:st.store.addr,zip:st.store.zip,phone:st.store.ph,id:st.store.id,location_id:st.store.id,locationId:st.store.id,slug:st.store.slug,url:st.store.url};localStorage.setItem('atsTireConnectStore',JSON.stringify(p));sessionStorage.setItem('atsTireConnectStore',JSON.stringify(p));['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(st.store.id));sessionStorage.setItem(k,String(st.store.id))})}if(st.year&&st.make&&st.model){const v={year:st.year,make:st.make,model:st.model};['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'].forEach(k=>{localStorage.setItem(k,JSON.stringify(v));sessionStorage.setItem(k,JSON.stringify(v))})}}catch(e){}}
function restoreTireConnectState(){try{const q=new URLSearchParams(location.search);const savedStore=storageJson(['atsTireConnectStore']);const loc=q.get('location_id')||q.get('locationId')||localStorage.getItem('atsTireConnectLocationId')||sessionStorage.getItem('atsTireConnectLocationId')||(savedStore&&(savedStore.location_id||savedStore.locationId||savedStore.id))||'';if(loc){const m=STORES.find(s=>String(s.id)===String(loc));if(m)st.store=m}const sv=storageJson(['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'])||{};st.year=q.get('year')||sv.year||sv.vehicleYear||sv.vehicle_year||'';st.make=q.get('make')||sv.make||sv.vehicleMake||sv.vehicle_make||'';st.model=q.get('model')||sv.model||sv.vehicleModel||sv.vehicle_model||''}catch(e){}}
function syncSel(){const y=$('hyear'),mk=$('hmake'),md=$('hmodel');if(!y)return;y.value=st.year||'';const makes=st.year&&VEH[st.year]?Object.keys(VEH[st.year]):[];fillOpts(mk,makes,'Select');if(mk)mk.value=st.make||'';const models=st.year&&st.make&&VEH[st.year]&&VEH[st.year][st.make]?VEH[st.year][st.make]:[];fillOpts(md,models,'Select');if(md)md.value=st.model||''}
function reflectState(){persistTireConnectState();if($('hstore'))$('hstore').value='';if($('storePicker'))$('storePicker').value='';if($('storeField'))$('storeField').classList.remove('set');if($('vehField'))$('vehField').classList.toggle('set',!!(st.make&&st.model));if($('vehVal'))$('vehVal').textContent=st.make&&st.model?((st.year?st.year+' ':'')+st.make+' '+st.model):'Not selected…';syncSel()}
async function hOnYear(){st.year=$('hyear').value;st.make='';st.model='';reflectState();await loadMakesForYear(st.year);reflectState();if($('hmake'))$('hmake').focus()}
async function hOnMake(){st.make=$('hmake').value;st.model='';reflectState();await loadModelsForMake(st.year,st.make);reflectState();if($('hmodel'))$('hmodel').focus()}
function hOnModel(){st.model=$('hmodel').value;reflectState();if(st.model)toggleVeh(false)}
function onHStore(){const id=$('hstore').value;const s=STORES.find(x=>String(x.id)===String(id));if(s)goStoreRecord(s)}
function goStore(){const s=STORES.find(x=>x.url===($('storePicker')&&$('storePicker').value));if(s)goStoreRecord(s)}
function goStoreById(id,event){const s=STORES.find(x=>String(x.id)===String(id));if(!s)return;if(event)event.preventDefault();goStoreRecord(s)}
function goStoreRecord(s){st.store=s;persistTireConnectState();location.href=s.url}
function toggleVeh(open){const p=$('vehPop');if(p)p.classList.toggle('show',open===undefined?!p.classList.contains('show'):open)}
function toggleMenu(o){const m=$('mobileMenu');if(m)m.classList.toggle('show',o===undefined?!m.classList.contains('show'):o)}
function toggleFaq(i){const q=$('qa'+i);if(q)q.classList.toggle('open')}
const FAQ=[["Where is the nearest American Tire Stores location?","American Tire Stores has 7 locations across Southern California: Ventura, Thousand Oaks, Los Angeles, two Glendale stores, Bellflower, and Cathedral City."],["What are American Tire Stores' hours?","All locations are open Monday through Friday from 8am to 6pm and Saturday from 8am to 5pm. Stores are closed on Sundays."],["Do I need an appointment?","Walk-ins are welcome, but booking online helps guarantee your spot and shortest wait."],["Do all locations offer the same services?","Every location supports tire sales, wheels, packages, oil changes, alignment, brakes, tire installation, TPMS, and battery service."],["Can I buy tires online and pick them up at a store?","Yes. Select your vehicle and local store to see local tire availability and pricing."],["Does American Tire Stores offer financing?","Yes. Financing is available at every location."],["Can I install tires bought elsewhere?","Yes. Book tire installation and bring your tires to your selected store."]];
function storeCard(s){return `<a class="loc-widget-card" href="${s.url}" onclick="goStoreById(${s.id},event)"><div class="loc-widget-card__img"><img src="${s.img}" alt="${s.name} storefront" loading="lazy"></div><div class="loc-widget-card__body"><h3>${s.city}</h3><p class="addr">${s.addr}, CA ${s.zip}</p><div class="phone">${s.ph}</div><div class="hours">Mon–Fri 8am–6pm · Sat 8am–5pm</div><span class="view">View Store →</span></div></a>`}
function countyGroup(title,desc,items){return `<div class="county-group"><div class="county-title"><h3>${title}</h3><span class="county-pill">${items.length} ${items.length===1?'store':'stores'}</span></div><p class="county-desc">${desc}</p><div class="county-grid">${items.map(storeCard).join('')}</div></div>`}
function renderLocations(){const grid=$('locGrid');if(grid)grid.innerHTML=`<p class="loc-widget-note">All offers are valid at every American Tire Stores location across Southern California.</p><div class="loc-widget-banner"><img src="{{ 'ats-locations-inline-12.jpg' | asset_url }}" alt="American Tire Stores storefront" loading="lazy"></div><div class="loc-widget-grid">${STORES.map(storeCard).join('')}</div>`;const faq=$('faq');if(faq)faq.innerHTML=FAQ.map((q,i)=>`<div class="qa" id="qa${i}"><button onclick="toggleFaq(${i})"><span>${q[0]}</span><span class="ic">+</span></button><div class="a"><p>${q[1]}</p></div></div>`).join('')}
document.addEventListener('click',e=>{const p=$('vehPop');if(p&&p.classList.contains('show')&&!e.target.closest('#vehPop')&&!e.target.closest('#vehField'))toggleVeh(false)});
document.addEventListener('keydown',e=>{if(e.key==='Escape')toggleVeh(false)});
fillStores();renderLocations();restoreTireConnectState();initVehicleDropdowns().then(async()=>{if(st.year)await loadMakesForYear(st.year);if(st.year&&st.make)await loadModelsForMake(st.year,st.make);reflectState()});
</script>
