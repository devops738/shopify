<style>/* ===== locations page: step art, guarantees, offer backgrounds.
   Appended at end of document on purpose - this page keeps its styles in the BODY. ===== */

/* --- 3 steps: image-led cards (the arrows are gone; the art carries the sequence) --- */
.steps-row--art{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;
  align-items:stretch;justify-content:initial;max-width:1080px;margin:0 auto}
.steps-row--art .step{flex:initial;max-width:none;padding:0;text-align:left;
  background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;
  display:flex;flex-direction:column;
  transition:transform .15s,box-shadow .15s,border-color .15s}
.steps-row--art .step:hover{border-color:var(--brand);transform:translateY(-2px);
  box-shadow:0 16px 34px -24px rgba(12,30,58,.5)}
.steps-row--art .step-img{position:relative;display:block;aspect-ratio:16/9;
  overflow:hidden;background:#0d2144}
.steps-row--art .step-img img{width:100%;height:100%;object-fit:cover;display:block}
.steps-row--art .step-num{position:absolute;left:14px;bottom:14px;margin:0;
  width:40px;height:40px;box-shadow:0 6px 18px -6px rgba(0,0,0,.6)}
.steps-row--art .step h3{margin:16px 18px 6px}
.steps-row--art .step p{margin:0 18px 20px}
@media(max-width:860px){.steps-row--art{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.steps-row--art{grid-template-columns:1fr;gap:16px}}

/* --- guarantees: same component as the homepage --- */
.guarantees{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:28px}
.guar{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
  border-radius:10px;padding:20px;text-align:center}
.guar .gi{font-size:26px;margin-bottom:8px}
.guar .gi img{width:64px;height:64px;object-fit:contain;display:block;margin:0 auto}
.guar h4{font-family:'Montserrat',sans-serif;font-weight:800;font-size:14.5px;
  text-transform:uppercase;color:#fff}
.guar p{font-size:12px;color:#b7c4dc;margin-top:5px;line-height:1.5}
@media(max-width:980px){.guarantees{grid-template-columns:1fr 1fr;gap:24px}}
@media(max-width:520px){.guarantees{grid-template-columns:1fr}}

/* --- offer cards on photography: scrim first, then the existing text turns white --- */
.offer-card--photo{background-size:cover;background-position:center;background-repeat:no-repeat;
  border-color:rgba(255,255,255,.16);isolation:isolate}
.offer-card--photo::before{content:"";position:absolute;inset:0;z-index:0;
  background:linear-gradient(200deg,rgba(9,22,48,.38) 0%,rgba(9,22,48,.74) 42%,rgba(9,22,48,.92) 100%)}
.offer-card--photo.feat::before{
  background:linear-gradient(200deg,rgba(160,20,28,.46) 0%,rgba(140,16,22,.82) 42%,rgba(110,10,16,.95) 100%)}
.offer-card--photo>*{position:relative;z-index:1}
.offer-card--photo h3{color:#fff}
.offer-card--photo p{color:#d7e0f0}
.offer-card--photo .offer-tag{color:#ff8b7a}
.offer-card--photo.feat p{color:#ffe1e2}
.offer-card--photo.feat .offer-tag{color:#ffd7d9}
.offer-card--photo:hover{border-color:rgba(255,255,255,.28)}</style>
</div>

