{% assign promotions = shop.metaobjects.ats_promotion.values %}
<style>
.ats-promotions{--navy:#102e5c;--deep:#0c2245;--red:#d21f2b;--ink:#102b56;--muted:#687897;--line:#dbe2ec;background:#fff;color:var(--ink);font-family:Montserrat,Arial,sans-serif}.ats-promotions *{box-sizing:border-box}.ats-wrap{max-width:1060px;margin:auto;padding:0 22px}.ats-promotions a{text-decoration:none}.ats-hero{background:linear-gradient(135deg,#102e5c,#0b2247);color:#fff;padding:12px 0 42px}.ats-hero .ats-wrap{display:grid;grid-template-columns:1.06fr .84fr;gap:56px;align-items:center}.ats-eye{color:#ff716d;font-size:11px;letter-spacing:.14em;font-weight:900;text-transform:uppercase;margin:0 0 13px}.ats-hero h1,.ats-promotions h2,.ats-promotions h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:-.02em}.ats-hero h1{font-size:clamp(34px,4vw,56px);line-height:1.04;color:#fff;margin:0 0 18px}.ats-hero p{max-width:520px;color:#d5ddef;font-size:16px;line-height:1.58;margin:0}.ats-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:24px}.ats-btn{display:inline-flex;min-height:42px;align-items:center;justify-content:center;padding:11px 18px;border-radius:7px;font-size:12px;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.ats-red{background:var(--red);color:#fff;box-shadow:0 4px 0 #a4141d}.ats-clear{border:1px solid #b8c6de;color:#fff}.ats-hero-photo{min-height:296px;border:1px solid #617494;border-radius:12px;overflow:hidden;background:#193a6b url('https://americantirestores.com/cdn/shop/files/ats-promotions-hero.jpg') center/cover no-repeat}.ats-hero-photo img{display:block;width:100%;height:296px;object-fit:cover}.ats-content{padding:52px 0 72px}.ats-feature{display:block;overflow:hidden;border:1px solid var(--line);border-radius:13px;color:var(--ink);background:#fff;margin-bottom:44px}.ats-feature-image{display:block;width:100%;aspect-ratio:3.25/1;object-fit:cover;background:#173866}.ats-feature-copy{display:flex;gap:24px;justify-content:space-between;align-items:center;padding:20px 22px}.ats-feature h2{font-size:21px;line-height:1.2;margin:0 0 7px}.ats-feature p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.ats-feature .ats-btn{white-space:nowrap;flex:none}.ats-intro{text-align:center;max-width:720px;margin:0 auto 27px}.ats-intro h2{font-size:27px;line-height:1.15;margin:0 0 9px}.ats-intro p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}.ats-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.ats-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);transition:.16s}.ats-card:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(12,34,69,.12)}.ats-card-image{display:block;width:100%;aspect-ratio:10/3;object-fit:cover;background:#173866}.ats-card-placeholder{display:grid;place-items:center;background:linear-gradient(135deg,#112d58,#224980);color:#d9e2f3;font-family:'Akira Expanded',Montserrat,sans-serif;font-size:11px;text-align:center;text-transform:uppercase}.ats-card-copy{display:flex;flex:1;flex-direction:column;padding:17px 16px 15px}.ats-card-copy h3{font-size:14px;line-height:1.3;margin:0 0 8px}.ats-card-copy p{margin:0 0 13px;color:var(--muted);font-size:12.5px;line-height:1.48}.ats-card-cta{margin-top:auto;color:var(--red);font-size:12px;font-weight:900;letter-spacing:.03em;text-transform:uppercase}.ats-empty{grid-column:1/-1;padding:28px;border:1px dashed #aab8ce;border-radius:12px;text-align:center;color:var(--muted)}@media(max-width:760px){.ats-hero{padding:36px 0}.ats-hero .ats-wrap{grid-template-columns:1fr;gap:28px}.ats-hero-photo,.ats-hero-photo img{min-height:210px;height:210px}.ats-feature-copy{display:block}.ats-feature-copy .ats-btn{margin-top:18px}.ats-grid{grid-template-columns:1fr}.ats-content{padding:38px 0 52px}}
</style>
<main class="ats-promotions">
  {% render 'ats-offer-header' %}
  <section class="ats-hero"><div class="ats-wrap"><div><p class="ats-eye">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p><div class="ats-actions"><a class="ats-btn ats-red" href="#ats-tire-deals">{{ section.settings.primary_label }} ↓</a><a class="ats-btn ats-clear" href="#ats-wheel-deals">{{ section.settings.secondary_label }}</a></div></div><div class="ats-hero-photo">{% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1000 }}" width="1000" height="750" alt="{{ section.settings.heading | escape }}">{% endif %}</div></div></section>
  <section class="ats-content" id="ats-tire-deals"><div class="ats-wrap">
  {% if promotions.size > 0 %}{% assign featured = promotions.first %}{% assign ft = featured.title.value | default: featured.title %}{% assign fd = featured.description.value | default: featured.description %}{% assign fi = featured.image.value %}{% assign fl = featured.system.url | default: featured.primary_link.value | default: featured.link.value %}
  <a class="ats-feature" href="{{ fl | default: '#ats-tire-deals' }}">{% if fi != blank %}<img class="ats-feature-image" src="{{ fi | image_url: width: 1800 }}" width="1800" height="554" alt="{{ ft | escape }}" loading="eager">{% else %}<div class="ats-feature-image ats-card-placeholder">Add promotion image in Shopify Metaobjects</div>{% endif %}<div class="ats-feature-copy"><div><h2>{{ ft }}</h2><p>{{ fd }}</p></div><span class="ats-btn ats-red">{{ featured.primary_cta.value | default: featured.cta.value | default: 'Shop tires' }} →</span></div></a>{% endif %}
  <div class="ats-intro" id="ats-wheel-deals"><p class="ats-eye">Tire deals &amp; rebates</p><h2>More ways to save</h2><p>Manufacturer rebates and instant savings on select tire brands, wheels, and auto services. Select an offer for complete details.</p></div>
  <div class="ats-grid">{% if promotions.size > 1 %}{% for promo in promotions offset: 1 %}{% assign pt = promo.title.value | default: promo.title %}{% assign pd = promo.description.value | default: promo.description %}{% assign pi = promo.image.value %}{% assign pl = promo.system.url | default: promo.primary_link.value | default: promo.link.value %}<a class="ats-card" href="{{ pl | default: '#ats-tire-deals' }}">{% if pi != blank %}<img class="ats-card-image" src="{{ pi | image_url: width: 1000 }}" width="1000" height="300" alt="{{ pt | escape }}" loading="lazy">{% else %}<div class="ats-card-image ats-card-placeholder">American Tire Stores<br>Promotion</div>{% endif %}<div class="ats-card-copy"><h3>{{ pt }}</h3><p>{{ pd }}</p><span class="ats-card-cta">{{ promo.primary_cta.value | default: promo.cta.value | default: 'View offer' }} →</span></div></a>{% endfor %}{% elsif promotions.size == 0 %}{% for block in section.blocks %}<a class="ats-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<img class="ats-card-image" src="{{ block.settings.image | image_url: width: 1000 }}" width="1000" height="300" alt="{{ block.settings.title | escape }}" loading="lazy">{% else %}<div class="ats-card-image ats-card-placeholder">American Tire Stores<br>Promotion</div>{% endif %}<div class="ats-card-copy"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p><span class="ats-card-cta">{{ block.settings.cta }} →</span></div></a>{% endfor %}{% else %}<div class="ats-empty">Add more ATS Promotion Metaobjects to show additional cards here.</div>{% endif %}</div>
  </div></section>
</main>
{% schema %}
{"name":"Promotions - CMS","settings":[{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"Current deals & rebates"},{"type":"text","id":"heading","label":"Hero heading","default":"Deals on Tires, Wheels, & Auto Service"},{"type":"textarea","id":"intro","label":"Hero copy","default":"Save on tires, wheels, and auto service at American Tire Stores. Browse manufacturer rebates, brand-specific wheel discounts, service coupons, and flexible financing — available at all seven Southern California locations."},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"primary_label","label":"Primary CTA label","default":"See tire deals"},{"type":"text","id":"secondary_label","label":"Secondary CTA label","default":"Wheel deals"}],"blocks":[{"type":"promotion","name":"Fallback promotion card","settings":[{"type":"text","id":"title","label":"Title","default":"Promotion title"},{"type":"textarea","id":"description","label":"Description","default":"Promotion description."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Detail link"},{"type":"text","id":"cta","label":"CTA","default":"View offer"}]}],"presets":[{"name":"Promotions - CMS"}]}
{% endschema %}
