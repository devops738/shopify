{% liquid
  assign promotions = shop.metaobjects.ats_promotion.values
  assign tire_feature = blank
  for promotion in promotions
    assign promotion_label = promotion.label.value | downcase
    unless promotion_label contains 'wheel'
      assign tire_feature = promotion
      break
    endunless
  endfor
%}

<style>
  .ats-p{--n:#102e5c;--d:#0c2245;--r:#d21f2b;--i:#102b56;--m:#687897;--l:#dbe2ec;background:#fff;color:var(--i);font-family:Montserrat,Arial,sans-serif}.ats-p *{box-sizing:border-box}.ats-p a{text-decoration:none}.ats-p .aw{max-width:1060px;margin:auto;padding:0 22px}.ats-p .hero{background:linear-gradient(135deg,var(--n),var(--d));color:#fff;padding:36px 0}.ats-p .hero .aw{display:grid;grid-template-columns:1.1fr .9fr;gap:55px;align-items:center}.ats-p .eye{color:#ff716d;text-transform:uppercase;font-size:11px;letter-spacing:.14em;font-weight:900}.ats-p h1,.ats-p h2,.ats-p h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;text-transform:uppercase;font-weight:800}.ats-p .hero h1{font-size:clamp(34px,4vw,56px);line-height:1.04;margin:12px 0}.ats-p .hero p{line-height:1.6;color:#d5ddef}.ats-p .heroimg{min-height:295px;border-radius:12px;background:#193a6b url('https://americantirestores.com/cdn/shop/files/ats-promotions-hero.jpg') center/cover}.ats-p .heroimg img{width:100%;height:295px;display:block;object-fit:cover;border-radius:12px}.ats-p .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;min-height:42px;border-radius:7px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.03em}.ats-p .red{background:var(--r);color:#fff;box-shadow:0 4px 0 #a4141d}.ats-p .clear{border:1px solid #b8c6de;color:#fff;margin-left:8px}.ats-p .sec{padding:52px 0}.ats-p .alt{background:#f4f6fa}.ats-p .intro{text-align:center;max-width:720px;margin:0 auto 27px}.ats-p .intro h2{font-size:27px;margin:8px 0}.ats-p .intro p{color:var(--m);line-height:1.6}.ats-p .grid,.ats-p .benefits{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.ats-p .card,.ats-p .benefit{border:1px solid var(--l);border-radius:12px;overflow:hidden;color:var(--i);background:#fff}.ats-p .card:hover{transform:translateY(-3px);box-shadow:0 14px 28px #0c22451f}.ats-p .card img{width:100%;height:auto;display:block;object-fit:contain;background:#173866}.ats-p .copy,.ats-p .benefit{padding:17px 16px}.ats-p .copy h3,.ats-p .benefit h3{font-size:14px;line-height:1.3;margin:0 0 8px}.ats-p .copy p,.ats-p .benefit p{color:var(--m);font-size:12.5px;line-height:1.5;margin:0 0 13px}.ats-p .cta{color:var(--r);font-size:12px;font-weight:900;text-transform:uppercase}.ats-p .feature{border:1px solid var(--l);border-radius:13px;overflow:hidden;color:var(--i);background:#fff;display:block;margin-bottom:42px}.ats-p .feature img{width:100%;height:auto;display:block}.ats-p .fc{display:flex;justify-content:space-between;gap:20px;padding:20px}.ats-p .fc h2{font-size:21px;margin:0 0 8px}.ats-p .fc p{color:var(--m);font-size:13px;margin:0}.ats-p .ico{font-size:25px}.ats-p .faq{max-width:820px;margin:auto}.ats-p .faq details{border-bottom:1px solid var(--l);padding:17px 0}.ats-p .faq summary{font-weight:800;cursor:pointer;list-style:none}.ats-p .faq summary:after{content:'+';float:right;color:var(--r);font-size:20px}.ats-p .faq details[open] summary:after{content:'−'}.ats-p .faq p{color:var(--m);line-height:1.6}.ats-p .empty{padding:28px;border:1px dashed var(--l);border-radius:12px;text-align:center;color:var(--m);background:#fff}.ats-p .final{background:var(--d);color:#fff;text-align:center;padding:56px 20px}.ats-p .final h2{font-size:30px;margin:0 0 12px}.ats-p .final p{color:#d5ddef;max-width:620px;margin:0 auto 24px}@media(max-width:760px){.ats-p .hero .aw,.ats-p .grid,.ats-p .benefits{grid-template-columns:1fr}.ats-p .heroimg,.ats-p .heroimg img{min-height:210px;height:210px}.ats-p .fc{display:block}.ats-p .sec{padding:38px 0}}
</style>

<main class="ats-p">
  {% render 'ats-offer-header' %}
  <section class="hero"><div class="aw"><div><div class="eye">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p><p><a class="btn red" href="#tires">{{ section.settings.primary_label }} ↓</a><a class="btn clear" href="#wheels">{{ section.settings.secondary_label }}</a></p></div><div class="heroimg">{% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}">{% endif %}</div></div></section>

  <section class="sec" id="tires"><div class="aw">
    {% if tire_feature != blank %}{% assign feature_image = tire_feature.image.value | default: section.settings.featured_image %}{% if feature_image != blank %}<a class="feature" href="{{ tire_feature.system.url }}"><img src="{{ feature_image | image_url: width: 1800 }}" alt="{{ tire_feature.title.value | escape }}"><div class="fc"><div><h2>{{ tire_feature.title.value }}</h2><p>{{ tire_feature.description.value }}</p></div><span class="btn red">{{ tire_feature.primary_cta.value | default: tire_feature.cta.value | default: 'View offer' }} →</span></div></a>{% endif %}{% endif %}
    <div class="intro"><div class="eye">Tire deals &amp; rebates</div><h2>Tire Promotions</h2><p>Manufacturer rebates and instant savings on select tire brands. Click a promotion for full details.</p></div>
    <div class="grid">{% assign tire_count = 0 %}{% for promotion in promotions %}{% assign promotion_label = promotion.label.value | downcase %}{% unless promotion_label contains 'wheel' %}{% assign tire_count = tire_count | plus: 1 %}<a class="card" href="{{ promotion.system.url }}">{% if promotion.image.value != blank %}<img src="{{ promotion.image.value | image_url: width: 1200 }}" alt="{{ promotion.title.value | escape }}">{% endif %}<div class="copy"><h3>{{ promotion.title.value }}</h3><p>{{ promotion.description.value }}</p><span class="cta">{{ promotion.primary_cta.value | default: promotion.cta.value | default: 'View offer' }} →</span></div></a>{% endunless %}{% endfor %}{% if tire_count == 0 %}<div class="empty">Add an <b>ATS Promotion</b> entry with a label other than “Wheel Promotion” to show it here.</div>{% endif %}</div>
  </div></section>

  <section class="sec alt" id="wheels"><div class="aw"><div class="intro"><div class="eye">Wheel deals</div><h2>Wheel Promotions</h2><p>Brand-specific wheel discounts with promo codes. Click a promotion for its editable offer details and redemption information.</p></div><div class="grid">{% assign wheel_count = 0 %}{% for promotion in promotions %}{% assign promotion_label = promotion.label.value | downcase %}{% if promotion_label contains 'wheel' %}{% assign wheel_count = wheel_count | plus: 1 %}<a class="card" href="{{ promotion.system.url }}">{% if promotion.image.value != blank %}<img src="{{ promotion.image.value | image_url: width: 1200 }}" alt="{{ promotion.title.value | escape }}">{% endif %}<div class="copy"><h3>{{ promotion.title.value }}</h3><p>{{ promotion.description.value }}</p><span class="cta">{{ promotion.primary_cta.value | default: promotion.cta.value | default: 'View offer' }} →</span></div></a>{% endif %}{% endfor %}{% if wheel_count == 0 %}<div class="empty">Add an <b>ATS Promotion</b> entry, set its label to “Wheel Promotion,” and it will automatically appear here.</div>{% endif %}</div></div></section>

  <section class="sec"><div class="aw"><div class="intro"><div class="eye">Savings beyond tires</div><h2>More ways to save</h2></div><div class="benefits"><a class="benefit" href="/pages/promotions"><span class="ico">🎁</span><h3>Live Rebates &amp; Special Offers</h3><p>Current manufacturer rebates pulled live from TireConnect. Updated automatically.<br><br>Rebates from Michelin, Goodyear, Bridgestone, Continental, Cooper, and more.</p><span class="cta">View live manufacturer rebates →</span></a><a class="benefit" href="/pages/coupons"><span class="ico">✂</span><h3>Printable Service Coupons</h3><p>Save on oil changes, brakes, alignments, battery service, and more. 14 printable coupons accepted at all locations.</p><span class="cta">View all 14 coupons →</span></a><a class="benefit" href="/pages/financing"><span class="ico">$</span><h3>Financing by Snap Finance</h3><p>$0 Down · No Credit Check · 0% for 100 Days<br>Up to $7,500 in credit. Instant approval. No application or processing fees.</p><span class="cta">Apply for financing →</span></a><a class="benefit" href="/pages/locations"><span class="ico">⌖</span><h3>Available at All 7 Locations</h3><p>All offers are valid at every American Tire Stores location across Southern California.</p><span class="cta">Find your store →</span></a></div></div></section>

  <section class="sec alt"><div class="aw"><div class="intro"><div class="eye">Good to know</div><h2>Promotions FAQ</h2></div><div class="faq"><details><summary>What promotions are currently available?</summary><p>We run regular tire promotions including Buy 3 Get 1 FREE, brand-specific rebates, wheel brand discounts, and service coupons. Check this page regularly as offers change monthly.</p></details><details><summary>How do wheel promo codes work?</summary><p>Enter the qualifying code for a set of four eligible wheels.</p></details><details><summary>Can I combine promotions?</summary><p>Offers cannot usually be combined unless the promotion terms say otherwise.</p></details><details><summary>Do promotions apply at all locations?</summary><p>Yes. Current offers are available at all seven locations.</p></details></div></div></section>
  <section class="final"><h2>Ready to Save?</h2><p>Browse current deals, manufacturer rebates, and flexible financing at your nearest store.</p><a class="btn red" href="/pages/tire-search">Shop tires →</a><a class="btn clear" href="/pages/coupons">View coupons</a></section>
</main>

{% schema %}
{"name":"Promotions - CMS","settings":[{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"Current deals & rebates"},{"type":"text","id":"heading","label":"Hero heading","default":"Deals on Tires, Wheels, & Auto Service"},{"type":"textarea","id":"intro","label":"Hero copy","default":"Save on tires, wheels, and auto service at American Tire Stores. Browse manufacturer rebates, brand-specific wheel discounts, service coupons, and flexible financing — available at all seven Southern California locations."},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"featured_image","label":"Featured tire promotion image fallback"},{"type":"text","id":"primary_label","label":"Primary CTA label","default":"See tire deals"},{"type":"text","id":"secondary_label","label":"Secondary CTA label","default":"Wheel deals"}],"presets":[{"name":"Promotions - CMS"}]}
{% endschema %}
