<style>
.ats-promotions{--brand:#13315f;--red:#c51f28;--ink:#122240;--slate:#54617a;--line:#dde2ea;--pale:#f4f6fa;font-family:Montserrat,system-ui,sans-serif;color:var(--ink);background:#fff}.ats-promotions *{box-sizing:border-box}.ats-promotions .wrap{max-width:1200px;margin:auto;padding:0 24px}.ats-promotions .hero{padding:62px 0;background:linear-gradient(165deg,#0e2247,#0c1e3a 65%,#132c55);color:#fff;text-align:center}.ats-promotions .eyebrow{display:block;color:#ff6870;font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;margin-bottom:12px}.ats-promotions h1,.ats-promotions h2,.ats-promotions h3{font-family:'Akira Expanded',Archivo,sans-serif;letter-spacing:-.01em;text-transform:uppercase}.ats-promotions h1{font-size:clamp(31px,4vw,52px);line-height:1.1;margin:0}.ats-promotions .hero p{max-width:750px;margin:16px auto 0;color:#c7d2e6;font-size:16px;line-height:1.65}.ats-promotions .offers{padding:58px 0;background:var(--pale)}.ats-promotions .head{max-width:760px;margin:0 auto 26px;text-align:center}.ats-promotions .head h2{font-size:28px;color:var(--brand);margin:0 0 10px}.ats-promotions .head p{color:var(--slate);font-size:15px;line-height:1.6;margin:0}.ats-promotions .promo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.ats-promotions .promo-card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;color:inherit;text-decoration:none;transition:transform .15s,box-shadow .15s}.ats-promotions .promo-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px -20px rgba(0,0,0,.3)}.ats-promotions .pc-img{aspect-ratio:10/3;background:#13315f;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}.ats-promotions .pc-img img{display:block;width:100%;height:100%;object-fit:cover}.ats-promotions .pc-ph{position:absolute;inset:0;display:grid;place-items:center;background:repeating-linear-gradient(135deg,#13315f,#13315f 12px,#1a3d6f 12px,#1a3d6f 24px);color:#d2dced;font-family:'Akira Expanded',Archivo,sans-serif;font-size:11px;text-align:center;text-transform:uppercase;padding:10px}.ats-promotions .pc-badge{position:absolute;top:12px;right:12px;background:var(--red);color:#fff;font-family:'Akira Expanded',Archivo,sans-serif;font-size:10px;padding:6px 11px;border-radius:6px;text-transform:uppercase}.ats-promotions .pc-body{padding:20px 22px;display:flex;flex:1;flex-direction:column}.ats-promotions .promo-card h3{font-size:15px;color:var(--brand);line-height:1.35;margin:0 0 8px;text-wrap:balance}.ats-promotions .promo-card p{margin:0 0 14px;font-size:13.5px;line-height:1.5;color:var(--slate)}.ats-promotions .pc-meta{margin:0 0 13px;color:#6f7c91;font-size:12px;font-weight:700}.ats-promotions .pc-link{margin-top:auto;align-self:flex-start;color:var(--red);font-family:'Akira Expanded',Archivo,sans-serif;font-size:12px;font-weight:800;letter-spacing:.03em;text-transform:uppercase}.ats-promotions .empty{grid-column:1/-1;padding:34px;border:1px dashed #b3bed3;border-radius:14px;text-align:center;color:var(--slate)}@media(max-width:680px){.ats-promotions .hero{padding:46px 0}.ats-promotions .offers{padding:40px 0}.ats-promotions .promo-grid{grid-template-columns:1fr}.ats-promotions .head h2{font-size:22px}.ats-promotions .wrap{padding:0 18px}}
</style>
<div class="ats-promotions">
  {% render 'ats-offer-header' %}
  <section class="hero"><div class="wrap"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p></div></section>
  <section class="offers"><div class="wrap"><div class="head"><span class="eyebrow">Tire deals &amp; rebates</span><h2>Current promotions</h2><p>Manufacturer rebates, instant savings, and local offers. Select a promotion for complete details.</p></div><div class="promo-grid">
    {% assign cms_promotions = shop.metaobjects.ats_promotion.values %}
    {% if cms_promotions.size > 0 %}
      {% for promo in cms_promotions %}
        {% assign promo_title = promo.title.value | default: promo.title %}{% assign promo_label = promo.label.value | default: 'Promotion' %}{% assign promo_desc = promo.description.value | default: promo.description %}{% assign promo_image = promo.image.value %}{% assign promo_expiry = promo.expiry.value | default: promo.expiry %}{% assign promo_cta = promo.cta.value | default: 'View offer' %}{% assign promo_link = promo.system.url | default: promo.link.value | default: promo.link %}
        <a class="promo-card" href="{{ promo_link }}"><div class="pc-img">{% if promo_image != blank %}<img src="{{ promo_image | image_url: width: 1200 }}" alt="{{ promo_title | escape }}" loading="lazy">{% else %}<span class="pc-ph">American Tire Stores<br>Promotion</span>{% endif %}<span class="pc-badge">{{ promo_label }}</span></div><div class="pc-body"><h3>{{ promo_title }}</h3><p>{{ promo_desc }}</p>{% if promo_expiry != blank %}<span class="pc-meta">Valid through {{ promo_expiry }}</span>{% endif %}<span class="pc-link">{{ promo_cta }} &rarr;</span></div></a>
      {% endfor %}
    {% else %}
      {% for block in section.blocks %}
        <a class="promo-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><div class="pc-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% else %}<span class="pc-ph">American Tire Stores<br>Promotion</span>{% endif %}<span class="pc-badge">{{ block.settings.label }}</span></div><div class="pc-body"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p>{% if block.settings.expiry != blank %}<span class="pc-meta">Valid through {{ block.settings.expiry }}</span>{% endif %}<span class="pc-link">{{ block.settings.cta }} &rarr;</span></div></a>
      {% else %}<div class="empty">Add promotion cards in Theme Editor, or select Metaobjects as the content source.</div>{% endfor %}
    {% endif %}
  </div></div></section>
</div>
{% schema %}
{"name":"Promotions - CMS","settings":[{"type":"select","id":"source","label":"Content source","default":"blocks","options":[{"value":"blocks","label":"Theme Editor blocks"},{"value":"metaobjects","label":"Shopify Metaobjects: ats_promotion"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Promotions"},{"type":"text","id":"heading","label":"Heading","default":"Current tire and service promotions"},{"type":"textarea","id":"intro","label":"Intro","default":"Shop current American Tire Stores offers, tire rebates, service specials, and financing promotions available across Southern California."}],"blocks":[{"type":"promotion","name":"Promotion card","settings":[{"type":"text","id":"label","label":"Label","default":"Limited time"},{"type":"text","id":"title","label":"Title","default":"Buy 3, Get 1 Free"},{"type":"textarea","id":"description","label":"Description","default":"Save on eligible tire purchases at American Tire Stores."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"expiry","label":"Expiry","default":"December 31, 2026"},{"type":"url","id":"link","label":"Promotion detail-page link"},{"type":"text","id":"cta","label":"CTA","default":"View offer"}]}],"presets":[{"name":"Promotions - CMS","blocks":[{"type":"promotion"},{"type":"promotion","settings":{"label":"Financing","title":"Financing from $0 down","description":"Quick financing options for tires, wheels, and services."}},{"type":"promotion","settings":{"label":"Service special","title":"Save on auto service","description":"Rotating offers for brakes, oil changes, alignment, and more."}}]}]}
{% endschema %}
