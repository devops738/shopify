{% assign promotions = shop.metaobjects.ats_promotion.values %}
<style>
.ats-p{--n:#102e5c;--d:#0c2245;--r:#d21f2b;--i:#102b56;--m:#687897;--l:#dbe2ec;background:#fff;color:var(--i);font-family:Montserrat,Arial,sans-serif}.ats-p *{box-sizing:border-box}.ats-p a{text-decoration:none}.aw{max-width:1060px;margin:auto;padding:0 22px}.hero{background:linear-gradient(135deg,var(--n),var(--d));color:#fff;padding:36px 0}.hero .aw{display:grid;grid-template-columns:1.1fr .9fr;gap:55px;align-items:center}.eye{color:#ff716d;text-transform:uppercase;font-size:11px;letter-spacing:.14em;font-weight:900}.ats-p h1,.ats-p h2,.ats-p h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;text-transform:uppercase;font-weight:800}.hero h1{font-size:clamp(34px,4vw,56px);line-height:1.04;margin:12px 0}.hero p{line-height:1.6;color:#d5ddef}.heroimg{min-height:295px;border-radius:12px;background:#193a6b url('https://americantirestores.com/cdn/shop/files/ats-promotions-hero.jpg') center/cover}.heroimg img{width:100%;height:295px;display:block;object-fit:cover;border-radius:12px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;min-height:42px;border-radius:7px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.03em}.red{background:var(--r);color:#fff;box-shadow:0 4px 0 #a4141d}.clear{border:1px solid #b8c6de;color:#fff;margin-left:8px}.sec{padding:52px 0}.alt{background:#f4f6fa}.intro{text-align:center;max-width:720px;margin:0 auto 27px}.intro h2{font-size:27px;margin:8px 0}.intro p{color:var(--m);line-height:1.6}.grid,.benefits{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card,.benefit{border:1px solid var(--l);border-radius:12px;overflow:hidden;color:var(--i);background:#fff}.card:hover{transform:translateY(-3px);box-shadow:0 14px 28px #0c22451f}.card img{width:100%;height:auto;display:block;object-fit:contain;background:#173866}.copy,.benefit{padding:17px 16px}.copy h3,.benefit h3{font-size:14px;line-height:1.3;margin:0 0 8px}.copy p,.benefit p{color:var(--m);font-size:12.5px;line-height:1.5;margin:0 0 13px}.cta{color:var(--r);font-size:12px;font-weight:900;text-transform:uppercase}.feature{border:1px solid var(--l);border-radius:13px;overflow:hidden;color:var(--i);background:#fff;display:block;margin-bottom:42px}.feature img{width:100%;height:auto;display:block}.fc{display:flex;justify-content:space-between;gap:20px;padding:20px}.fc h2{font-size:21px;margin:0 0 8px}.fc p{color:var(--m);font-size:13px;margin:0}.ico{font-size:25px}.stores{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.store{border:1px solid var(--l);border-radius:12px;overflow:hidden;color:var(--i);background:#fff}.store img{width:100%;height:125px;object-fit:cover;display:block}.store div{padding:13px}.store h3{font-size:14px;margin:0 0 7px}.store p{font-size:12px;color:var(--m);line-height:1.45;margin:0 0 5px}.store strong{color:var(--r)}.faq{max-width:820px;margin:auto}.faq details{border-bottom:1px solid var(--l);padding:17px 0}.faq summary{font-weight:800;cursor:pointer;list-style:none}.faq summary:after{content:'+';float:right;color:var(--r);font-size:20px}.faq details[open] summary:after{content:'−'}.faq p{color:var(--m);line-height:1.6}.final{background:var(--d);color:#fff;text-align:center;padding:56px 20px}.final h2{font-size:30px;margin:0 0 12px}.final p{color:#d5ddef;max-width:620px;margin:0 auto 24px}@media(max-width:760px){.hero .aw,.grid,.benefits,.stores{grid-template-columns:1fr}.heroimg,.heroimg img{min-height:210px;height:210px}.fc{display:block}.sec{padding:38px 0}}
</style>
<main class="ats-p">{% render 'ats-offer-header' %}
<section class="hero"><div class="aw"><div><div class="eye">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p><p><a class="btn red" href="#tires">{{ section.settings.primary_label }} ↓</a><a class="btn clear" href="#wheels">{{ section.settings.secondary_label }}</a></p></div><div class="heroimg">{% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}">{% endif %}</div></div></section>
<section class="sec" id="tires"><div class="aw">{% if promotions.size > 0 %}{% assign f=promotions.first %}{% assign fi=f.image.value | default:section.settings.featured_image %}{% if fi != blank %}<a class="feature" href="{{ f.system.url }}"><img src="{{ fi | image_url: width: 1800 }}" alt="{{ f.title.value | escape }}"><div class="fc"><div><h2>{{ f.title.value }}</h2><p>{{ f.description.value }}</p></div><span class="btn red">{{ f.cta.value | default:'Shop tires' }} →</span></div></a>{% endif %}{% endif %}<div class="intro"><div class="eye">Tire deals &amp; rebates</div><h2>Tire Promotions</h2><p>Manufacturer rebates and instant savings on select tire brands. Click a promotion for full details.</p></div>{% assign ti='ats-promo-tire-01.jpg,ats-promo-tire-02.jpg,ats-promo-tire-03.jpg,ats-promo-tire-04.jpg,ats-promo-tire-05.jpg,ats-promo-tire-06.jpg'|split:',' %}<div class="grid">{% for p in promotions %}{% assign x=ti[forloop.index0] %}<a class="card" href="{{ p.system.url | default:'/pages/tire-search' }}">{% if p.image.value != blank %}<img src="{{ p.image.value | image_url: width: 1200 }}" alt="{{ p.title.value | escape }}">{% else %}<img src="{{ x | asset_url }}" alt="{{ p.title.value | escape }}">{% endif %}<div class="copy"><h3>{{ p.title.value }}</h3><p>{{ p.description.value }}</p><span class="cta">{{ p.cta.value | default:'View offer' }} →</span></div></a>{% endfor %}{% for b in section.blocks %}{% assign x=ti[forloop.index0] %}<a class="card" href="{{ b.settings.link }}" {{ b.shopify_attributes }}>{% if b.settings.image != blank %}<img src="{{ b.settings.image | image_url: width: 1200 }}" alt="{{ b.settings.title | escape }}">{% else %}<img src="{{ x | asset_url }}" alt="{{ b.settings.title | escape }}">{% endif %}<div class="copy"><h3>{{ b.settings.title }}</h3><p>{{ b.settings.description }}</p><span class="cta">{{ b.settings.cta }} →</span></div></a>{% endfor %}</div></div></section>
<section class="sec alt" id="wheels"><div class="aw"><div class="intro"><div class="eye">Wheel deals</div><h2>Wheel Promotions</h2><p>Brand-specific wheel discounts with promo codes. Enter the code at checkout to apply your savings.</p></div>{% assign wo='Method Wheels — $45 Off Set of 4|Save $45 on a set of 4 Method Race wheels. Code: METHOD45.|Shop Method,Lock Offroad — $40 Off Set of 4|Save $40 on a set of 4 Lock Offroad wheels. Code: LOCK40.|Shop Lock,Raceline — $40 Off Set of 4|Save $40 on a set of 4 Raceline wheels. Code: RACE40.|Shop Raceline,TIS Wheels — $40 Off Set of 4|Save $40 on a set of 4 TIS wheels. Code: TIS40.|Shop TIS,Curva — $30 Off Set of 4|Save $30 on a set of 4 Curva wheels. Code: CURVA30.|Shop Curva,Vision — $20 Off Set of 4|Save $20 on a set of 4 Vision wheels. Code: VISION20.,XXR — $20 Off Set of 4|Save $20 on a set of 4 XXR wheels. Code: XXR20.|Shop XXR'|split:',' %}{% assign wi='ats-promo-wheel-01.jpg,ats-promo-wheel-02.jpg,ats-promo-wheel-03.jpg,ats-promo-wheel-04.jpg,ats-promo-wheel-05.jpg,ats-promo-wheel-06.jpg,ats-promo-wheel-07.jpg'|split:',' %}<div class="grid">{% for o in wo %}{% assign a=o|split:'|' %}<a class="card" href="/pages/wheel-search"><img src="{{ wi[forloop.index0] | asset_url }}" alt="{{ a[0] | escape }}"><div class="copy"><h3>{{ a[0] }}</h3><p>{{ a[1] }}</p><span class="cta">{{ a[2] }} →</span></div></a>{% endfor %}</div></div></section>
<section class="sec"><div class="aw"><div class="intro"><div class="eye">Savings beyond tires</div><h2>More ways to save</h2></div><div class="benefits"><a class="benefit" href="/pages/promotions"><span class="ico">🎁</span><h3>Live Rebates &amp; Special Offers</h3><p>Current manufacturer rebates pulled live from TireConnect. Updated automatically.<br><br>Rebates from Michelin, Goodyear, Bridgestone, Continental, Cooper, and more.</p><span class="cta">View live manufacturer rebates →</span></a><a class="benefit" href="/pages/coupons"><span class="ico">✂</span><h3>Printable Service Coupons</h3><p>Save on oil changes, brakes, alignments, battery service, and more. 14 printable coupons accepted at all locations.</p><span class="cta">View all 14 coupons →</span></a><a class="benefit" href="/pages/financing"><span class="ico">$</span><h3>Financing by Snap Finance</h3><p>$0 Down · No Credit Check · 0% for 100 Days<br>Up to $7,500 in credit. Instant approval. No application or processing fees. Use at any location on tires, wheels, or service.</p><span class="cta">Apply for financing →</span></a><a class="benefit" href="/pages/locations"><span class="ico">⌖</span><h3>Available at All 7 Locations</h3><p>All offers are valid at every American Tire Stores location across Southern California.</p><span class="cta">Find your store →</span></a></div></div></section>
<section class="sec alt"><div class="aw"><div class="intro"><div class="eye">Near you</div><h2>Available at all 7 locations</h2><p>All offers are valid at your nearest American Tire Stores location.</p></div>{% assign ss='Ventura|5100 Telegraph Rd, Ventura, CA 93003|(805) 644-3330|location-ventura-ca|ats-locations-inline-05.jpg,Thousand Oaks|621 E Thousand Oaks Blvd, Thousand Oaks, CA 91360|(805) 495-7103|location-thousand-oaks-ca|ats-locations-inline-06.jpg,Los Angeles|1174 N. Western Ave., Los Angeles, CA 90029|(323) 372-9372|location-los-angeles-ca|ats-locations-inline-07.jpg,Glendale|737 S Glendale Ave, Glendale, CA 91205|(818) 243-3191|location-glendale-ca|ats-locations-inline-08.jpg,Glendale II|601 S Brand Blvd, Glendale, CA 91204|(818) 244-7600|location-glendale-ii-ca|ats-locations-inline-09.jpg,Bellflower|9509 Alondra Blvd, Bellflower, CA 90706|(562) 804-4737|location-bellflower-ca|ats-locations-inline-10.jpg,Cathedral City|68406 E Palm Canyon Dr, Cathedral City, CA 92234|(760) 469-9510|location-cathedral-city-ca|ats-locations-inline-11.jpg'|split:',' %}<div class="stores">{% for st in ss %}{% assign s=st|split:'|' %}<a class="store" href="/pages/{{ s[3] }}"><img src="{{ s[4]|asset_url }}" alt="American Tire Stores {{ s[0] }} storefront"><div><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p><p><strong>{{ s[2] }}</strong></p><p>Mon–Fri 8am–6pm · Sat 8am–5pm</p><span class="cta">View store →</span></div></a>{% endfor %}</div></div></section>
<section class="sec"><div class="aw"><div class="intro"><div class="eye">Good to know</div><h2>Promotions FAQ</h2></div><div class="faq"><details><summary>What promotions are currently available?</summary><p>We run regular tire promotions including Buy 3 Get 1 FREE, brand-specific rebates, wheel brand discounts, and service coupons. Check this page regularly as offers change monthly.</p></details><details><summary>How do wheel promo codes work?</summary><p>Enter the qualifying code for a set of four eligible wheels.</p></details><details><summary>Can I combine promotions?</summary><p>Offers cannot usually be combined unless the promotion terms say otherwise.</p></details><details><summary>How do manufacturer rebates work?</summary><p>Review the individual offer for current brand terms and submission instructions.</p></details><details><summary>Do promotions apply at all locations?</summary><p>Yes. Current offers are available at all seven locations.</p></details><details><summary>How does the Buy 3 Get 1 FREE work?</summary><p>Purchase three qualifying tires and receive the fourth free, subject to offer terms.</p></details><details><summary>Do you offer financing?</summary><p>Yes. Snap Finance is available at every location, subject to approval.</p></details><details><summary>Where can I find service coupons?</summary><p>Visit the Coupons page for current printable savings.</p></details></div></div></section>
<section class="final"><h2>Ready to Save?</h2><p>Browse current deals, manufacturer rebates, and flexible financing at your nearest store.</p><a class="btn red" href="/pages/tire-search">Shop tires →</a><a class="btn clear" href="/pages/coupons">View coupons</a></section></main>
{% schema %}{"name":"Promotions - CMS","settings":[{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"Current deals & rebates"},{"type":"text","id":"heading","label":"Hero heading","default":"Deals on Tires, Wheels, & Auto Service"},{"type":"textarea","id":"intro","label":"Hero copy","default":"Save on tires, wheels, and auto service at American Tire Stores. Browse manufacturer rebates, brand-specific wheel discounts, service coupons, and flexible financing — available at all seven Southern California locations."},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"featured_image","label":"Featured promotion image fallback"},{"type":"text","id":"primary_label","label":"Primary CTA label","default":"See tire deals"},{"type":"text","id":"secondary_label","label":"Secondary CTA label","default":"Wheel deals"}],"blocks":[{"type":"promotion","name":"Promotion card","settings":[{"type":"text","id":"title","label":"Title","default":"Promotion title"},{"type":"textarea","id":"description","label":"Description","default":"Promotion description."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Detail link"},{"type":"text","id":"cta","label":"CTA","default":"View offer"}]}],"presets":[{"name":"Promotions - CMS"}]}{% endschema %}
