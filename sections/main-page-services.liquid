document.querySelectorAll('.js-store').forEach(fillStores);
/* service cards: full content visible, image, no accordion */
/* DESIGNER RELAY: .svc-ic shows a temporary emoji — replace with a custom per-service icon (oil change, alignment, brakes, tire install, TPMS, battery) */
$('svcList').innerHTML=SERVICES.map((s,i)=>`<div class="svc-card2">
