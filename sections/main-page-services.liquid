const SVC_ICON={"Oil Change":"{{ 'ats-inline-69.png' | asset_url }}","Wheel Alignment":"{{ 'ats-inline-70.png' | asset_url }}","Brake Service":"{{ 'ats-inline-71.png' | asset_url }}","Tire Installation":"{{ 'ats-inline-72.png' | asset_url }}","Battery Service":"{{ 'ats-inline-73.png' | asset_url }}","TPMS Service":"{{ 'ats-inline-74.png' | asset_url }}"};
