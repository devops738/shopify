function pickSymptom(i){document.querySelectorAll('.symptom').forEach(c=>c.classList.toggle('active',c.dataset.i==i));const svc=SYMPTOMS[i][1];const o=$('symptomOut');o.hidden=false;o.innerHTML=`<span class="so-txt">Sounds like you may need <b>${svc}</b>. Pick it in the booking form and request a time.</span><button class="btn btn-red" onclick="selectService('${svc}')">Request an appointment &#8594;</button>`;}

const FAQ=[["Do I need an appointment?","Walk-ins are welcome, but booking online guarantees your spot and the shortest wait. Most services qualify for same-day appointments once you pick a store."],["How long will my service take?","Most routine services take 30 minutes to two hours \u2014 oil changes and battery swaps are quick, brakes and alignments take a little longer. Each service card shows a typical time."],["Can you install tires I bought somewhere else?","Yes. Book a tire installation, bring your tires, and we'll mount, balance, torque to spec, and reset your TPMS \u2014 usually the same day."],["How much will my service cost?","You'll get an upfront quote before any work begins. Final pricing depends on your vehicle and what it needs, and we'll always explain what's necessary now versus what can wait."],["Do you offer financing?","Yes \u2014 flexible financing with $0 down and quick approval, so brakes, batteries, and other service never have to wait for payday. Apply online in minutes and use it at any location."],["What should I bring to my appointment?","Just your keys and your wheel-lock key if you have one. If you're bringing your own tires or parts, have them ready. Your confirmation covers the rest."],["Do you offer same-day service?","Most fitments and services qualify for same-day appointments. You'll request a preferred time and the shop confirms your appointment — often the same day."],["Is there a warranty on the work?","Qualifying work is backed by a nationwide warranty that travels with you, plus optional road-hazard protection on tires. Ask your advisor what applies to your service."],["Which vehicles do you service?","We service most cars, trucks, SUVs, and vans. Add your vehicle so we can confirm the right parts and fitment before your appointment."],["How do I choose a store?","Pick your nearest American Tire Stores in the booking panel \u2014 Ventura, Thousand Oaks, Glendale, Los Angeles, Bellflower, or Cathedral City. Pricing and appointment requests are handled for that location."],["How do I know if I need brake repair?","Common signs include squealing or grinding, a soft or vibrating brake pedal, and the car pulling to one side when braking. Use the symptom checker above or book a brake inspection \u2014 our technicians diagnose the issue and quote the repair before starting any work."],["Are your technicians certified?","Yes. Every technician at American Tire Stores is certified to diagnose and repair your vehicle, from routine maintenance like oil changes to more involved work like brakes and wheel alignment."]];
$('faq').innerHTML=FAQ.map(([q,a],i)=>`<div class="qa" id="qa${i}"><button onclick="toggleFaq(${i})"><span>${q}</span><span class="ic">+</span></button><div class="a"><p>${a}</p></div></div>`).join('');

$('svcLocs').innerHTML=STORES.map((s,i)=>`<div class="svc-loc-card" onclick="pickStoreByIndex(${i})"><div class="svc-loc-card__img"><img src="${s.img}" alt="${s.name} storefront" loading="lazy"></div><div class="svc-loc-card__body"><h3>${s.city}</h3><p class="addr">${s.addr}, CA ${s.zip}</p><div class="phone">${s.ph}</div><div class="hours">Mon–Fri 8–6 · Sat 8–5</div><span class="book">Book Here →</span></div></div>`).join('');
function pickStoreByIndex(i){st.store=STORES[i];reflectState();scrollToBook();}

/* ---- booking: the embedded widget is the single transaction surface.
   These handlers only GUIDE the user to it and mirror header state — they never pre-fill or scrape the widget. ---- */
st.svc="";
function onStoreChange(el){st.store=el.value!==''?STORES[el.value]:null;reflectState();serviceContextChanged();}
function vehLabel(){return (st.make&&st.model)?((st.year?st.year+' ':'')+st.make+' '+st.model):null;}
/* read-only context strip above the widget — mirrors header-garage state; NOT read from the widget DOM */
function renderContext(){
 const wrap=$('bnContext');if(!wrap)return;
 const store=st.store, veh=vehLabel(), cs=$('bnCtxStore'), cv=$('bnCtxVeh');
 if(store){$('bnCtxStoreV').textContent=storeLabel(store);cs.hidden=false;}else cs.hidden=true;
 if(veh){$('bnCtxVehV').textContent=veh;cv.hidden=false;}else cv.hidden=true;
 wrap.hidden=!(store||veh);
}
function updateBook(){renderContext();} /* alias: reflectState() calls updateBook() to keep context in sync */
/* card / symptom actions: highlight + navigate to the widget. No service pre-select (widget owns service choice). */
function selectService(name){
 document.querySelectorAll('.svc-select').forEach(b=>{b.classList.remove('added');b.textContent="Book this service";});
 const idx=svcIndexByName(name);if(idx>-1){const b=$('sel'+idx);if(b){b.classList.add('added');b.textContent="\u2713 Selected";}}
 scrollToBook();
}
let tcServicesReady=false;
let tcServicesLoading=false;
function initTireConnectServices(){
 const mount=$('tireconnect');
 if(!mount||tcServicesReady||tcServicesLoading)return;
 persistTireConnectState();
 tcServicesLoading=true;
 mount.innerHTML='<div class="tc-mount__ph"><span class="tc-mount__label">Loading appointment request form...</span><span class="tc-mount__sub">Select vehicle &middot; select service &middot; preferred date &amp; time &middot; ready-by time &rarr; shop confirms</span></div>';
 const fail=function(){
  tcServicesLoading=false;
  if(tcServicesReady)return;
  mount.innerHTML='<div class="tc-mount__ph"><span class="tc-mount__label">Appointment request form</span><span class="tc-mount__sub">The booking form could not load. Please refresh the page or try again.</span><button class="btn btn-red" onclick="initTireConnectServices()">Retry loading form</button></div>';
 };
 const start=function(){
  if(!window.TCWidget||typeof window.TCWidget.initServices!=='function'){fail();return;}
  const ph=mount.querySelector('.tc-mount__ph');
  if(ph)ph.remove();
  const locId=st.store&&st.store.id?String(st.store.id):'';
  const cfg={
    apikey:TC_API_KEY,
    apiKey:TC_API_KEY,
    api_key:TC_API_KEY,
    key:TC_API_KEY,
    container:'tireconnect',
    locationId:locId,
    location_id:locId,
    location:locId,
    locationID:locId,
    location_lock:!!locId,
    locationLock:!!locId,
    locationSelector:locId?'lock':'show',
    locale:'en_US',
    searchParams:{location_id:locId,locationId:locId}
  };
  if(st.year&&st.make&&st.model){
    cfg.year=st.year;cfg.make=st.make;cfg.model=st.model;
    cfg.vehicleYear=st.year;cfg.vehicleMake=st.make;cfg.vehicleModel=st.model;
    cfg.vehicle_year=st.year;cfg.vehicle_make=st.make;cfg.vehicle_model=st.model;
    cfg.selectedYear=st.year;cfg.selectedMake=st.make;cfg.selectedModel=st.model;
    cfg.vehicle={year:st.year,make:st.make,model:st.model};
    cfg.vehicleParams={year:st.year,make:st.make,model:st.model};
    cfg.searchParams.year=st.year;cfg.searchParams.make=st.make;cfg.searchParams.model=st.model;
    cfg.searchParams.vehicle={year:st.year,make:st.make,model:st.model};
  }
  window.TCWidget.initServices(cfg);
  syncTireConnectServicesContext();
  tcServicesReady=true;
  tcServicesLoading=false;
 };
 if(window.TCWidget&&typeof window.TCWidget.initServices==='function'){start();return;}
 const src='https://app.tireconnect.ca/js/widget.js';
 let script=document.querySelector('script[src="'+src+'"]');
 if(!script){
  script=document.createElement('script');
  script.src=src;
  script.async=true;
  script.onerror=fail;
  document.head.appendChild(script);
 }
 script.addEventListener('load',start,{once:true});
 if(script.dataset.loaded==='true')start();
}
function scrollToBook(){
 renderContext();
 document.getElementById('booknow').scrollIntoView({behavior:'smooth',block:'start'});
 initTireConnectServices();
}
function railScroll(){scrollToBook();}
renderContext();
function toggleFaq(i){document.getElementById('qa'+i).classList.toggle('open');}
function toggleMenu(o){const m=document.getElementById('mobileMenu');m.classList.toggle('show',o===undefined?!m.classList.contains('show'):o);}

/* ---- close the vehicle picker on outside click / escape; init ---- */
document.addEventListener('click',e=>{const p=$('vehPop');if(p&&p.classList.contains('show')&&!e.target.closest('#vehPop')&&!e.target.closest('#vehField'))setVehPop(false);});
document.addEventListener('keydown',e=>{if(e.key==='Escape')setVehPop(false);});
reflectState();
initTireConnectServices();
</script>

