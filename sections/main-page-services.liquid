<script>
const STORES=[
 {name:"American Tire Stores — Ventura",city:"Ventura",addr:"5100 Telegraph Rd",zip:93003,id:52820,ph:"(805) 644-3330",img:"{{ 'ats-locations-inline-05.jpg' | asset_url }}"},
 {name:"American Tire Stores — Thousand Oaks",city:"Thousand Oaks",addr:"621 E Thousand Oaks Blvd",zip:91360,id:52819,ph:"(805) 495-7103",img:"{{ 'ats-locations-inline-06.jpg' | asset_url }}"},
 {name:"American Tire & Service — Los Angeles",city:"Los Angeles",addr:"1174 N. Western Ave.",zip:90029,id:61758,ph:"(323) 372-9372",img:"{{ 'ats-locations-inline-07.jpg' | asset_url }}"},
 {name:"American Tire Stores — Glendale",city:"Glendale",addr:"737 S Glendale Ave",zip:91205,id:52816,ph:"(818) 243-3191",img:"{{ 'ats-locations-inline-08.jpg' | asset_url }}"},
 {name:"American Tire Stores — Glendale II",city:"Glendale",addr:"601 S Brand Blvd",zip:91204,id:52818,ph:"(818) 244-7600",img:"{{ 'ats-locations-inline-09.jpg' | asset_url }}"},
 {name:"American Tire Stores — Bellflower",city:"Bellflower",addr:"9509 Alondra Blvd",zip:90706,id:52814,ph:"(562) 804-4737",img:"{{ 'ats-locations-inline-10.jpg' | asset_url }}"},
 {name:"American Tire Stores — Cathedral City",city:"Cathedral City",addr:"68406 E Palm Canyon Dr",zip:92234,id:52815,ph:"(760) 469-9510",img:"{{ 'ats-locations-inline-11.jpg' | asset_url }}"},
];
let VEH={};
const TC_API_KEY='c097aed9ad8c441bfff05ae020ca53f0';
const FALLBACK_VEH={
 "2024":{"Toyota":["Camry","RAV4","Corolla","Tacoma"],"Honda":["Civic","CR-V","Accord"],"Ford":["F-150","Explorer","Escape"],"Chevrolet":["Silverado","Equinox","Tahoe"]},
 "2022":{"Toyota":["Camry","RAV4","Highlander"],"Honda":["Civic","CR-V","Pilot"],"Ford":["F-150","Bronco","Mustang"],"Tesla":["Model 3","Model Y"]},
 "2020":{"Toyota":["Corolla","RAV4","4Runner"],"Honda":["Accord","CR-V"],"Jeep":["Wrangler","Grand Cherokee"],"Subaru":["Outback","Forester"]},
 "2018":{"Toyota":["Camry","Tacoma"],"Honda":["Civic","Accord"],"Nissan":["Altima","Rogue"],"Ford":["F-150","Focus"]}
};
function valuesFromPayload(payload){
  if(Array.isArray(payload))return payload;
  if(payload&&Array.isArray(payload.values))return payload.values;
  if(payload&&payload.data&&Array.isArray(payload.data.values))return payload.data.values;
  if(payload&&Array.isArray(payload.data))return payload.data;
  if(payload&&Array.isArray(payload.years))return payload.years;
  if(payload&&Array.isArray(payload.makes))return payload.makes;
  if(payload&&Array.isArray(payload.models))return payload.models;
  return [];
}
function normalizeVehicleValues(values){
  return values.map(v=>{
    if(typeof v==='string'||typeof v==='number')return String(v);
    return String(v.name||v.value||v.label||v.year||v.make||v.model||v.trim||'');
  }).filter(Boolean);
}
function vehicleApi(endpoint,params={}){
  const url=new URL(`https://wl.tireconnect.ca/api/v2/vehicle/${endpoint}`);
  url.searchParams.set('key',TC_API_KEY);
  Object.entries(params).forEach(([k,v])=>{if(v)url.searchParams.set(k,v);});
  return fetch(url.toString()).then(r=>r.ok?r.json():Promise.reject(new Error('Vehicle API failed'))).then(valuesFromPayload).then(normalizeVehicleValues);
}
function setLoading(sel,label){if(!sel)return;sel.disabled=true;sel.innerHTML=`<option value="" disabled selected hidden>${label}</option>`;}
async function initVehicleDropdowns(){
  setLoading($('hyear'),'Select');
  try{
    const years=await vehicleApi('years');
    if(years.length){VEH={};years.forEach(y=>VEH[y]={});fillOpts($('hyear'),years,'Select');return;}
  }catch(e){}
  VEH=JSON.parse(JSON.stringify(FALLBACK_VEH));
  fillOpts($('hyear'),Object.keys(VEH),'Select');
}
async function loadMakesForYear(year){
  if(!year)return [];
  if(VEH[year]&&Object.keys(VEH[year]).length)return Object.keys(VEH[year]);
  setLoading($('hmake'),'Select');
  try{
    const makes=await vehicleApi('makes',{year});
    VEH[year]=VEH[year]||{};
    makes.forEach(m=>{VEH[year][m]=VEH[year][m]||[];});
    return makes;
  }catch(e){
    VEH[year]=VEH[year]||{};
    return Object.keys(VEH[year]);
  }
}
async function loadModelsForMake(year,make){
  if(!year||!make)return [];
  if(VEH[year]&&Array.isArray(VEH[year][make])&&VEH[year][make].length)return VEH[year][make];
  setLoading($('hmodel'),'Select');
  try{
    const models=await vehicleApi('models',{year,make});
    VEH[year]=VEH[year]||{};VEH[year][make]=models;
    return models;
  }catch(e){
    VEH[year]=VEH[year]||{};VEH[year][make]=VEH[year][make]||[];
    return VEH[year][make];
  }
}
const $=id=>document.getElementById(id);
let st={mode:"vehicle",year:"",make:"",model:"",w:"",r:"",d:"",store:null};
function fillOpts(sel,arr,ph){if(!sel)return;sel.innerHTML='<option value="" disabled selected hidden>'+ph+'</option>';arr.forEach(v=>sel.add(new Option(v,v)));sel.disabled=!arr.length;}
function storeLabel(s){return (s.name.split('— ')[1]||s.name);}
function fillStores(sel){if(!sel)return;const ph=sel.id==='hstore'?'Choose…':'Select a store';sel.innerHTML='<option value="">'+ph+'</option>';STORES.forEach((s,i)=>sel.add(new Option(storeLabel(s),i)));}
fillStores($('store'));fillStores($('hstore'));
restoreTireConnectState();
initVehicleDropdowns().then(async()=>{if(st.year)await loadMakesForYear(st.year);if(st.year&&st.make)await loadModelsForMake(st.year,st.make);reflectState();});

/* one source of truth: st -> reflected into hero form AND header fields */
function syncSel(yId,mkId,mdId){const y=$(yId),mk=$(mkId),md=$(mdId);if(!y)return;
 y.value=st.year||'';
 const makes=(st.year&&VEH[st.year])?Object.keys(VEH[st.year]):[];
 fillOpts(mk,makes,'Select');mk.disabled=!st.year||!makes.length;mk.value=st.make||'';
 const models=(st.year&&st.make&&VEH[st.year]&&VEH[st.year][st.make])?VEH[st.year][st.make]:[];
 fillOpts(md,models,'Select');md.disabled=!(st.year&&st.make)||!models.length;md.value=st.model||'';}
function reflectState(){
 persistTireConnectState();
 const si=st.store?String(STORES.indexOf(st.store)):'';
 if($('store'))$('store').value=si; if($('hstore'))$('hstore').value=si;
 if($('storeStamp')){if(st.store){$('stName').textContent=st.store.name;$('stAddr').textContent=st.store.addr+' · '+st.store.city+', CA';$('storeStamp').classList.add('show');}else $('storeStamp').classList.remove('show');}
 const sf=$('storeField');if(sf)sf.classList.toggle('set',!!st.store);
 syncSel('year','make','model');syncSel('hyear','hmake','hmodel');
 const vv=$('vehVal');if(vv)vv.textContent=(st.make&&st.model)?((st.year?st.year+' ':'')+st.make+' '+st.model):'Not selected…';
 const vf=$('vehField');if(vf)vf.classList.toggle('set',!!(st.make&&st.model));
 checkReadyOnly();if(typeof updateBook==='function')updateBook();}
function checkReadyOnly(){const okV=st.year&&st.make&&st.model&&st.store;const okS=st.w&&st.r&&st.d&&st.store;const b=$('findBtn');if(b)b.disabled=!(st.mode==='vehicle'?okV:okS);}

function switchTab(m){st.mode=m;document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===m));$('pane-vehicle').classList.toggle('active',m==='vehicle');$('pane-size').classList.toggle('active',m==='size');checkReadyOnly();}
/* hero vehicle */
async function onYear(){st.year=$('year').value;st.make='';st.model='';reflectState();await loadMakesForYear(st.year);reflectState();serviceContextChanged();if(st.year&&$('make'))$('make').focus();}
async function onMake(){st.make=$('make').value;st.model='';reflectState();await loadModelsForMake(st.year,st.make);reflectState();serviceContextChanged();if(st.make&&$('model'))$('model').focus();}
function onModel(){st.model=$('model').value;reflectState();serviceContextChanged();}
function onSize(){st.w=$('w').value;st.r=$('r').value;st.d=$('d').value;checkReadyOnly();}
/* store (hero + header selects share st) */
function onStore(){st.store=$('store').value!==''?STORES[$('store').value]:null;reflectState();serviceContextChanged();}
function onHStore(){st.store=$('hstore').value!==''?STORES[$('hstore').value]:null;reflectState();serviceContextChanged();}
function focusStore(){$('store').focus();}
/* header vehicle picker */
async function hOnYear(){st.year=$('hyear').value;st.make='';st.model='';reflectState();await loadMakesForYear(st.year);reflectState();serviceContextChanged();if(st.year&&$('hmake'))$('hmake').focus();}
async function hOnMake(){st.make=$('hmake').value;st.model='';reflectState();await loadModelsForMake(st.year,st.make);reflectState();serviceContextChanged();if(st.make&&$('hmodel'))$('hmodel').focus();}
function hOnModel(){st.model=$('hmodel').value;reflectState();serviceContextChanged();if(st.model)setVehPop(false);}
function toggleVeh(){setVehPop();}
function setVehPop(open){const p=$('vehPop');if(!p)return;p.classList.toggle('show',open===undefined?!p.classList.contains('show'):open);}
function serviceContextChanged(){
 persistTireConnectState();
 renderContext();
 if(typeof tcServicesReady!=='undefined'&&tcServicesReady)syncTireConnectServicesContext();
}
function normTxt(v){return String(v||'').trim().toLowerCase();}
function selectWidgetValue(select,value){
 if(!select||!value)return false;
 const want=normTxt(value);
 const opt=[...select.options].find(o=>normTxt(o.value)===want||normTxt(o.textContent)===want||normTxt(o.textContent).includes(want));
 if(!opt)return false;
 select.value=opt.value;
 select.dispatchEvent(new Event('input',{bubbles:true}));
 select.dispatchEvent(new Event('change',{bubbles:true}));
 return true;
}
function serviceWidgetSelects(){
 const root=$('tireconnect');
 if(!root)return [];
 let selects=[...root.querySelectorAll('select')];
 if(!selects.length){
  try{
   const frame=root.querySelector('iframe');
   if(frame&&frame.contentDocument)selects=[...frame.contentDocument.querySelectorAll('select')];
  }catch(e){}
 }
 return selects;
}
function syncTireConnectServicesContext(){
 let tries=0;
 const tick=()=>{
  tries++;
  const selects=serviceWidgetSelects();
  if(st.store){
   const storeVals=[String(st.store.id),st.store.city,storeLabel(st.store),st.store.name,st.store.addr].filter(Boolean);
   const storeSel=selects.find(s=>storeVals.some(v=>[...s.options].some(o=>normTxt(o.value)===normTxt(v)||normTxt(o.textContent).includes(normTxt(v)))));
   if(storeSel)storeVals.some(v=>selectWidgetValue(storeSel,v));
  }
  if(st.year&&st.make&&st.model){
   const yearSel=selects.find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.year)||normTxt(o.value)===normTxt(st.year)));
   if(yearSel)selectWidgetValue(yearSel,st.year);
   setTimeout(()=>{
    const makeSel=serviceWidgetSelects().find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.make)||normTxt(o.value)===normTxt(st.make)));
    if(makeSel)selectWidgetValue(makeSel,st.make);
   },220);
   setTimeout(()=>{
    const modelSel=serviceWidgetSelects().find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.model)||normTxt(o.value)===normTxt(st.model)));
    if(modelSel)selectWidgetValue(modelSel,st.model);
   },520);
  }
  if(tries<30)setTimeout(tick,420);
 };
 setTimeout(tick,300);
}

function storageJson(keys){
 try{
  for(const k of keys){
   const raw=localStorage.getItem(k)||sessionStorage.getItem(k);
   if(raw){try{return JSON.parse(raw);}catch(e){return raw;}}
  }
 }catch(e){}
 return null;
}
function persistTireConnectState(){
 try{
  if(st.store){
   const storePayload={name:st.store.name,city:st.store.city,address:st.store.addr,addr:st.store.addr,zip:st.store.zip,phone:st.store.ph,id:st.store.id,location_id:st.store.id,locationId:st.store.id};
   localStorage.setItem('atsTireConnectStore',JSON.stringify(storePayload));
   sessionStorage.setItem('atsTireConnectStore',JSON.stringify(storePayload));
   ['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(st.store.id));sessionStorage.setItem(k,String(st.store.id));});
  }
  if(st.year&&st.make&&st.model){
   const vehiclePayload={year:st.year,make:st.make,model:st.model};
   ['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'].forEach(k=>{localStorage.setItem(k,JSON.stringify(vehiclePayload));sessionStorage.setItem(k,JSON.stringify(vehiclePayload));});
  }
  window.dispatchEvent(new CustomEvent('ats:tireconnect-updated'));
 }catch(e){}
}
function restoreTireConnectState(){
 try{
  const params=new URLSearchParams(window.location.search);
  const savedStore=storageJson(['atsTireConnectStore']);
  const locationId=params.get('location_id')||params.get('locationId')||localStorage.getItem('atsTireConnectLocationId')||sessionStorage.getItem('atsTireConnectLocationId')||(savedStore&&(savedStore.location_id||savedStore.locationId||savedStore.id))||'';
  if(locationId){const match=STORES.find(s=>String(s.id)===String(locationId));if(match)st.store=match;}
  const savedVehicle=storageJson(['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'])||{};
  st.year=params.get('year')||savedVehicle.year||savedVehicle.vehicleYear||savedVehicle.vehicle_year||'';
  st.make=params.get('make')||savedVehicle.make||savedVehicle.vehicleMake||savedVehicle.vehicle_make||'';
  st.model=params.get('model')||savedVehicle.model||savedVehicle.vehicleModel||savedVehicle.vehicle_model||'';
 }catch(e){}
}

function toast(b,m,s){$('toastBadge').textContent=b;$('toastMsg').innerHTML=m+(s?`<small>${s}</small>`:"");const t=$('toast');t.classList.add('show');clearTimeout(window._t);window._t=setTimeout(()=>t.classList.remove('show'),3600);}

const SERVICES=[
 {n:"Oil Change",ic:"\ud83d\udee2\ufe0f",u:"/pages/service-oil-change",t:"~30 min",b:"Fresh oil and a new filter protect your engine, improve efficiency, and extend its life. We use the grade your manufacturer recommends and check your other fluids and filters while we're in there.",incl:["Engine oil replacement","New oil filter","Fluid level top-off","Multi-point inspection"]},
 {n:"Wheel Alignment",ic:"\ud83c\udfaf",u:"/pages/service-wheel-alignment",t:"~1 hr",b:"Proper alignment keeps your tires wearing evenly, your steering straight, and your car handling the way it should \u2014 saving you money on tires down the road.",incl:["Alignment angle check","Camber / caster / toe adjustment","Steering & suspension check","Road-test verification"]},
 {n:"Brake Service",ic:"\ud83d\uded1",u:"/pages/service-brake-service",t:"~1\u20132 hr",b:"Confident stopping starts with healthy brakes. We inspect pads, rotors, and hardware, explain exactly what needs attention, and only recommend what your car actually needs.",incl:["Full brake inspection","Pad & rotor service","Hardware check","Brake fluid check"]},
 {n:"Tire Installation",ic:"\ud83d\udede",u:"/pages/service-tire-installation",t:"~45 min",b:"Bought tires here or elsewhere? We mount, balance, and install them right \u2014 with a TPMS reset and a torque-to-spec finish so you roll out safely.",incl:["Mounting & balancing","TPMS reset","Torque to spec","Old tire disposal"]},
 {n:"Battery Service",ic:"\ud83d\udd0b",u:"/pages/service-battery-service",t:"~30 min",b:"Slow starts and dashboard warnings usually mean a tired battery. We test your battery and charging system and replace it on the spot if it's time.",incl:["Battery & charging test","Battery replacement","Terminal cleaning","Old battery recycling"]},
