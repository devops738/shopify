.verify-flag{display:inline-block;font-family:'IBM Plex Mono','Montserrat',monospace;font-size:9.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#7a5c00;background:#fdf0cf;border:1px solid #e6c975;border-radius:3px;padding:1px 5px;margin-right:5px}
