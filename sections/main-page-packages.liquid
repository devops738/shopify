/* ===== packages brand rail - appended at end of document on purpose:
   this page keeps its own styles in the BODY, so a <head> block would lose ===== */
#pkg-brands .brand-rail-wrap{position:relative;max-width:1120px;margin:0 auto}
#pkg-brands .brand-rail{display:grid;grid-auto-flow:column;grid-template-rows:repeat(4,1fr);
  grid-auto-columns:calc((100% - 4*14px)/5);gap:14px;overflow-x:auto;overscroll-behavior-x:contain;
  scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 6px}
#pkg-brands .brand-rail::-webkit-scrollbar{display:none}
#pkg-brands .brand-rail>*{scroll-snap-align:start}
#pkg-brands .brand-rail:focus-visible{outline:2px solid var(--red);outline-offset:4px;border-radius:12px}
/* the page already carries an unused .blogo rule (aspect-ratio:170/70; display:grid).
   every property it sets is restated here so the rail is not at its mercy. */
#pkg-brands .brand-rail .blogo{aspect-ratio:auto;width:auto;height:92px;position:relative;
  background:#fff;border:1.5px solid var(--line);border-radius:12px;
  display:flex;align-items:center;justify-content:center;text-align:center;
  padding:12px;gap:0;box-sizing:border-box;cursor:default;transition:none}
#pkg-brands .brand-rail .blogo:hover{border-color:var(--line);box-shadow:none;transform:none;background:#fff}
#pkg-brands .brand-rail .blogo-img{max-width:100%;max-height:54px;width:auto;height:auto;object-fit:contain}
#pkg-brands .bword{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:700;font-size:13px;
