<style>/* ===== packages brand rail - appended at end of document on purpose:
   this page keeps its own styles in the BODY, so a <head> block would lose ===== */
#pkg-brands .brand-rail-wrap{position:relative;max-width:1120px;margin:0 auto}
#pkg-brands .brand-rail{display:grid;grid-auto-flow:column;grid-template-rows:repeat(4,1fr);
  grid-auto-columns:calc((100% - 4*14px)/5);gap:14px;overflow-x:auto;overscroll-behavior-x:contain;
  scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 6px}
#pkg-brands .brand-rail::-webkit-scrollbar{display:none}
#pkg-brands .brand-rail>*{scroll-snap-align:start}
#pkg-brands .brand-rail:focus-visible{outline:2px solid var(--red);outline-offset:4px;border-radius:12px}
/* the page already carries an unused .blogo rule (aspect-ratio:170/70; display:grid).
   every property it sets is restated here so the rail is not at its mercy. */
#pkg-brands .brand-rail .blogo{aspect-ratio:auto;width:auto;height:92px;position:relative;
  background:#fff;border:1.5px solid var(--line);border-radius:12px;
  display:flex;align-items:center;justify-content:center;text-align:center;
  padding:12px;gap:0;box-sizing:border-box;cursor:default;transition:none}
#pkg-brands .brand-rail .blogo:hover{border-color:var(--line);box-shadow:none;transform:none;background:#fff}
#pkg-brands .brand-rail .blogo-img{max-width:100%;max-height:54px;width:auto;height:auto;object-fit:contain}
#pkg-brands .bword{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:700;font-size:13px;
  line-height:1.25;color:var(--brand);text-align:center;letter-spacing:-.01em;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#pkg-brands .brail-nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;z-index:2;
  border-radius:50%;background:#fff;border:1.5px solid var(--line);display:flex;align-items:center;
  justify-content:center;box-shadow:0 8px 20px -10px rgba(12,30,58,.45);transition:.14s;cursor:pointer}
#pkg-brands .brail-nav svg{width:20px;height:20px;fill:none;stroke:var(--brand);stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round}
#pkg-brands .brail-nav:hover:not(:disabled){background:var(--brand);border-color:var(--brand)}
#pkg-brands .brail-nav:hover:not(:disabled) svg{stroke:#fff}
#pkg-brands .brail-nav:disabled{opacity:0;pointer-events:none}
#pkg-brands .brail-nav.prev{left:-19px}#pkg-brands .brail-nav.next{right:-19px}
#pkg-brands .brand-dots{display:flex;gap:7px;justify-content:center;margin-top:18px}
#pkg-brands .bdot{width:8px;height:8px;border-radius:50%;background:#cfd8e6;border:0;padding:0;
  transition:.16s;cursor:pointer}
#pkg-brands .bdot.on{background:var(--red);width:22px;border-radius:5px}
#pkg-brands .brand-prog{position:relative;height:4px;border-radius:2px;background:#dbe2ed;max-width:190px;
  margin:18px auto 0;display:block}
#pkg-brands .bprog-thumb{position:absolute;top:0;bottom:0;background:var(--red);border-radius:2px;
  transition:left .12s linear,width .12s linear}
#pkg-brands .brand-all{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap}
#pkg-brands .brand-all .pill{text-decoration:none;display:inline-flex;align-items:center}
#pkg-brands .dev-note{margin-top:26px}
@media(max-width:1180px){#pkg-brands .brail-nav.prev{left:4px}#pkg-brands .brail-nav.next{right:4px}}
@media(max-width:1000px){#pkg-brands .brand-rail{grid-auto-columns:calc((100% - 3*14px)/4)}}
@media(max-width:820px){#pkg-brands .brand-rail{grid-auto-columns:calc((100% - 2*12px)/3);gap:12px}}
@media(max-width:560px){#pkg-brands .brand-rail{grid-auto-columns:calc((100% - 10px)/2);gap:10px}
  #pkg-brands .brand-rail .blogo{height:84px;padding:10px}
  #pkg-brands .brand-rail .blogo-img{max-height:46px}}
@media(prefers-reduced-motion:reduce){#pkg-brands .brand-rail{scroll-behavior:auto}}</style>
