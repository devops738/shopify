(function(){
  var rail=document.getElementById('pkgBrandRail'); if(!rail) return;
  var prev=document.getElementById('pkgBrandPrev'), next=document.getElementById('pkgBrandNext');
  var dots=document.getElementById('pkgBrandDots');
  var esc=function(x){return String(x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');};
  rail.innerHTML=ALL_BRANDS.map(function(b){
    var name=b[0], kind=b[1], logo=BRAND_LOGOS[name];
    var label=name+' '+(kind==='tire'?'tires':'wheels');
    var inner=logo
      ? '<img class="blogo-img" src="'+logo+'" alt="'+esc(label)+'" loading="lazy" decoding="async">'
      : '<span class="bword">'+esc(name)+'</span>';
    return '<div class="blogo" role="listitem" aria-label="'+esc(label)+'">'+inner+'</div>';
  }).join('');
  var page=0, mode='';
  function pages(){return Math.max(1,Math.ceil(rail.scrollWidth/rail.clientWidth));}
  function paint(){
    if(rail.clientWidth===0) return;
    var n=pages(); page=Math.round(rail.scrollLeft/rail.clientWidth);
    var want=n>8?'bar':'dots';
    if(mode!==want||(want==='dots'&&dots.children.length!==n)){
      mode=want;
      dots.className=want==='bar'?'brand-prog':'brand-dots';
      if(want==='bar'){dots.innerHTML='<span class="bprog-thumb"></span>';}
      else{
        dots.innerHTML=Array.from({length:n},function(_,i){
          return '<button class="bdot" type="button" aria-label="Brand page '+(i+1)+' of '+n+'"></button>';}).join('');
        Array.prototype.forEach.call(dots.children,function(d,i){
          d.onclick=function(){rail.scrollTo({left:i*rail.clientWidth,behavior:'smooth'});};});
      }
    }
    if(mode==='bar'){
      var th=dots.firstChild, frac=rail.clientWidth/rail.scrollWidth;
      th.style.width=Math.max(12,frac*100)+'%';
      th.style.left=(rail.scrollLeft/rail.scrollWidth)*100+'%';
      dots.setAttribute('aria-label','Brand page '+(page+1)+' of '+n);
    } else {
      Array.prototype.forEach.call(dots.children,function(d,i){
        d.classList.toggle('on',i===page); d.setAttribute('aria-current',i===page?'true':'false');});
    }
    prev.disabled=rail.scrollLeft<8;
    next.disabled=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-8;
  }
  function step(dir){rail.scrollBy({left:dir*rail.clientWidth,behavior:'smooth'});}
  prev.onclick=function(){step(-1);};
  next.onclick=function(){step(1);};
  rail.addEventListener('scroll',paint,{passive:true});
  window.addEventListener('resize',paint);
  paint();
})();
</script>
<style>/* ===== packages hero art - appended at end of document on purpose:
   this page keeps its own styles in the BODY, so a <head> block would lose.
   The four build cards need no CSS here: they use the page's existing
   .pk-card__img contract, scrim included. ===== */
.pk-hero.pk-hero--photo{position:relative;overflow:hidden;background:var(--brand);
  padding:clamp(56px,7vw,92px) 0}
.pk-hero.pk-hero--photo::before{content:"";position:absolute;inset:0;z-index:0;
  background-image:url("{{ 'netlify-packages-source-143-5325c5d1775874eb.jpg' | asset_url }}");background-size:cover;background-position:center right;
  background-repeat:no-repeat}
/* scrim: near-opaque navy where the copy sits, clearing toward the wheel and tire
   on the right. keeps the h1 and lead legible without flattening the photograph. */
.pk-hero.pk-hero--photo::after{content:"";position:absolute;inset:0;z-index:0;
  background:linear-gradient(100deg,
    rgba(11,32,66,.96) 0%, rgba(11,32,66,.93) 34%,
    rgba(11,32,66,.74) 52%, rgba(11,32,66,.30) 74%, rgba(11,32,66,.12) 100%)}
.pk-hero.pk-hero--photo .wrap{position:relative;z-index:1;display:block}
.pk-hero.pk-hero--photo .pk-hero__copy{max-width:600px}
.pk-hero.pk-hero--photo h1{text-shadow:0 2px 18px rgba(4,14,32,.5)}
.pk-hero.pk-hero--photo .lead{text-shadow:0 1px 12px rgba(4,14,32,.5)}
@media(max-width:900px){
  .pk-hero.pk-hero--photo::before{background-position:center}
  .pk-hero.pk-hero--photo::after{background:linear-gradient(175deg,
    rgba(11,32,66,.94) 0%, rgba(11,32,66,.90) 55%, rgba(11,32,66,.84) 100%)}
  .pk-hero.pk-hero--photo .pk-hero__copy{max-width:none}
}
@media(prefers-reduced-motion:no-preference){
  .pk-hero.pk-hero--photo::before{will-change:auto}
}</style>
