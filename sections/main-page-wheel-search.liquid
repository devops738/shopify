function fillOpts(sel,arr,ph){if(!sel)return;sel.innerHTML='<option value="">'+ph+'</option>';arr.forEach(v=>sel.add(new Option(v,v)));}
function storeLabel(s){return (s.name.split('— ')[1]||s.name);}
function fillStores(sel){if(!sel)return;const ph=sel.id==='hstore'?'Choose…':'Select a store';sel.innerHTML='<option value="">'+ph+'</option>';STORES.forEach((s,i)=>sel.add(new Option(storeLabel(s),i)));}
if($('year'))fillOpts($('year'),Object.keys(VEH),'Year');fillOpts($('hyear'),Object.keys(VEH),'Year');
fillStores($('store'));fillStores($('hstore'));

/* one source of truth: st -> reflected into hero form AND header fields */
function syncSel(yId,mkId,mdId){const y=$(yId),mk=$(mkId),md=$(mdId);if(!y)return;
 y.value=st.year||'';
 fillOpts(mk,st.year?Object.keys(VEH[st.year]):[],'Make');mk.disabled=!st.year;mk.value=st.make||'';
 fillOpts(md,(st.year&&st.make)?VEH[st.year][st.make]:[],'Model');md.disabled=!(st.year&&st.make);md.value=st.model||'';}
function reflectState(){
 const si=st.store?String(STORES.indexOf(st.store)):'';
 if($('store'))$('store').value=si; if($('hstore'))$('hstore').value=si;
 if($('storeStamp')){if(st.store){$('stName').textContent=st.store.name;$('stAddr').textContent=st.store.addr+' · '+st.store.city+', CA';$('storeStamp').classList.add('show');}else $('storeStamp').classList.remove('show');}
 const sf=$('storeField');if(sf)sf.classList.toggle('set',!!st.store);
 syncSel('year','make','model');syncSel('hyear','hmake','hmodel');
 const vv=$('vehVal');if(vv)vv.textContent=(st.make&&st.model)?((st.year?st.year+' ':'')+st.make+' '+st.model):'Not selected…';
 const vf=$('vehField');if(vf)vf.classList.toggle('set',!!(st.make&&st.model));
 checkReadyOnly();}
function checkReadyOnly(){const okV=st.year&&st.make&&st.model&&st.store;const okS=st.w&&st.r&&st.d&&st.store;const b=$('findBtn');if(b)b.disabled=!(st.mode==='vehicle'?okV:okS);}

function switchTab(m){st.mode=m;document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===m));$('pane-vehicle').classList.toggle('active',m==='vehicle');$('pane-size').classList.toggle('active',m==='size');checkReadyOnly();}
/* hero vehicle */
function onYear(){st.year=$('year').value;st.make='';st.model='';reflectState();}
function onMake(){st.make=$('make').value;st.model='';reflectState();}
function onModel(){st.model=$('model').value;reflectState();}
function onSize(){st.w=$('w').value;st.r=$('r').value;st.d=$('d').value;checkReadyOnly();}
/* store (hero + header selects share st) */
function onStore(){st.store=$('store').value!==''?STORES[$('store').value]:null;reflectState();}
function onHStore(){st.store=$('hstore').value!==''?STORES[$('hstore').value]:null;reflectState();}
function focusStore(){$('store').focus();}
/* header vehicle picker */
function hOnYear(){st.year=$('hyear').value;st.make='';st.model='';reflectState();}
function hOnMake(){st.make=$('hmake').value;st.model='';reflectState();}
function hOnModel(){st.model=$('hmodel').value;reflectState();if(st.model)setVehPop(false);}
function toggleVeh(){setVehPop();}
function setVehPop(open){const p=$('vehPop');if(!p)return;p.classList.toggle('show',open===undefined?!p.classList.contains('show'):open);}

function findTires(){checkReadyOnly();if($('findBtn').disabled){document.querySelector('.hero').scrollIntoView({behavior:'smooth'});toast("SHOP","Choose your fit + store","pick your vehicle and store above");return;}const loc='changeLocation('+st.store.id+')';if(st.mode==='vehicle')toast("SHOP → TIRECONNECT","searchByVehicle() · "+loc,`${st.year} ${st.make} ${st.model} · ${st.store.name}`);else toast("SHOP → TIRECONNECT","searchBySize() · "+loc,`${st.w}/${st.r}R${st.d} · ${st.store.name}`);}
function bookService(){tcTab('book',true);loadBook();}
function toast(b,m,s){$('toastBadge').textContent=b;$('toastMsg').innerHTML=m+(s?`<small>${s}</small>`:"");const t=$('toast');t.classList.add('show');clearTimeout(window._t);window._t=setTimeout(()=>t.classList.remove('show'),3600);}


function jump(id){document.getElementById(id).scrollIntoView({behavior:'smooth',block:'center'});}
function toggleFaq(i){document.getElementById('qa'+i).classList.toggle('open');}
function toggleMenu(o){const m=document.getElementById('mobileMenu');m.classList.toggle('show',o===undefined?!m.classList.contains('show'):o);}</script>
