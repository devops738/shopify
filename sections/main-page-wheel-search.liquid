<script>
/* The supplied Wheel Brands page remains intact; replace its reference mount
   with the live TireConnect wheel search and initialize it immediately. */
(function(){
  var mount=document.getElementById('wh-mount');
  var widgetScript;
  if(!mount)return;
  function selectedStore(){
    try{
      if(typeof st!=='undefined'&&st.store)return st.store;
      var id=localStorage.getItem('atsTireConnectLocationId');
      return id?{id:id}:null;
    }catch(e){return null;}
  }
  function renderWidget(){
    var store=selectedStore();
    var locationId=store&&(store.id||store.locationId||store.location_id);
    var config={
      apikey:'c097aed9ad8c441bfff05ae020ca53f0',apiKey:'c097aed9ad8c441bfff05ae020ca53f0',
      container:'wh-mount',locale:'en_US',allowed_products:['wheel'],product_type:'wheel',
      locationId:locationId||undefined,location_id:locationId||undefined,
      location_lock:!!locationId,locationLock:!!locationId,
      redirect_url:location.pathname,catalog_url:location.pathname
    };
    mount.innerHTML='';
    try{window.TCWidget.init(config);}catch(error){
      mount.innerHTML='<div class="tc-live"><div class="tc-live__body">The live wheel search could not start. Please refresh and try again.</div></div>';
    }
  }
  function ensureWidget(){
    if(window.TCWidget&&typeof window.TCWidget.init==='function'){renderWidget();return;}
    if(widgetScript)return;
    widgetScript=document.createElement('script');
    widgetScript.src='https://app.tireconnect.ca/js/widget.js';
    widgetScript.async=true;
    widgetScript.onload=renderWidget;
    widgetScript.onerror=function(){mount.innerHTML='<div class="tc-live"><div class="tc-live__body">The live wheel search is temporarily unavailable. Please refresh and try again.</div></div>';};
    document.head.appendChild(widgetScript);
  }
  window.loadWheelWidget=ensureWidget;
  window.setTimeout(ensureWidget,0);
})();
