{% comment %} Generated from the supplied Netlify export. Keep source assets in /assets. {% endcomment %}
<style>

:root{
  --navy:#0c1e3a;--brand:#13315f;--blue:#1b47a3;--blue-2:#2358c4;
  --red:#c51f28;--red-deep:#a5171f;--red-press:#86121a;
  --ink:#122240;--slate:#54617a;--line:#dde2ea;--bg:#fff;--bg-alt:#f4f6fa;
  --radius:8px;--maxw:1200px;
}
.ats-netlify-port *{box-sizing:border-box;margin:0;padding:0}
.ats-netlify-port html{scroll-behavior:smooth}
.ats-netlify-port body{font-family:'Montserrat',system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
:focus-visible{outline:3px solid var(--blue-2);outline-offset:2px}
h1,h2,h3,.arch{font-family:'Akira Expanded','Archivo',sans-serif;letter-spacing:-0.01em}
.arch{font-weight:800}

/* buttons */
.btn{border-radius:var(--radius);font-weight:800;letter-spacing:0.02em;display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:'Akira Expanded','Archivo';text-transform:uppercase;transition:transform .07s,background .15s,box-shadow .15s;font-size:14px}
.btn-red{background:var(--red);color:#fff;box-shadow:0 4px 0 var(--red-press);padding:0 22px;height:50px}
.btn-red:hover{background:var(--red-deep)}
.btn-red:active{transform:translateY(3px);box-shadow:0 1px 0 var(--red-press)}
.btn-red:disabled{background:#e6b8ba;box-shadow:0 4px 0 #d69ea1;cursor:not-allowed}
.btn-ghost{border:2px solid var(--brand);color:var(--brand);padding:0 22px;height:50px}
.btn-ghost:hover{background:var(--brand);color:#fff}
.btn-white{background:#fff;color:var(--brand);padding:0 22px;height:50px}
.btn-white:hover{background:#eef1f7}

/* promo */
.promo{background:var(--red);color:#fff;font-size:13px;font-weight:500}
.promo .wrap{display:flex;align-items:center;justify-content:center;gap:14px;height:38px;text-align:center;flex-wrap:wrap}
.promo b{font-weight:800}.promo .sep{opacity:.5}.promo a{text-decoration:underline;font-weight:700}

/* header — three bars */
header{position:sticky;top:0;z-index:40;background:#fff}
.hbar-brand{background:#fff;border-bottom:1px solid var(--line)}
.hbar-brand .wrap{display:flex;align-items:center;gap:20px;height:76px}
.logo{display:inline-flex;align-items:center}
.logo img{height:38px;width:auto;display:block}
.logo .a{color:var(--red)}
.brand-right{margin-left:auto;display:flex;align-items:center;gap:12px;position:relative}
.appt-btn{height:auto!important;min-height:46px;padding:7px 18px!important;line-height:1.15;text-align:center;font-size:12.5px}
.hbar-nav{background:#fff;border-bottom:1px solid var(--line)}
.mainnav{display:flex;gap:26px;height:50px;align-items:center;justify-content:center;overflow-x:auto}
.mainnav a{font-size:14px;font-weight:600;color:var(--ink);white-space:nowrap;position:relative;height:100%;display:flex;align-items:center}
.mainnav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:3px;background:var(--red);transition:right .18s}
.mainnav a:hover::after{right:0}
/* header inline garage: Selected Store + My Vehicle (screenshot-style) */
.hgarage{display:flex;align-items:stretch;border:1.5px solid var(--line);border-radius:10px;background:#fff;position:relative}
.hg-field{display:flex;align-items:center;gap:9px;padding:7px 14px;background:none;text-align:left;cursor:pointer;min-width:158px}
.hg-field .hg-ic{font-size:18px;line-height:1}
.hg-txt{display:flex;flex-direction:column;line-height:1.2}
.hg-txt small{font-size:9px;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;color:var(--brand);display:flex;align-items:center;gap:5px}
.hg-pen{color:var(--red);font-size:10px}
.hg-txt b{font-size:12.5px;font-weight:600;color:#9aa3b2}
.hg-field.set .hg-txt b{color:var(--ink);font-weight:700}
.hg-sep{width:1px;background:var(--line);margin:9px 0}
.hg-store select{border:none;background:none;font-family:'Montserrat';font-size:12.5px;font-weight:700;color:#9aa3b2;padding:0;margin-top:1px;cursor:pointer;max-width:150px;-webkit-appearance:none;appearance:none}
.hg-store.set select{color:var(--ink)}
.hg-store select:focus{outline:none}
.veh-pop{position:absolute;top:calc(100% + 12px);right:0;width:min(300px,calc(100vw - 32px));background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 26px 64px -20px rgba(0,0,0,.4);padding:16px;z-index:60;display:none}
.veh-pop.show{display:block}
.veh-pop .gp-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.veh-pop select{width:100%;height:42px;border:1.5px solid var(--line);border-radius:6px;padding:0 10px;font-size:14px;font-family:'Montserrat';color:var(--ink);background:#fff}
.veh-pop select:disabled{background:var(--bg-alt);color:#a7adba}
.nav-phone-ic{width:42px;height:42px;border:1.5px solid var(--line);border-radius:8px;display:grid;place-items:center;color:var(--brand);font-size:16px;flex:0 0 auto}
.nav-phone-ic:hover{border-color:var(--brand);background:var(--bg-alt)}
.garage-btn{display:flex;align-items:center;gap:9px;height:42px;padding:0 14px;border-radius:8px;font-weight:700;font-size:13px;font-family:'Montserrat';transition:all .15s;white-space:nowrap}
.garage-btn.empty{border:1.5px dashed var(--line);color:var(--slate);background:#fff}
.garage-btn.empty:hover{border-color:var(--brand);color:var(--brand)}
.garage-btn.set{background:var(--brand);color:#fff}
.garage-btn.set:hover{background:#0f2749}
.gc-ic{font-size:16px;line-height:1}
.gc-lines{display:flex;flex-direction:column;line-height:1.15;text-align:left}
.gc-lines b{font-size:13px;font-weight:700}
.gc-lines small{font-size:10px;opacity:.85;font-weight:500}
.gc-car{font-size:10px;opacity:.7}
.garage-pop{position:absolute;top:calc(100% + 12px);right:0;width:min(340px,calc(100vw - 32px));background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 26px 64px -20px rgba(0,0,0,.4);padding:18px;z-index:60;display:none}
.garage-pop.show{display:block}
.garage-pop h4{font-family:'Akira Expanded','Archivo';font-weight:800;font-size:13px;text-transform:uppercase;color:var(--brand);margin-bottom:13px}
.gp-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.garage-pop select,.garage-pop input{width:100%;height:42px;border:1.5px solid var(--line);border-radius:6px;padding:0 10px;font-size:14px;font-family:'Montserrat';color:var(--ink);background:#fff}
.garage-pop select:disabled{background:var(--bg-alt);color:#a7adba}
.gp-store{font-size:12px;color:var(--slate);margin:2px 0 11px;min-height:15px}.gp-store b{color:var(--brand)}
.garage-pop .btn-red{width:100%;height:46px}
.gp-book{display:block;text-align:center;margin-top:10px;font-size:12.5px;font-weight:700;color:var(--blue);cursor:pointer}.gp-book:hover{text-decoration:underline}

/* hero */
.hero{background:radial-gradient(1000px 460px at 90% 10%,#163461 0%,transparent 56%),linear-gradient(158deg,#0c1e3a,#0a1830);color:#fff;position:relative}
.hero::after{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--red)}
.hero .wrap{display:grid;grid-template-columns:1fr 0.82fr;gap:48px;align-items:center;padding:52px 24px 76px}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8fb0e6;margin-bottom:16px}
.eyebrow::before{content:"";width:24px;height:3px;background:var(--red)}
.hero h1{font-weight:800;font-size:clamp(34px,4.7vw,56px);line-height:1.02;text-transform:uppercase}
.hero h1 em{font-style:normal;color:#ff5259}
.hero-sub{font-size:16.5px;color:#c3ccdb;max-width:44ch;margin:16px 0 22px}
.trust-row{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:14px}
.trust-row .ti{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:#dbe3f2}
.trust-row .ti b{color:var(--red);font-family:'Akira Expanded','Archivo'}
.cities{font-size:12.5px;color:#7f92b3}.cities b{color:#a9bbd8;font-weight:600}

/* entry card */
.entry{background:#fff;border-radius:12px;padding:6px;color:var(--ink);box-shadow:0 30px 66px -22px rgba(0,0,0,.62)}
.entry-inner{padding:20px}
.entry-top{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.entry-top .badge{background:var(--red);color:#fff;font-size:10px;font-weight:800;letter-spacing:0.06em;padding:5px 9px;border-radius:4px;text-transform:uppercase}
.entry-top .t{font-family:'Akira Expanded','Archivo';font-weight:800;font-size:16px;color:var(--brand);text-transform:uppercase}
.tabs{display:flex;gap:6px;margin-bottom:15px;background:var(--bg-alt);padding:4px;border-radius:7px}
.tab{flex:1;padding:9px;font-size:13px;font-weight:700;color:var(--slate);border-radius:5px;text-align:center;transition:all .14s}
.tab.active{background:#fff;color:var(--brand);box-shadow:0 1px 4px rgba(0,0,0,.12)}
.pl-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.pl-row.three{grid-template-columns:1fr 1fr 1fr}
.field label{display:block;font-size:10px;letter-spacing:0.05em;text-transform:uppercase;color:var(--slate);font-weight:700;margin-bottom:5px}
.field select,.field input{width:100%;height:46px;border:1.5px solid var(--line);border-radius:var(--radius);padding:0 12px;font-size:14.5px;color:var(--ink);background:#fff;transition:border-color .15s}
.field select:focus,.field input:focus{border-color:var(--blue);outline:none}
.field select:disabled{background:var(--bg-alt);color:#a7adba;cursor:not-allowed}
.pane{display:none}.pane.active{display:block}
.entry .btn-red{width:100%;height:52px;margin-top:2px}
.entry-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;padding-top:13px;border-top:1px solid var(--line)}
.hint{font-size:12px;color:var(--slate);display:flex;align-items:center;gap:7px}.hint .dot{width:6px;height:6px;border-radius:50%;background:var(--red)}
.book-link{font-size:13px;font-weight:700;color:var(--blue);border-bottom:2px solid transparent}.book-link:hover{border-bottom-color:var(--blue)}
.store-stamp{margin-top:11px;background:var(--bg-alt);border:1px solid var(--line);border-left:4px solid var(--red);border-radius:5px;max-height:0;overflow:hidden;opacity:0;padding:0 14px;transition:max-height .35s,opacity .3s,padding .35s}
.store-stamp.show{max-height:90px;opacity:1;padding:11px 14px}
.ss-in{display:flex;align-items:center;gap:12px}
.ss-badge{font-size:9px;letter-spacing:0.08em;color:#fff;background:var(--brand);padding:4px 8px;border-radius:3px;font-weight:800;white-space:nowrap}
.ss-txt{font-size:13px;color:var(--ink)}.ss-txt b{color:var(--brand)}.ss-txt small{display:block;color:var(--slate);font-size:11px}
.ss-change{margin-left:auto;font-size:11.5px;color:var(--blue);font-weight:700;cursor:pointer;border-bottom:1px dotted var(--blue)}

/* exits */
.exits .wrap{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:-48px;position:relative;z-index:5;padding-bottom:56px}
.exit{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;display:flex;align-items:center;gap:17px;transition:transform .16s,box-shadow .16s;cursor:pointer;box-shadow:0 14px 32px -18px rgba(0,0,0,.28)}
.exit:hover{transform:translateY(-3px);box-shadow:0 22px 42px -20px rgba(0,0,0,.36)}
.exit .ic{width:52px;height:52px;flex:0 0 auto;border-radius:9px;display:grid;place-items:center;font-size:24px}
.exit.shop .ic{background:var(--brand);color:#fff}.exit.book .ic{background:var(--red);color:#fff}
.exit .lbl{font-size:10px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:var(--slate)}
.exit .h{font-family:'Akira Expanded','Archivo';font-weight:800;font-size:19px;text-transform:uppercase;color:var(--brand);margin-top:2px}
.exit p{font-size:12.5px;color:var(--slate);margin-top:2px}
.exit .go{margin-left:auto;font-size:23px;color:var(--red)}

/* section shell */
section.block{padding:66px 0}
.block.alt{background:var(--bg-alt)}
.block.dark{background:var(--brand);color:#fff;position:relative;overflow:hidden}
.sec-head{text-align:center;max-width:640px;margin:0 auto 36px}
.sec-eye{font-size:11.5px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.block.dark .sec-eye{color:#ff5259}
.sec-head h2{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,30px);text-transform:uppercase;color:var(--brand);line-height:1.12;letter-spacing:-0.01em}
.block.dark .sec-head h2{color:#fff}
.sec-head p{font-size:15px;color:var(--slate);margin-top:12px}
.block[style*="0e2444"] .sec-head p{color:#b7c4dc}
.block.dark .sec-head p{color:#b7c4dc}

/* category cards */
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.cat{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;transition:transform .16s,box-shadow .16s;cursor:pointer;display:flex;flex-direction:column}
.cat:hover{transform:translateY(-4px);box-shadow:0 22px 44px -22px rgba(0,0,0,.32)}
.cat__top{height:210px;display:grid;place-items:center;font-size:52px;position:relative;background:linear-gradient(150deg,#16305a,#0c1e3a);color:#fff}
.cat:nth-child(2) .cat__top{background:linear-gradient(150deg,#1b47a3,#13315f)}
.cat:nth-child(3) .cat__top{background:linear-gradient(150deg,#8f1015,#c51f28)}
.cat__body{padding:20px}
.cat__body h3{font-weight:800;font-size:20px;text-transform:uppercase;color:var(--brand)}
.cat__body p{font-size:13.5px;color:var(--slate);margin:6px 0 12px}
.cat__link{font-size:13px;font-weight:800;color:var(--red);font-family:'Akira Expanded','Archivo';text-transform:uppercase;letter-spacing:0.03em}

/* brands */
.brand-note{text-align:center;font-size:13px;color:var(--slate);margin:-18px auto 24px}.brand-note b{color:var(--brand)}
.chips{display:flex;flex-wrap:wrap;gap:11px;justify-content:center;max-width:900px;margin:0 auto}
.chip{background:#fff;border:1.5px solid var(--line);border-radius:40px;padding:11px 20px;font-weight:700;font-size:14px;color:var(--brand);transition:all .14s;display:flex;align-items:center;gap:9px}
.chip:hover{border-color:var(--brand);background:var(--brand);color:#fff}
.chip .plus{color:var(--red);font-weight:800}.chip:hover .plus{color:#fff}
.brand-all{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap}
.pill{padding:13px 26px;border-radius:40px;font-family:'Akira Expanded','Archivo';font-weight:800;font-size:14px;text-transform:uppercase}
.pill.red{background:var(--red);color:#fff}.pill.red:hover{background:var(--red-deep)}
.pill.outline{border:2px solid var(--brand);color:var(--brand)}.pill.outline:hover{background:var(--brand);color:#fff}

/* services */
.symptoms{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:26px}
.symptom{background:#fff;border:1px solid var(--line);border-radius:9px;padding:20px;text-align:left;display:flex;flex-direction:column;gap:7px;transition:all .15s;border-top:3px solid var(--brand)}
.symptom:hover{transform:translateY(-3px);box-shadow:0 16px 32px -20px rgba(0,0,0,.3);border-top-color:var(--red)}
.symptom .sy-q{font-family:'Akira Expanded','Archivo';font-weight:700;font-size:15.5px;color:var(--brand)}
.symptom .sy-s{font-size:12.5px;color:var(--slate)}
.symptom .sy-go{margin-top:auto;font-size:13px;font-weight:700;color:var(--red);padding-top:6px}
.center{text-align:center}

/* trust / why */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-bottom:44px}
.stat{text-align:center;position:relative}
.stat:not(:last-child)::after{content:"";position:absolute;right:-14px;top:12%;height:76%;width:1px;background:rgba(255,255,255,.15)}
.stat .n{font-family:'Akira Expanded','Archivo';font-weight:900;font-size:38px;color:#fff}.stat .n em{font-style:normal;color:#ff5259}
.stat .l{font-size:12.5px;color:#b7c4dc;margin-top:5px}
.guarantees{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.guar{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:20px;text-align:center}
.guar .gi{font-size:26px;margin-bottom:8px}
.guar h4{font-weight:800;font-size:14.5px;text-transform:uppercase;color:#fff}
.guar p{font-size:12px;color:#b7c4dc;margin-top:5px}
.review{max-width:680px;margin:0 auto 40px;text-align:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:26px}
.review .stars{color:#ffc233;font-size:20px;letter-spacing:2px}
.review .rq{font-size:17px;color:#eef2f9;margin:10px 0;font-style:italic}
.review .rw{font-size:12.5px;color:#9fb0cd;text-transform:uppercase;letter-spacing:0.06em}

/* offers */
.offers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.offer{border:1px solid var(--line);border-radius:11px;padding:24px;background:#fff;position:relative;overflow:hidden;transition:transform .16s,box-shadow .16s}
.offer:hover{transform:translateY(-3px);box-shadow:0 18px 38px -22px rgba(0,0,0,.3)}
.offer.feat{background:linear-gradient(155deg,#c51f28,#8f1015);color:#fff;border-color:transparent}
.offer .tag{font-size:10px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:var(--red)}
.offer.feat .tag{color:#ffd7d9}
.offer h3{font-weight:900;font-size:26px;text-transform:uppercase;margin:6px 0;color:var(--brand)}
.offer.feat h3{color:#fff}
.offer p{font-size:13px;color:var(--slate)}.offer.feat p{color:#ffe1e2}
.offer .ol{display:inline-block;margin-top:14px;font-family:'Akira Expanded','Archivo';font-weight:800;font-size:13px;text-transform:uppercase;color:var(--red)}
.offer.feat .ol{color:#fff}

/* locations */
.locs{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.loc{border:1px solid var(--line);border-radius:10px;padding:18px;background:#fff;transition:all .15s;cursor:pointer}
.loc:hover{border-color:var(--brand);box-shadow:0 14px 30px -20px rgba(0,0,0,.3);transform:translateY(-2px)}
.loc .city{font-family:'Akira Expanded','Archivo';font-weight:800;font-size:16px;color:var(--brand)}
.loc .addr{font-size:12.5px;color:var(--slate);margin-top:5px;line-height:1.5}
.loc .hrs{font-size:11.5px;color:var(--slate);margin-top:8px;padding-top:8px;border-top:1px solid var(--line)}
.loc .go{margin-top:8px;font-size:12px;font-weight:800;color:var(--red);font-family:'Akira Expanded','Archivo';text-transform:uppercase}

/* financing band */
.fin{background:linear-gradient(150deg,#13315f,#0c1e3a);border-radius:14px;color:#fff;padding:36px;display:flex;align-items:center;gap:30px;flex-wrap:wrap;position:relative;overflow:hidden}
.fin__l{flex:1;min-width:280px}
.fin__l .fe{font-size:11px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:#ff5259;margin-bottom:8px}
.fin__l h3{font-weight:800;font-size:26px;text-transform:uppercase}
.fin__l p{font-size:14px;color:#c3ccdb;margin-top:6px;max-width:52ch}

/* faq */
.faq{max-width:760px;margin:0 auto}
.qa{border-bottom:1px solid var(--line)}
.qa button{width:100%;text-align:left;padding:20px 0;display:flex;justify-content:space-between;align-items:center;gap:16px;font-family:'Akira Expanded','Archivo';font-weight:700;font-size:16px;color:var(--brand)}
.qa .ic{color:var(--red);font-size:22px;flex:0 0 auto;transition:transform .2s}
.qa.open .ic{transform:rotate(45deg)}
.qa .a{max-height:0;overflow:hidden;transition:max-height .28s ease;font-size:14.5px;color:var(--slate)}
.qa.open .a{max-height:300px}
.qa .a p{padding-bottom:20px}

/* final cta */
.final{background:radial-gradient(800px 300px at 50% 0%,#163461,transparent 60%),var(--brand);color:#fff;text-align:center;padding:64px 24px;position:relative;overflow:hidden}
.final h2{font-weight:900;font-size:clamp(28px,3.6vw,42px);text-transform:uppercase}
.final p{font-size:16px;color:#c3ccdb;margin:12px auto 24px;max-width:52ch}
.final .cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* footer */
footer{background:var(--blue);color:#fff;position:relative}
footer::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--red)}
footer .wrap{padding:48px 24px 28px}
.fcols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1.2fr;gap:28px;margin-bottom:30px}
