/* Brand directory */
function renderBrands(filter){
    var f=(filter||'').trim().toLowerCase();
    var grid=document.getElementById('brandGrid');
    var wrap=document.getElementById('brandRailWrap');
    var dots=document.getElementById('brandDots');
    var count=document.getElementById('brandCount');
    var tile=function(b){
      return '<div class="brand-tile" role="listitem">'
        +(BRAND_LOGOS[b]?'<img src="'+BRAND_LOGOS[b]+'" alt="'+b+' wheels" loading="lazy" decoding="async">'
                        :'<span class="bt-word">'+b+'</span>')+'</div>';};
    if(!f){                         /* no search: the rail is the directory */
      wrap.hidden=false; dots.hidden=false; grid.hidden=true; grid.innerHTML='';
      if(count) count.textContent=BRANDS.length+' brands';
      if(window.__brandRailPaint) window.__brandRailPaint();
      return;
    }
    var hits=BRANDS.filter(function(b){return b.toLowerCase().indexOf(f)>=0;});
    wrap.hidden=true; dots.hidden=true; grid.hidden=false;
    grid.setAttribute('role','list');
    grid.innerHTML=hits.length?hits.map(tile).join('')
      :'<p class="brand-none">No brand matches \u201c'+f.replace(/</g,'&lt;')+'\u201d.</p>';
    if(count) count.textContent=hits.length+' of '+BRANDS.length+' brands';
  }
function filterBrands(){renderBrands(document.getElementById('brandFilter').value);}
renderBrands('');

/* Brand rail — same component as the homepage. Built once; the filter swaps it
   for the results grid and back. */
(function(){
  var rail=document.getElementById('brandRail'); if(!rail) return;
  rail.innerHTML=BRANDS.map(function(b){
    var logo=BRAND_LOGOS[b];
    return '<div class="blogo" role="listitem" aria-label="'+b+' wheels">'
      +(logo?'<img class="blogo-img" src="'+logo+'" alt="'+b+' wheels" loading="lazy" decoding="async">'
            :'<span class="bword">'+b+'</span>')+'</div>';}).join('');
  var dots=document.getElementById('brandDots'), page=0, mode='';
  var prev=document.getElementById('brandPrev'), next=document.getElementById('brandNext');
  function pages(){return Math.max(1,Math.ceil(rail.scrollWidth/rail.clientWidth));}
  function paint(){
    if(rail.clientWidth===0) return;           /* hidden while filtering */
    var n=pages(); page=Math.round(rail.scrollLeft/rail.clientWidth);
    var want=n>8?'bar':'dots';
    if(mode!==want||(want==='dots'&&dots.children.length!==n)){
      mode=want;
      dots.className=want==='bar'?'brand-prog':'brand-dots';
      if(want==='bar'){dots.innerHTML='<span class="bprog-thumb"></span>';}
      else{
        dots.innerHTML=Array.from({length:n},function(_,i){
          return '<button class="bdot" type="button" aria-label="Brand page '+(i+1)+' of '+n+'"></button>';}).join('');
        Array.prototype.forEach.call(dots.children,function(d,i){
          d.onclick=function(){rail.scrollTo({left:i*rail.clientWidth,behavior:'smooth'});};});
      }
    }
    if(mode==='bar'){
