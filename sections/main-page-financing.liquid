/* The shared stylesheet declares
     @media(max-width:860px){.fin-steps,.how-use,.use-grid,.related-links{grid-template-columns:1fr}}
   but those rules are not winning against the base declarations on this build,
   leaving multi-column grids overflowing a 375px viewport. Re-declared here,
   from the last stylesheet in the document. */
@media(max-width:860px){
  .fin-steps,.how-use,.use-grid,.related-links,.ben-grid{grid-template-columns:1fr!important}
}
