<style>
.ats-offers{--brand:#13315f;--red:#c51f28;--ink:#122240;--slate:#66738b;--line:#dde2ea;--bg:#f4f6fa;font-family:'Montserrat',system-ui,sans-serif;color:var(--ink);background:#fff}.ats-offers *{box-sizing:border-box}.ats-offers .wrap{max-width:1200px;margin:0 auto;padding:0 24px}.ats-offers .promo{background:var(--red);color:#fff;font-size:13px;font-weight:800}.ats-offers .promo .wrap{height:38px;display:flex;align-items:center;justify-content:center;gap:14px;max-width:none}.ats-offers .promo a{color:#fff;text-decoration:underline;font-weight:900}.ats-offers header{background:#fff}.ats-offers .hbar-brand{border-bottom:1px solid var(--line)}.ats-offers .hbar-brand .wrap{height:76px;display:flex;align-items:center;gap:20px;max-width:1200px}.ats-offers .logo img{height:40px;width:auto;display:block}.ats-offers .brand-right{margin-left:auto;display:flex;align-items:center;gap:12px}.ats-offers .hgarage{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}.ats-offers .hg-field{border:0;background:#fff;display:flex;align-items:center;padding:8px 14px;text-align:left}.ats-offers .hg-sep{width:1px;background:var(--line);margin:8px 0}.ats-offers .hg-txt{display:flex;flex-direction:column}.ats-offers .hg-txt small{font-size:9px;font-weight:900;text-transform:uppercase;color:var(--brand)}.ats-offers .hg-txt b,.ats-offers .hg-txt select{font-size:12px;color:#8b95a8;font-weight:800;border:0;background:transparent}.ats-offers .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;font-weight:900;text-transform:uppercase;text-decoration:none;border:0;cursor:pointer}.ats-offers .btn-red{background:var(--red);color:#fff;box-shadow:0 4px 0 #86121a}.ats-offers .appt-btn{min-height:50px;padding:8px 18px;font-size:12px;line-height:1.05;text-align:center}.ats-offers .hbar-nav{border-bottom:1px solid var(--line)}.ats-offers .mainnav{height:50px;display:flex;justify-content:center;align-items:center;gap:26px;overflow:auto}.ats-offers .mainnav a{font-size:14px;font-weight:800;color:#081a33;text-decoration:none;white-space:nowrap}.ats-offers .hero{background:#f4f6fa;text-align:center;padding:58px 0 48px}.ats-offers .eyebrow{display:block;color:var(--red);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.16em;margin-bottom:12px}.ats-offers h1,.ats-offers h2{font-family:'Akira Expanded','Archivo',sans-serif;text-transform:uppercase;line-height:1.08;margin:0}.ats-offers h1{font-size:clamp(30px,3.7vw,50px);color:var(--brand)}.ats-offers .hero p{max-width:760px;margin:16px auto 0;color:var(--slate);line-height:1.65}.ats-offers .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:50px 0 64px}.ats-offers .coupon{border:1px solid var(--line);border-radius:16px;background:#fff;text-decoration:none;color:inherit;overflow:hidden;box-shadow:0 18px 42px -34px rgba(0,0,0,.45);position:relative}.ats-offers .coupon:before,.ats-offers .coupon:after{content:"";position:absolute;top:50%;width:22px;height:22px;border-radius:50%;background:#fff;border:1px solid var(--line)}.ats-offers .coupon:before{left:-12px}.ats-offers .coupon:after{right:-12px}.ats-offers .coupon-img{height:185px;background:linear-gradient(135deg,#0e2444,#13315f);overflow:hidden}.ats-offers .coupon-img img{width:100%;height:100%;object-fit:cover;display:block}.ats-offers .coupon-body{padding:24px}.ats-offers .save{display:inline-flex;background:#fde8ea;color:var(--red);border-radius:999px;padding:6px 10px;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}.ats-offers .coupon h2{font-size:24px;color:var(--brand);margin-bottom:8px}.ats-offers .coupon p{font-size:14px;color:var(--slate);line-height:1.6;margin:0}.ats-offers .code{border:1px dashed var(--red);color:var(--red);border-radius:8px;padding:9px 11px;font-weight:900;font-size:13px;display:inline-flex;margin-top:16px}.ats-offers .meta{font-size:12px;color:#7a879d;font-weight:800;margin-top:12px}.ats-offers .cta{margin-top:18px;color:var(--red);font-weight:900;text-transform:uppercase;font-size:13px}.ats-offers .empty{grid-column:1/-1;text-align:center;background:var(--bg);border:1px dashed #b3bed3;border-radius:14px;padding:34px;color:var(--slate)}@media(max-width:980px){.ats-offers .grid{grid-template-columns:1fr 1fr}.ats-offers .hgarage{display:none}}@media(max-width:680px){.ats-offers .grid{grid-template-columns:1fr;padding:36px 0}.ats-offers .hero{padding:40px 0}.ats-offers .mainnav{justify-content:flex-start}.ats-offers .logo img{height:32px}.ats-offers .appt-btn{display:none}}
</style>
<div class="ats-offers">
  {% render 'ats-offer-header' %}
  <section class="hero"><div class="wrap"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p></div></section>
  <main class="wrap"><div class="grid">
    {% assign cms_coupons = shop.metaobjects.ats_coupon.values %}
    {% if cms_coupons.size > 0 %}
      {% for coupon in cms_coupons %}
        {% assign coupon_title = coupon.title.value | default: coupon.title %}
        {% assign coupon_label = coupon.label.value | default: 'Coupon' %}
        {% assign coupon_desc = coupon.description.value | default: coupon.description %}
        {% assign coupon_code = coupon.code.value | default: coupon.code %}
        {% assign coupon_expiry = coupon.expiry.value | default: coupon.expiry %}
        {% assign coupon_cta = coupon.cta.value | default: 'View coupon' %}
        {% assign coupon_link = coupon.link.value | default: coupon.link | default: coupon.system.url %}
        <a class="coupon" href="{{ coupon_link }}">
          <div class="coupon-img">{% if coupon.image.value != blank %}<img src="{{ coupon.image.value | image_url: width: 900 }}" alt="{{ coupon_title | escape }}" loading="lazy">{% endif %}</div>
          <div class="coupon-body"><span class="save">{{ coupon_label }}</span><h2>{{ coupon_title }}</h2><p>{{ coupon_desc }}</p>{% if coupon_code != blank %}<span class="code">{{ coupon_code }}</span>{% endif %}{% if coupon_expiry != blank %}<div class="meta">Valid through {{ coupon_expiry }}</div>{% endif %}<div class="cta">{{ coupon_cta }} →</div></div>
        </a>
      {% endfor %}
    {% else %}
    {% for block in section.blocks %}
      <a class="coupon" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <div class="coupon-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}</div>
        <div class="coupon-body"><span class="save">{{ block.settings.label }}</span><h2>{{ block.settings.title }}</h2><p>{{ block.settings.description }}</p>{% if block.settings.code != blank %}<span class="code">{{ block.settings.code }}</span>{% endif %}{% if block.settings.expiry != blank %}<div class="meta">Valid through {{ block.settings.expiry }}</div>{% endif %}<div class="cta">{{ block.settings.cta }} →</div></div>
      </a>
    {% else %}<div class="empty">Add coupon cards in Theme Editor.</div>{% endfor %}
    {% endif %}
  </div></main>
</div>
{% schema %}
{"name":"Coupons - CMS","settings":[{"type":"select","id":"source","label":"Content source","default":"blocks","options":[{"value":"blocks","label":"Theme Editor blocks"},{"value":"metaobjects","label":"Shopify Metaobjects: ats_coupon"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Coupons"},{"type":"text","id":"heading","label":"Heading","default":"Printable tire and service coupons"},{"type":"textarea","id":"intro","label":"Intro","default":"Show these coupons on your phone or print them before visiting your American Tire Stores location."}],"blocks":[{"type":"coupon","name":"Coupon card","settings":[{"type":"text","id":"label","label":"Label","default":"Coupon"},{"type":"text","id":"title","label":"Title","default":"$50 Off Brake Service"},{"type":"textarea","id":"description","label":"Description","default":"Save on eligible brake service at American Tire Stores."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"code","label":"Coupon code","default":"BRAKE50"},{"type":"text","id":"expiry","label":"Expiry","default":"December 31, 2026"},{"type":"url","id":"link","label":"Detail page link"},{"type":"text","id":"cta","label":"CTA","default":"View coupon"}]}],"presets":[{"name":"Coupons - CMS","blocks":[{"type":"coupon"},{"type":"coupon","settings":{"title":"Oil Change Special","description":"Save on eligible oil change services.","code":"OILCHANGE"}},{"type":"coupon","settings":{"title":"Alignment Offer","description":"Save on wheel alignment service.","code":"ALIGNMENT"}}]}]}
{% endschema %}
