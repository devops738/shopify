{% assign cms_coupons = shop.metaobjects.ats_coupon.values %}
{% assign coupon_count = cms_coupons.size %}
{% capture coupon_count_label %}{{ coupon_count }} printable coupon{% unless coupon_count == 1 %}s{% endunless %}{% endcapture %}
<style>
  .ats-coupons{--navy:#102e5c;--red:#d21f2b;--ink:#102b56;--muted:#687897;--line:#dbe2ec;--pale:#f4f6fa;background:#fff;color:var(--ink);font-family:Montserrat,Arial,sans-serif}.ats-coupons *{box-sizing:border-box}.ats-coupons a{text-decoration:none}.ats-coupons .w{width:min(1140px,100%);padding:0 24px;margin:auto}.ats-coupons h1,.ats-coupons h2,.ats-coupons h3{font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-weight:800;text-transform:uppercase;line-height:1.12}.ats-coupons .hero{padding:60px 0 52px;background:var(--pale)}.ats-coupons .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}.ats-coupons .eyebrow{color:var(--red);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.ats-coupons h1{font-size:clamp(31px,4vw,48px);margin:10px 0 14px;color:var(--ink)}.ats-coupons .intro{max-width:560px;margin:0;color:var(--muted);line-height:1.65}.ats-coupons .hero-actions{display:flex;justify-content:flex-start;gap:12px;flex-wrap:wrap;margin-top:24px}.ats-coupons .hero-image{aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:var(--navy)}.ats-coupons .hero-image img{width:100%;height:100%;display:block;object-fit:cover}.ats-coupons .button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border-radius:8px;border:0;background:var(--red);box-shadow:0 4px 0 #a4141d;color:#fff;font-family:'Akira Expanded',Montserrat,Arial,sans-serif;font-size:14px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;transition:transform .07s,background .15s,box-shadow .15s}.ats-coupons .button:hover{background:#b81822}.ats-coupons .button:active{transform:translateY(3px);box-shadow:0 1px 0 #a4141d}.ats-coupons .button.outline{border:2px solid var(--navy);background:transparent;color:var(--navy);box-shadow:none}.ats-coupons .button.outline:hover{background:var(--navy);color:#fff}.ats-coupons .group{padding:65px 0}.ats-coupons .group.alt{background:var(--pale)}.ats-coupons .head{text-align:center;max-width:700px;margin:0 auto 28px}.ats-coupons .head h2{font-size:clamp(24px,3vw,34px);margin:9px 0 0}.ats-coupons .head p{margin:10px 0 0;color:var(--muted);line-height:1.6}.ats-coupons .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.ats-coupons .coupon{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#fff;color:var(--ink);box-shadow:0 16px 36px -30px rgba(8,31,67,.35);transition:transform .15s,box-shadow .15s}.ats-coupons .coupon:hover{transform:translateY(-2px);box-shadow:0 20px 40px -28px rgba(8,31,67,.4)}.ats-coupons .coupon-img{display:flex;justify-content:center;align-items:center;min-height:40px;background:#fff;overflow:hidden}.ats-coupons .coupon-img img{display:block;width:100%;max-width:558px;height:auto;object-fit:contain}.ats-coupons .coupon-body{display:flex;flex:1;flex-direction:column;padding:18px 21px 20px}.ats-coupons .coupon h3{margin:0 0 8px;font-size:16px;color:var(--navy)}.ats-coupons .coupon p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.55}.ats-coupons .terms{margin-top:12px;color:#8b641d;font-size:11px;line-height:1.5}.ats-coupons .cta{margin-top:auto;padding-top:14px;color:var(--red);font-size:12px;font-weight:900;text-transform:uppercase}.ats-coupons .empty{grid-column:1/-1;padding:30px;border:1px dashed #b7c3d8;border-radius:12px;text-align:center;color:var(--muted)}.ats-coupons .how{padding:65px 0;background:var(--navy);color:#fff}.ats-coupons .how .eyebrow{color:#ff988e}.ats-coupons .how h2{font-size:clamp(24px,3vw,34px);margin:9px 0 27px}.ats-coupons .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.ats-coupons .how-card{border:1px solid rgba(255,255,255,.22);border-radius:12px;padding:24px;background:rgba(255,255,255,.05)}.ats-coupons .how-number{display:grid;place-items:center;width:32px;height:32px;margin-bottom:14px;border-radius:50%;background:var(--red);font-weight:900}.ats-coupons .how-card h3{font-size:15px;margin:0 0 8px}.ats-coupons .how-card p{margin:0;color:#d4dff0;font-size:14px;line-height:1.6}@media(max-width:700px){.ats-coupons .w{padding:0 18px}.ats-coupons .hero-grid,.ats-coupons .grid,.ats-coupons .how-grid{grid-template-columns:1fr}.ats-coupons .group,.ats-coupons .how{padding:46px 0}.ats-coupons .hero{padding:42px 0}.ats-coupons .hero-actions .button{width:100%}}
</style>
<main class="ats-coupons">
  {% render 'ats-offer-header' %}
  <section class="hero"><div class="w hero-grid"><div><div class="eyebrow">{{ coupon_count_label }}</div><h1>{{ section.settings.heading }}</h1><p class="intro">{{ section.settings.intro }}</p><div class="hero-actions"><a class="button" href="#coupons">See all coupons ↓</a><a class="button outline" href="/pages/services">Book a service</a></div></div><div class="hero-image">{% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1000 }}" alt="Customer receiving auto service support at American Tire Stores" loading="eager">{% else %}<img src="https://americantirestores.com/cdn/shop/files/ats-coupons-hero.jpg" alt="Customer receiving auto service support at American Tire Stores" loading="eager">{% endif %}</div></div></section>
  {% assign groups = 'oil|Oil change coupons|Oil Change Service Coupons|Current savings on conventional, synthetic blend, and full synthetic oil changes.;service|Service coupons|Brake, Alignment & More|Save on brakes, alignment, fluid exchange, batteries, and more.;complimentary|Free services & more|Complimentary Services & Tire Deals|Free services, everyday auto care savings, and current tire deals.' | split: ';' %}
  <div id="coupons">{% for group_item in groups %}{% assign group = group_item | split: '|' %}<section class="group{% if forloop.index == 2 %} alt{% endif %}"><div class="w"><div class="head"><div class="eyebrow">{{ group[1] }}</div><h2>{{ group[2] }}</h2><p>{{ group[3] }}</p></div><div class="grid">{% assign found = false %}{% for coupon in cms_coupons %}{% assign coupon_group = coupon.coupon_group.value | default: coupon.label.value | downcase %}{% assign coupon_title = coupon.title.value | default: coupon.title %}{% assign matches = false %}{% if group[0] == 'oil' %}{% if coupon_group contains 'oil' %}{% assign matches = true %}{% endif %}{% elsif group[0] == 'complimentary' %}{% if coupon_group contains 'complimentary' or coupon_group contains 'free' or coupon_group contains 'tire deal' %}{% assign matches = true %}{% endif %}{% else %}{% unless coupon_group contains 'oil' or coupon_group contains 'complimentary' or coupon_group contains 'free' or coupon_group contains 'tire deal' %}{% assign matches = true %}{% endunless %}{% endif %}{% if matches %}{% assign found = true %}<a class="coupon" href="{{ coupon.system.url }}"><div class="coupon-img">{% if coupon.image.value != blank %}<img src="{{ coupon.image.value | image_url: width: 558 }}" alt="{{ coupon_title | escape }}" loading="lazy">{% endif %}</div><div class="coupon-body"><h3>{{ coupon_title }}</h3><p>{{ coupon.description.value }}</p>{% if coupon.terms.value != blank %}<div class="terms">{{ coupon.terms.value | strip_html | truncate: 180 }}</div>{% endif %}<div class="cta">View coupon →</div></div></a>{% endif %}{% endfor %}{% unless found %}<div class="empty">Add an active ATS Coupon and set its Coupon group to <b>{{ group[2] }}</b>.</div>{% endunless %}</div></div></section>{% endfor %}</div>
  <section class="how"><div class="w"><div class="head"><div class="eyebrow">How it works</div><h2>How to use a coupon</h2></div><div class="how-grid"><article class="how-card"><div class="how-number">1</div><h3>Choose a coupon</h3><p>Find the offer for the service you need. Keep it on your phone or print it.</p></article><article class="how-card"><div class="how-number">2</div><h3>Book or walk in</h3><p>Book your appointment online or visit any of our nine locations. Mention the coupon when you check in.</p></article><article class="how-card"><div class="how-number">3</div><h3>Save at checkout</h3><p>The discount is confirmed before work begins. One coupon per service and customer.</p></article></div><p style="text-align:center;margin:25px 0 0"><a class="button outline" href="/pages/locations">Find one of our 9 locations →</a></p></div></section>
</main>
{% schema %}
{"name":"Coupons - CMS","settings":[{"type":"text","id":"heading","label":"Heading","default":"Auto Service Coupons"},{"type":"textarea","id":"intro","label":"Intro","default":"Printable coupons for oil changes, brake service, alignments, battery and more, accepted at American Tire Stores locations across Southern California."},{"type":"image_picker","id":"hero_image","label":"Hero image"}],"presets":[{"name":"Coupons - CMS"}]}
{% endschema %}
