{% liquid
  assign detail_title = metaobject.title.value | default: section.settings.title
  assign detail_label = metaobject.label.value | default: section.settings.label
  assign detail_description = metaobject.description.value | default: section.settings.description
  assign detail_image = metaobject.image.value | default: section.settings.image
  assign detail_offer = metaobject.offer_value.value | default: section.settings.offer_value
  assign detail_code = metaobject.code.value
  assign detail_expiry = metaobject.expiry.value | default: section.settings.expiry
  assign detail_locations = metaobject.locations.value | default: section.settings.locations
  assign detail_body = metaobject.body.value | default: section.settings.body
  assign detail_terms = metaobject.terms.value | default: section.settings.terms
  assign detail_primary_link = metaobject.primary_link.value | default: metaobject.link.value | default: section.settings.primary_link
  assign detail_primary_cta = metaobject.primary_cta.value | default: metaobject.cta.value | default: section.settings.primary_cta
%}

<style>
  .ats-promo-detail{--navy:#0c1e3a;--brand:#13315f;--red:#c51f28;--red-deep:#a5171f;--ink:#122240;--slate:#54617a;--line:#dde2ea;--alt:#f4f6fa;font-family:Montserrat,Arial,sans-serif;color:var(--ink);background:#fff}.ats-promo-detail *{box-sizing:border-box}.ats-promo-detail .wrap{width:min(1200px,100%);margin:auto;padding:0 24px}.ats-promo-detail h1,.ats-promo-detail h2,.ats-promo-detail h3{font-family:'Akira Expanded',Archivo,Montserrat,sans-serif;letter-spacing:-.01em;text-transform:uppercase}.ats-promo-detail a{text-decoration:none}.ats-promo-detail .crumbs{border-bottom:1px solid var(--line);background:#fff;padding:14px 0;color:var(--slate);font-size:13px}.ats-promo-detail .crumbs a{color:var(--brand);font-weight:700}.ats-promo-detail .crumbs span{padding:0 8px;color:#9ba7b9}.ats-promo-detail .pd-hero{padding:58px 0 52px;color:#fff;background:linear-gradient(155deg,#0c1e3a,#13315f);position:relative;overflow:hidden}.ats-promo-detail .pd-hero:after{content:"";position:absolute;width:560px;height:560px;border:90px solid rgba(255,255,255,.025);border-radius:50%;right:-230px;top:-280px}.ats-promo-detail .pd-top{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:end;position:relative;z-index:1}.ats-promo-detail .pd-badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.ats-promo-detail .pd-badge{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border:1px solid rgba(255,255,255,.25);border-radius:4px;background:rgba(255,255,255,.08);color:#d6e0f2}.ats-promo-detail .pd-badge.kind{background:var(--red);border-color:var(--red);color:#fff}.ats-promo-detail h1{margin:0;font-size:clamp(29px,3.3vw,43px);line-height:1.1;color:#fff}.ats-promo-detail .lead{margin:0;color:#d4ddec;font-size:16px;line-height:1.65}.ats-promo-detail .hero-image{position:relative;z-index:1;margin-top:28px;border-radius:12px;overflow:hidden;aspect-ratio:2.65/1;background:repeating-linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.07) 12px,rgba(255,255,255,.03) 12px,rgba(255,255,255,.03) 24px);border:1px solid rgba(255,255,255,.16)}.ats-promo-detail .hero-image img{display:block;width:100%;height:100%;object-fit:cover}.ats-promo-detail .hero-image:empty:before{content:'Promotion image';display:grid;place-items:center;height:100%;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9fb2ce}.ats-promo-detail .actionbar{position:relative;z-index:1;display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:24px}.ats-promo-detail .code{padding:10px 15px;border:2px dashed rgba(255,255,255,.42);border-radius:9px;background:rgba(255,255,255,.07);min-width:188px}.ats-promo-detail .code small{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#b9cae5;font-weight:800}.ats-promo-detail .code b{font:700 20px/1.3 ui-monospace,SFMono-Regular,Consolas,monospace;color:#fff;letter-spacing:.06em}.ats-promo-detail .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 21px;border-radius:8px;font-family:'Akira Expanded',Archivo,Montserrat,sans-serif;font-size:12px;font-weight:800;text-transform:uppercase}.ats-promo-detail .button.red{background:var(--red);color:#fff;box-shadow:0 4px 0 #86121a}.ats-promo-detail .button.red:hover{background:var(--red-deep)}.ats-promo-detail .button.white{border:2px solid #fff;color:#fff}.ats-promo-detail .valid{margin-left:auto;color:#c1cee2;font-size:12px;text-align:right}.ats-promo-detail .valid b{display:block;color:#fff;font-size:14px}.ats-promo-detail .facts{display:grid;grid-template-columns:repeat(4,1fr);position:relative;z-index:2;margin-top:-28px;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 18px 42px -30px rgba(12,30,58,.65)}.ats-promo-detail .fact{padding:20px 22px;border-right:1px solid var(--line)}.ats-promo-detail .fact:last-child{border:0}.ats-promo-detail .fact small{display:block;margin-bottom:7px;color:var(--slate);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.ats-promo-detail .fact b{font-size:14px;line-height:1.4}.ats-promo-detail .block{padding:62px 0}.ats-promo-detail .alt{background:var(--alt)}.ats-promo-detail .section-eye{margin-bottom:9px;color:var(--red);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.ats-promo-detail .section-head{margin-bottom:26px}.ats-promo-detail .section-head h2{margin:0 0 9px;color:var(--brand);font-size:27px}.ats-promo-detail .section-head p{margin:0;color:var(--slate);font-size:15px}.ats-promo-detail .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.ats-promo-detail .step{border:1px solid var(--line);border-top:3px solid var(--red);border-radius:12px;background:#fff;padding:26px 23px}.ats-promo-detail .number{display:grid;place-items:center;width:30px;height:30px;margin-bottom:14px;border-radius:50%;background:var(--red);color:#fff;font-family:Archivo,Arial,sans-serif;font-size:13px;font-weight:800}.ats-promo-detail .step h3,.ats-promo-detail .terms h3{margin:0 0 8px;color:var(--brand);font-size:14px}.ats-promo-detail .step p,.ats-promo-detail .prose,.ats-promo-detail .terms p{margin:0;color:var(--slate);font-size:14px;line-height:1.65}.ats-promo-detail .split{display:grid;grid-template-columns:1.35fr .65fr;gap:34px}.ats-promo-detail .prose h2,.ats-promo-detail .prose h3{color:var(--brand)}.ats-promo-detail .terms{border:1px solid var(--line);border-radius:12px;background:#fff;padding:24px}.ats-promo-detail .store-cta{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:27px 30px;border-radius:12px;background:#fff;border:1px solid var(--line)}.ats-promo-detail .store-cta h2{margin:0 0 7px;color:var(--brand);font-size:22px}.ats-promo-detail .store-cta p{margin:0;color:var(--slate);font-size:14px}.ats-promo-detail .final{padding:62px 0;text-align:center;color:#fff;background:linear-gradient(155deg,#0c1e3a,#13315f)}.ats-promo-detail .final h2{margin:0 0 11px;font-size:29px}.ats-promo-detail .final p{max-width:680px;margin:0 auto 24px;color:#d4ddec}.ats-promo-detail .final-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}@media(max-width:860px){.ats-promo-detail .pd-top,.ats-promo-detail .split{grid-template-columns:1fr;gap:22px}.ats-promo-detail .facts{grid-template-columns:repeat(2,1fr);margin-top:-16px}.ats-promo-detail .fact:nth-child(2){border-right:0}.ats-promo-detail .fact:nth-child(-n+2){border-bottom:1px solid var(--line)}.ats-promo-detail .steps{grid-template-columns:1fr}.ats-promo-detail .valid{margin-left:0;text-align:left;width:100%}}@media(max-width:560px){.ats-promo-detail .wrap{padding:0 18px}.ats-promo-detail .pd-hero{padding:42px 0}.ats-promo-detail .facts{grid-template-columns:1fr}.ats-promo-detail .fact{border-right:0;border-bottom:1px solid var(--line)}.ats-promo-detail .fact:last-child{border-bottom:0}.ats-promo-detail .store-cta{display:block;padding:24px}.ats-promo-detail .store-cta .button{margin-top:18px;width:100%}}
</style>

<div class="ats-promo-detail">
  {% render 'ats-offer-header' %}
  <div class="crumbs"><div class="wrap"><a href="/">Home</a><span>&rsaquo;</span><a href="/pages/promotions">Promotions</a><span>&rsaquo;</span><b>{{ detail_title }}</b></div></div>
  <section class="pd-hero"><div class="wrap">
    <div class="pd-top"><div><div class="pd-badges"><span class="pd-badge">{{ detail_label }}</span><span class="pd-badge kind">{% if detail_code != blank %}Promo code{% else %}Limited-time offer{% endif %}</span>{% if detail_expiry != blank %}<span class="pd-badge">Ends {{ detail_expiry }}</span>{% endif %}</div><h1>{{ detail_title }}</h1></div><p class="lead">{{ detail_description }}</p></div>
    <div class="hero-image">{% if detail_image != blank %}<img src="{{ detail_image | image_url: width: 1800 }}" alt="{{ detail_title | escape }}" loading="lazy">{% endif %}</div>
    <div class="actionbar">{% if detail_code != blank %}<div class="code"><small>Promo code</small><b>{{ detail_code }}</b></div>{% elsif detail_offer != blank %}<div class="code"><small>Offer</small><b>{{ detail_offer }}</b></div>{% endif %}<div>{% if detail_primary_link != blank %}<a class="button red" href="{{ detail_primary_link }}">{{ detail_primary_cta }} &rarr;</a>{% endif %}</div>{% if detail_expiry != blank %}<div class="valid">Offer valid through<b>{{ detail_expiry }}</b></div>{% endif %}</div>
  </div></section>
  <section class="alt" style="padding:0 0 8px"><div class="wrap"><div class="facts"><div class="fact"><small>Offer ends</small><b>{{ detail_expiry }}</b></div><div class="fact"><small>Valid at</small><b>{{ detail_locations }}</b></div><div class="fact"><small>Your savings</small><b>{{ detail_offer }}</b></div><div class="fact"><small>How to redeem</small><b>Online or in store</b></div></div></div></section>
  <section class="block"><div class="wrap"><div class="section-head"><div class="section-eye">How to use it</div><h2>Three ways to redeem</h2><p>Use this promotion online or bring it to your nearest American Tire Stores location.</p></div><div class="steps"><article class="step"><div class="number">1</div><h3>Choose your fit</h3><p>Shop eligible tires or wheels and confirm the best fit for your vehicle.</p></article><article class="step"><div class="number">2</div><h3>Use this offer</h3><p>Apply the promotion online or show this page to an advisor in store.</p></article><article class="step"><div class="number">3</div><h3>Save locally</h3><p>Your local store will confirm eligibility, availability, and savings.</p></article></div></div></section>
  <section class="block alt"><div class="wrap"><div class="split"><div class="prose">{{ detail_body }}</div><aside class="terms"><h3>Terms &amp; conditions</h3><p>{{ detail_terms | newline_to_br }}</p></aside></div></div></section>
  <section class="block"><div class="wrap"><div class="store-cta"><div><div class="section-eye">Local service</div><h2>Find this offer at a store near you</h2><p>Choose a location for local availability, service, and installation.</p></div><a class="button red" href="/pages/locations">Find a store &rarr;</a></div></div></section>
  <section class="final"><div class="wrap"><h2>Ready to save?</h2><p>{{ detail_description }}</p><div class="final-actions">{% if detail_primary_link != blank %}<a class="button red" href="{{ detail_primary_link }}">{{ detail_primary_cta }} &rarr;</a>{% endif %}<a class="button white" href="/pages/promotions">All promotions</a></div></div></section>
</div>

{% schema %}
{"name":"Promotion detail - editable","settings":[{"type":"text","id":"label","label":"Label","default":"Promotion"},{"type":"text","id":"title","label":"Title","default":"Buy 3, Get 1 Free on Most Tires"},{"type":"textarea","id":"description","label":"Description","default":"Save on eligible tire purchases at American Tire Stores."},{"type":"image_picker","id":"image","label":"Promotion image"},{"type":"text","id":"offer_value","label":"Offer value","default":"Buy 3, Get 1 Free"},{"type":"text","id":"expiry","label":"Expiry","default":"December 31, 2026"},{"type":"text","id":"locations","label":"Locations","default":"All locations"},{"type":"richtext","id":"body","label":"Body copy","default":"<p>Choose your nearest American Tire Stores location, select your vehicle, and shop eligible tires with local pricing and availability.</p>"},{"type":"textarea","id":"terms","label":"Terms","default":"Offer subject to availability. See store for complete details."},{"type":"url","id":"primary_link","label":"Primary CTA link"},{"type":"text","id":"primary_cta","label":"Primary CTA","default":"Shop eligible tires"}],"presets":[{"name":"Promotion detail - editable"}]}
{% endschema %}
