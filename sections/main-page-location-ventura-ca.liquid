.brand-line{display:flex;flex-wrap:wrap;gap:10px}
.brand-chip{background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:9px 16px;font-family:'Akira Expanded','Archivo';font-weight:700;font-size:13px;color:var(--brand)}
