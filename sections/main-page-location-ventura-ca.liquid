function ensureTc(cb,fail){
 if(window.TCWidget){cb();return;}
 const src='https://app.tireconnect.ca/js/widget.js';
 let s=document.querySelector('script[src="'+src+'"]');
 if(!s){s=document.createElement('script');s.src=src;s.async=true;s.onerror=fail||function(){};document.head.appendChild(s);}
 s.addEventListener('load',cb,{once:true});
}
function normTxt(v){return String(v||'').trim().toLowerCase();}
function selectWidgetValue(select,value){
 if(!select||!value)return false;
 const want=normTxt(value);
 const opt=[...select.options].find(o=>normTxt(o.value)===want||normTxt(o.textContent)===want||normTxt(o.textContent).includes(want));
 if(!opt)return false;
 select.value=opt.value;
 select.dispatchEvent(new Event('input',{bubbles:true}));
 select.dispatchEvent(new Event('change',{bubbles:true}));
 return true;
}
function widgetSelects(id){
 const root=$(id);if(!root)return [];
 let selects=[...root.querySelectorAll('select')];
 if(!selects.length){try{const f=root.querySelector('iframe');if(f&&f.contentDocument)selects=[...f.contentDocument.querySelectorAll('select')];}catch(e){}}
 return selects;
}
function syncTcWidget(id){
 let tries=0;
 const tick=()=>{
  tries++;
  const selects=widgetSelects(id);
  if(st.year){
   const ys=selects.find(s=>[...s.options].some(o=>normTxt(o.value)===normTxt(st.year)||normTxt(o.textContent)===normTxt(st.year)));
   if(ys)selectWidgetValue(ys,st.year);
  }
  if(st.make){
   setTimeout(()=>{const ms=widgetSelects(id).find(s=>[...s.options].some(o=>normTxt(o.value)===normTxt(st.make)||normTxt(o.textContent)===normTxt(st.make)));if(ms)selectWidgetValue(ms,st.make);},220);
  }
  if(st.model){
   setTimeout(()=>{const ds=widgetSelects(id).find(s=>[...s.options].some(o=>normTxt(o.value)===normTxt(st.model)||normTxt(o.textContent)===normTxt(st.model)));if(ds)selectWidgetValue(ds,st.model);},520);
  }
  if(tries<28)setTimeout(tick,420);
 };
 setTimeout(tick,300);
}
function mountWidgetShell(kind){
 const wrap=$('ats-location-widget');
 if(!wrap)return null;
 const id=kind==='book'?'ats-appointment-widget':'ats-shop-widget';
 wrap.innerHTML='<div id="'+id+'" class="tc-widget-target"></div>';
 return $(id);
}

function trimTcSpace(id){
 const root=$(id), shell=$('ats-location-widget'), panel=$('ats-widget-panel');
 const squeeze=()=>{
  [root,shell,panel].filter(Boolean).forEach(el=>{el.style.minHeight='0';el.style.height='auto';});
  if(!root)return;
  root.querySelectorAll('iframe').forEach(f=>{f.style.minHeight='0';f.style.height='auto';});
  [root].concat([...root.children]).forEach(el=>{
   const h=el.getBoundingClientRect().height, sh=el.scrollHeight;
   if(h>700&&sh>120&&h>sh+160){el.style.minHeight='0';el.style.height=sh+'px';}
  });
 };
 squeeze();
 [120,360,800,1400,2400].forEach(t=>setTimeout(squeeze,t));
 if(root&&window.ResizeObserver){try{new ResizeObserver(squeeze).observe(root);}catch(e){}}
}

function loadShop(){
