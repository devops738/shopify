.loc-svc-foot{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:6px}
.loc-book{font-family:'Akira Expanded','Archivo';font-weight:800;font-size:12px;text-transform:uppercase;color:#fff;background:var(--red);padding:8px 15px;border-radius:6px;transition:background .15s}
