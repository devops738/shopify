const HOURS={0:null,1:[8,18],2:[8,18],3:[8,18],4:[8,18],5:[8,18],6:[8,17]}; // 0=Sun; mirror schema_hours
function fmtH(x){const ap=x>=12?'pm':'am';let hh=x%12;if(hh===0)hh=12;return hh+':00'+ap;}
function renderOpen(){const el=$('openBadge');if(!el)return;const now=new Date();const d=now.getDay();const t=HOURS[d];const cur=now.getHours()+now.getMinutes()/60;let open=false,txt;
 if(t&&cur>=t[0]&&cur<t[1]){open=true;txt='Open now \u00b7 closes '+fmtH(t[1]);}
 else if(t&&cur<t[0]){txt='Closed \u00b7 opens '+fmtH(t[0]);}
 else{txt='Closed today';}
 el.className='open-badge '+(open?'open':'closed');el.innerHTML='<span class="dot"></span>'+txt;
 document.querySelectorAll('.hours tr').forEach(tr=>{const ds=(tr.dataset.d||'').split(',');tr.classList.toggle('today',ds.includes(String(d)));});}
renderOpen();
