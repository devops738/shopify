function valuesFromPayload(payload){
 if(Array.isArray(payload))return payload;
 if(payload&&Array.isArray(payload.values))return payload.values;
 if(payload&&payload.data&&Array.isArray(payload.data.values))return payload.data.values;
 if(payload&&Array.isArray(payload.data))return payload.data;
 if(payload&&Array.isArray(payload.years))return payload.years;
 if(payload&&Array.isArray(payload.makes))return payload.makes;
 if(payload&&Array.isArray(payload.models))return payload.models;
 return [];
}
function normalizeVehicleValues(values){
 return values.map(v=>{
  if(typeof v==='string'||typeof v==='number')return String(v);
  return String(v.name||v.value||v.label||v.year||v.make||v.model||v.trim||'');
 }).filter(Boolean);
}
function vehicleApi(endpoint,params={}){
 const url=new URL(`https://wl.tireconnect.ca/api/v2/vehicle/${endpoint}`);
 url.searchParams.set('key',TC_API_KEY);
 Object.entries(params).forEach(([k,v])=>{if(v)url.searchParams.set(k,v);});
 return fetch(url.toString()).then(r=>r.ok?r.json():Promise.reject(new Error('Vehicle API failed'))).then(valuesFromPayload).then(normalizeVehicleValues);
}
function setLoading(sel,label){if(!sel)return;sel.disabled=true;sel.innerHTML=`<option value="" disabled selected hidden>${label}</option>`;}
async function initVehicleDropdowns(){
 setLoading($('year'),'Year');setLoading($('hyear'),'Year');
 try{
  const years=await vehicleApi('years');
  if(years.length){VEH={};years.forEach(y=>VEH[y]={});fillOpts($('year'),years,'Year');fillOpts($('hyear'),years,'Year');reflectState();return;}
 }catch(e){}
 VEH=JSON.parse(JSON.stringify(FALLBACK_VEH));
 fillOpts($('year'),Object.keys(VEH),'Year');fillOpts($('hyear'),Object.keys(VEH),'Year');reflectState();
}
async function loadMakesForYear(year){
 if(!year)return [];
 if(VEH[year]&&Object.keys(VEH[year]).length)return Object.keys(VEH[year]);
 setLoading($('make'),'Make');setLoading($('hmake'),'Make');
 try{
  const makes=await vehicleApi('makes',{year});
  VEH[year]=VEH[year]||{};makes.forEach(m=>{VEH[year][m]=VEH[year][m]||[];});
  return makes;
 }catch(e){VEH[year]=VEH[year]||{};return Object.keys(VEH[year]);}
}
async function loadModelsForMake(year,make){
 if(!year||!make)return [];
 if(VEH[year]&&Array.isArray(VEH[year][make])&&VEH[year][make].length)return VEH[year][make];
 setLoading($('model'),'Model');setLoading($('hmodel'),'Model');
 try{
  const models=await vehicleApi('models',{year,make});
  VEH[year]=VEH[year]||{};VEH[year][make]=models;return models;
 }catch(e){VEH[year]=VEH[year]||{};VEH[year][make]=VEH[year][make]||[];return VEH[year][make];}
}
const $=id=>document.getElementById(id);
let st={mode:"vehicle",year:"",make:"",model:"",w:"",r:"",d:"",store:null};
function fillOpts(sel,arr,ph){if(!sel)return;sel.innerHTML='<option value="" disabled selected hidden>'+ph+'</option>';arr.forEach(v=>sel.add(new Option(v,v)));sel.disabled=!arr.length;}
function storeLabel(s){return (s.name.split('— ')[1]||s.name);}
function fillStores(sel){if(!sel)return;const ph=sel.id==='hstore'?'Choose…':'Select a store';sel.innerHTML='<option value="">'+ph+'</option>';STORES.forEach((s,i)=>sel.add(new Option(storeLabel(s),i)));}
initVehicleDropdowns();
fillStores($('store'));fillStores($('hstore'));

/* one source of truth: st -> reflected into hero form AND header fields */
function syncSel(yId,mkId,mdId){const y=$(yId),mk=$(mkId),md=$(mdId);if(!y)return;
 y.value=st.year||'';
 fillOpts(mk,st.year&&VEH[st.year]?Object.keys(VEH[st.year]):[],'Make');mk.disabled=!st.year;mk.value=st.make||'';
 fillOpts(md,(st.year&&st.make&&VEH[st.year])?VEH[st.year][st.make]||[]:[],'Model');md.disabled=!(st.year&&st.make);md.value=st.model||'';}
function reflectState(){
 const si=st.store?String(STORES.indexOf(st.store)):'';
 if($('store'))$('store').value=si; if($('hstore'))$('hstore').value=si;
 if($('storeStamp')){if(st.store){$('stName').textContent=st.store.name;$('stAddr').textContent=st.store.addr+' · '+st.store.city+', CA';$('storeStamp').classList.add('show');}else $('storeStamp').classList.remove('show');}
 const sf=$('storeField');if(sf)sf.classList.toggle('set',!!st.store);
 syncSel('year','make','model');syncSel('hyear','hmake','hmodel');
 const vv=$('vehVal');if(vv)vv.textContent=(st.make&&st.model)?((st.year?st.year+' ':'')+st.make+' '+st.model):'Not selected…';
 const vf=$('vehField');if(vf)vf.classList.toggle('set',!!(st.make&&st.model));
 checkReadyOnly();}
