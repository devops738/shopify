/* brands by logo */
.brand-logos{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;max-width:960px;margin:0 auto}
.blogo{aspect-ratio:170/70;background:#fff;border:1.5px solid var(--line);border-radius:8px;display:grid;place-items:center;text-align:center;cursor:pointer;transition:all .15s;padding:6px}
