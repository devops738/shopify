function persistTcContext(){
 try{
  const payload={name:STORE.name,city:STORE.city,address:(STORE.addr||'').replace('*',''),addr:(STORE.addr||'').replace('*',''),zip:STORE.zip,phone:STORE.ph,id:STORE.id,location_id:STORE.id,locationId:STORE.id};
