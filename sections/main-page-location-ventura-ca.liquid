   ['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'].forEach(k=>{localStorage.setItem(k,JSON.stringify(vehiclePayload));sessionStorage.setItem(k,JSON.stringify(vehiclePayload));});
  }
 }catch(e){}
}
function tcCfg(container){
 persistTcContext();
 const locId=String(STORE.id);
 const cfg={apikey:TC_API_KEY,apiKey:TC_API_KEY,api_key:TC_API_KEY,key:TC_API_KEY,container:container,locationId:locId,location_id:locId,location:locId,locationID:locId,location_lock:true,locationLock:true,locationSelector:'lock',locale:'en_US',searchParams:{location_id:locId,locationId:locId}};
 if(st.year&&st.make&&st.model){
  cfg.year=st.year;cfg.make=st.make;cfg.model=st.model;
  cfg.vehicleYear=st.year;cfg.vehicleMake=st.make;cfg.vehicleModel=st.model;
