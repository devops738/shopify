 m.innerHTML='<div class="tc-mount__ph"><span class="tc-mount__label">Loading tire search...</span><span class="tc-mount__sub">Locked to '+STORE.city+' with your selected vehicle when available.</span></div>';
 ATS_SHOP_READY=false;ATS_BOOK_READY=false;
 ensureTc(function(){
  if(!window.TCWidget||typeof window.TCWidget.init!=='function'){m.innerHTML='<div class="tc-mount__ph"><span class="tc-mount__label">Tire search unavailable</span><span class="tc-mount__sub">Please refresh and try again.</span></div>';return;}
  m.innerHTML='';
  window.TCWidget.init(tcCfg('ats-shop-widget'));
  ATS_SHOP_READY=true;
  syncTcWidget('ats-shop-widget');
  trimTcSpace('ats-shop-widget');
 },function(){m.innerHTML='<div class="tc-mount__ph"><span class="tc-mount__label">Tire search unavailable</span><span class="tc-mount__sub">Please refresh and try again.</span></div>';});
}
