.facts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:22px}
.fact{display:flex;flex-direction:column;gap:3px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.fact .fk{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:var(--brand)}
.fact .fv{font-size:13.5px;color:var(--ink)}
