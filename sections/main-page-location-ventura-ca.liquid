@media(max-width:600px){.facts{grid-template-columns:1fr}}
@media(max-width:980px){.loc-hero__grid,.hd-grid{grid-template-columns:1fr}.shopbook{grid-template-columns:1fr}.loc-svc-grid,.features,.reviews,.other-locs{grid-template-columns:1fr 1fr}}
