.tpl-note b{background:#e6c65a;color:#4a3800;padding:2px 7px;border-radius:4px;margin-right:8px;font-size:10px;letter-spacing:.05em}
.tpl-note code{background:rgba(0,0,0,.06);padding:1px 5px;border-radius:3px;font-size:11px}
.sec-head--left{text-align:left;margin:0 0 22px;max-width:none}
.btn-line{background:#fff;border:1.5px solid var(--line);color:var(--brand)}.btn-line:hover{border-color:var(--brand)}
