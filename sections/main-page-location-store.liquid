<style>
.ats-store-page{font-family:'Montserrat',system-ui,sans-serif;color:#122240;background:#fff}
.ats-store-page .wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.ats-store-hero{padding:48px 0 30px;background:#fff}.ats-store-hero__grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(360px,.85fr);gap:62px;align-items:start}.ats-store-kicker{margin:0 0 17px;color:#86aceb;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.ats-store-kicker:before{content:"";display:inline-block;width:23px;height:3px;background:#d21f2a;margin:0 11px 3px 0}.ats-store-hero h1{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:900;font-size:clamp(28px,4vw,42px);line-height:1.12;text-transform:uppercase;margin:0 0 17px;color:#13315f}.ats-store-hero p{color:#54617a;font-size:16px;line-height:1.58;max-width:680px;margin:0}.ats-store-meta{list-style:none;padding:0;margin:18px 0 20px;color:#243858;font-size:14px;line-height:1.65}.ats-store-meta li{margin:5px 0}.ats-store-meta li:first-child:before{content:"●";color:#e43b69;margin-right:13px;font-size:13px}.ats-store-meta li:last-child:before{content:"◷";color:#65728b;margin-right:11px;font-size:17px}.ats-store-actions{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:0}.ats-btn{min-height:50px;display:inline-flex;align-items:center;justify-content:center;font-family:'Akira Expanded','Archivo',sans-serif;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.03em;padding:12px;border:2px solid #13315f;border-radius:8px;text-decoration:none}.ats-btn.red{background:#d21f2a;border-color:#d21f2a;color:#fff}.ats-btn.ghost{background:#fff;color:#13315f}.ats-btn.call{color:#d21f2a;border-color:#d21f2a}.ats-store-hours{overflow:hidden;border:1px solid #d8e0eb;border-radius:16px;background:#fff;box-shadow:0 14px 28px rgba(17,37,72,.07)}.ats-store-hours img{display:block;width:100%;height:278px;object-fit:cover}.ats-store-hours__body{padding:20px}.ats-store-open{display:inline-flex;padding:9px 14px;border-radius:18px;background:#fbe7e9;color:#d21f2a;font-size:13px;font-weight:800;margin-bottom:14px}.ats-store-hours__row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #dde2ea;color:#4d5d78;font-size:14px}.ats-store-hours__row b{color:#13315f}.ats-store-directions{display:inline-block;color:#d21f2a;text-decoration:none;font-size:12px;font-weight:800;text-transform:uppercase;margin-top:19px}
.ats-store-body{padding:56px 0}
.ats-store-widget{padding:48px 0 58px;background:linear-gradient(165deg,#0e2444,#13315f);color:#fff}.ats-store-widget__head{text-align:center;max-width:660px;margin:0 auto 20px}.ats-store-widget__head p{color:#b9c9e5;font-size:13px;line-height:1.55;margin:0}.ats-store-widget__head h2{font-family:'Akira Expanded','Archivo',sans-serif!important;font-size:clamp(21px,2.8vw,31px);line-height:1.1;text-transform:uppercase;margin:0 0 10px}.ats-store-widget__tabs{max-width:580px;margin:0 auto 12px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.ats-store-widget__tabs button{min-height:43px;border:1px solid rgba(255,255,255,.42);border-radius:7px;background:rgba(255,255,255,.1);color:#fff;font:800 11px Montserrat,sans-serif;text-transform:uppercase;cursor:pointer}.ats-store-widget__tabs button.active{background:#fff;color:#13315f}.ats-store-widget__panel{max-width:1080px;margin:auto;padding:17px 24px 24px;border-radius:10px;background:#fff;color:#54617a;box-shadow:0 20px 50px -28px rgba(0,0,0,.65)}.ats-store-widget__lead{margin:0 0 12px;font-size:12px;line-height:1.5}.ats-store-widget__target{min-height:220px;border:1.5px dashed #b3bed3;border-radius:9px;background:linear-gradient(135deg,#f4f6fa,#e7ecf4);display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}.ats-store-widget__target iframe{width:100%;border:0}.ats-store-widget__loading{font-size:13px;font-weight:700;color:#13315f}.ats-store-widget__loading small{display:block;color:#64718a;font-weight:400;margin-top:8px}
.ats-store-body h2{font-family:'Akira Expanded','Archivo',sans-serif;font-weight:900;font-size:26px;text-transform:uppercase;color:#13315f;margin:0 0 12px}
.ats-store-services{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px}
.ats-store-service{border:1px solid #dde2ea;border-radius:12px;padding:18px;background:#f4f6fa;font-weight:700;color:#122240}
@media(max-width:800px){.ats-store-hero__grid,.ats-store-services{grid-template-columns:1fr}.ats-store-hero{padding:38px 0}.ats-store-hours{max-width:560px}.ats-store-hours img{height:auto}.ats-store-actions{grid-template-columns:1fr}.ats-store-page .wrap{padding:0 18px}}

/* Mockup typography pass: Montserrat UI + Akira display headings */
body,.promo,.mainnav a,.hg-field,.hg-store select,.veh-pop select,.garage-btn,.garage-pop select,.garage-pop input,.btn,.tc-tab,.tc-panel__lead,.loc-cta .btn,.store-card,.nap,.open-badge,.hours,.loc-svc,.feat,.other-loc,.brand-chip,.qa button,.footer,.tc-mount__sub{font-family:'Montserrat',system-ui,sans-serif!important}
h1,h2,h3,.arch,.hero h1,.loc-hero h1,.sec-head h2,.svc-intro h1,.pricing h2,.quiz__h{font-family:'Akira Expanded','Archivo',sans-serif!important;letter-spacing:.005em!important}
.tc-tab,.btn,.loc-book,.store-card__dir,.other-loc .go,.brand-chip,.qa button{font-family:'Montserrat',system-ui,sans-serif!important;font-weight:800!important}
section.block:has(#shopbook-section) h2{font-family:'Akira Expanded','Archivo',sans-serif!important;letter-spacing:.005em!important}

</style>
{% render 'ats-offer-header' %}
<div class="ats-store-page">
  <section class="ats-store-hero"><div class="wrap"><div class="ats-store-hero__grid"><div><p class="ats-store-kicker" id="atsStoreKicker">Locations</p><h1 id="atsStoreTitle">American Tire Stores Location</h1><p id="atsStoreIntro">Shop tires, wheels, packages, and auto services at your selected American Tire Stores location.</p><ul class="ats-store-meta"><li id="atsStoreAddr">Select a store from the Locations page.</li><li>Mon–Fri 8am–6pm · Sat 8am–5pm · Sun closed</li></ul><div class="ats-store-actions"><a class="ats-btn red" id="atsStoreTires" href="/pages/tire-search">Shop tires →</a><a class="ats-btn call" id="atsStoreCall" href="tel:+18056443330">Call</a><a class="ats-btn ghost" id="atsStoreBook" href="/pages/services">Book a service</a><a class="ats-btn ghost" id="atsStoreDirections" href="#">Get directions</a></div></div><aside class="ats-store-hours"><img id="atsStoreImage" src="{{ 'netlify-locations-05-5746055301668a88.jpg' | asset_url }}" alt="American Tire Stores storefront"><div class="ats-store-hours__body"><span class="ats-store-open">● Closed today</span><div class="ats-store-hours__row"><b>Mon–Fri</b><b>8:00am – 6:00pm</b></div><div class="ats-store-hours__row"><span>Saturday</span><span>8:00am – 5:00pm</span></div><div class="ats-store-hours__row"><span>Sunday</span><span>Closed</span></div><a class="ats-store-directions" id="atsStoreDirectionsCard" href="#">● Get directions →</a></div></aside></div></div></section>
  <section class="ats-store-widget"><div class="wrap"><div class="ats-store-widget__head"><h2 id="atsStoreWidgetTitle">Get rolling at American Tire Stores</h2><p>Choose your service or tires. TireConnect keeps your search and appointment request tied to this location.</p></div><div class="ats-store-widget__tabs"><button type="button" class="active" data-ats-tc="book">Book a service</button><button type="button" data-ats-tc="shop">Shop tires &amp; wheels</button></div><div class="ats-store-widget__panel"><p class="ats-store-widget__lead" id="atsStoreWidgetLead"><b>Request an appointment.</b> Select a service, vehicle, and preferred time — the shop confirms.</p><div class="ats-store-widget__target" id="atsStoreWidgetTarget"><span class="ats-store-widget__loading">Loading appointment request form...<small>Choose service, vehicle, and a preferred date and time.</small></span></div></div></div></section>
  <section class="ats-store-body"><div class="wrap">
    <h2>Services available here</h2>
    <p style="color:#54617a;line-height:1.7;max-width:760px">Shop tires, wheels, packages, and auto service at this American Tire Stores location. The selected store is saved for TireConnect and service booking.</p>
    <div class="ats-store-services">
      <div class="ats-store-service">Tires & installation</div>
      <div class="ats-store-service">Wheels & packages</div>
      <div class="ats-store-service">Oil change</div>
      <div class="ats-store-service">Brake service</div>
      <div class="ats-store-service">Wheel alignment</div>
      <div class="ats-store-service">Battery & TPMS service</div>
    </div>
  </div></section>
  {% render 'ats-location-brand-directory' %}
</div>
{% render 'ats-site-footer' %}
<script>
const ATS_STORES=[
 {name:"American Tire Stores — Ventura",city:"Ventura",slug:"location-ventura-ca",addr:"5100 Telegraph Rd, Ventura, CA 93003",zip:93003,id:52820,ph:"(805) 644-3330"},
 {name:"American Tire Stores — Thousand Oaks",city:"Thousand Oaks",slug:"location-thousand-oaks-ca",addr:"621 E Thousand Oaks Blvd, Thousand Oaks, CA 91360",zip:91360,id:52819,ph:"(805) 379-1910"},
 {name:"American Tire Stores — Valencia",city:"Valencia",region:"Ventura County",slug:"location-valencia-ca",addr:"23510 Valencia Blvd, Unit A, Valencia, CA 91355",zip:91355,id:52819,ph:"(661) 596-1444",img:"{{ 'netlify-locations-05-5746055301668a88.jpg' | asset_url }}",intro:"American Tire Stores on Valencia Boulevard is the Conejo Valley's local tire shop and auto service destination — tires, wheels, and full-service auto repair from certified technicians right off Highway 101 and Highway 23, minutes from Westlake Village, Agoura Hills, and Newbury Park. Shop tires and wheels that fit your vehicle, or book a service appointment, with an upfront quote before any work begins."},
 {name:"American Tire Stores — Hollywood",city:"Hollywood",region:"Los Angeles County",slug:"location-hollywood-ca",addr:"1174 N Western Ave, Los Angeles, CA 90029",zip:90029,id:61758,ph:"(323) 372-9372",img:"{{ 'netlify-locations-06-582faf17016f2ac3.jpg' | asset_url }}",intro:"American Tire Stores in Hollywood is your local tire shop and auto service destination. Shop tires and wheels that fit your vehicle, or book certified service with an upfront quote before any work begins."},
 {name:"American Tire & Service — Los Angeles",city:"Los Angeles",slug:"location-los-angeles-ca",addr:"1174 N Western Ave, Los Angeles, CA 90029",zip:90029,id:61758,ph:"(323) 372-9372"},
 {name:"American Tire Stores — Glendale",city:"Glendale",slug:"location-glendale-ca",addr:"737 S Glendale Ave, Glendale, CA 91205",zip:91205,id:52816,ph:"(818) 243-3191"},
 {name:"American Tire Stores — Glendale II",city:"Glendale II",slug:"location-glendale-ii-ca",addr:"1130 S Central Ave, Glendale, CA 91204",zip:91204,id:52818,ph:"(818) 547-2010"},
 {name:"American Tire Stores — Bellflower",city:"Bellflower",slug:"location-bellflower-ca",addr:"9509 Alondra Blvd, Bellflower, CA 90706",zip:90706,id:52814,ph:"(562) 804-4737"},
 {name:"American Tire Stores — Costa Mesa",city:"Costa Mesa",region:"Los Angeles County",slug:"location-costa-mesa-ca",addr:"2049 Harbor Blvd, Costa Mesa, CA 92627",zip:92627,id:52814,ph:"(949) 802-6419",img:"{{ 'netlify-locations-13-eafa51160dc4abe4.jpg' | asset_url }}",intro:"American Tire Stores on Harbor Boulevard is Costa Mesa's local tire shop and auto service destination — tires, wheels, and full-service auto repair from certified technicians who know the 91, the 605, and the roads Costa Mesa drivers use every day. Shop tires and wheels that fit your vehicle, or book a service appointment, with an upfront quote before any work begins."},
 {name:"American Tire Stores — Cathedral City",city:"Cathedral City",slug:"location-cathedral-city-ca",addr:"68406 E Palm Canyon Dr, Cathedral City, CA 92234",zip:92234,id:52815,ph:"(760) 469-9510"}
];
(function(){
 const handle='{{ page.handle }}';
 const store=ATS_STORES.find(s=>s.slug===handle)||ATS_STORES.find(s=>location.pathname.includes(s.slug));
 if(!store)return;
 document.getElementById('atsStoreTitle').textContent='Tires & Auto Service in '+store.city+', CA';
 document.getElementById('atsStoreKicker').textContent='Locations · '+(store.region||'Southern California');
 document.getElementById('atsStoreIntro').textContent=store.intro||('Shop tires, wheels, packages, and auto service at our '+store.city+' location.');
 document.getElementById('atsStoreAddr').textContent=store.addr;
 document.getElementById('atsStoreCall').textContent='☎ Call '+store.ph;
 document.getElementById('atsStoreCall').href='tel:'+store.ph.replace(/[^0-9+]/g,'');
 document.getElementById('atsStoreImage').src=store.img||document.getElementById('atsStoreImage').src;
 document.getElementById('atsStoreImage').alt=store.name+' storefront';
 const directions='https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(store.addr);
 document.getElementById('atsStoreDirections').href=directions;
 document.getElementById('atsStoreDirectionsCard').href=directions;
 const params='?location_id='+encodeURIComponent(store.id)+'&locationId='+encodeURIComponent(store.id);
 document.getElementById('atsStoreBook').href='/pages/services'+params;
 document.getElementById('atsStoreTires').href='/pages/tire-search'+params;
 try{
  const payload={name:store.name,city:store.city,address:store.addr,addr:store.addr,zip:store.zip,phone:store.ph,id:store.id,location_id:store.id,locationId:store.id};
  localStorage.setItem('atsTireConnectStore',JSON.stringify(payload));
  sessionStorage.setItem('atsTireConnectStore',JSON.stringify(payload));
  ['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(store.id));sessionStorage.setItem(k,String(store.id));});
 }catch(e){}
 const widgetTarget=document.getElementById('atsStoreWidgetTarget');
 const widgetLead=document.getElementById('atsStoreWidgetLead');
 const widgetTitle=document.getElementById('atsStoreWidgetTitle');
 const tcKey='c097aed9ad8c441bfff05ae020ca53f0';
 function showWidget(kind){
  document.querySelectorAll('[data-ats-tc]').forEach(button=>button.classList.toggle('active',button.dataset.atsTc===kind));
  widgetTitle.textContent=(kind==='shop'?'Shop tires and wheels at ':'Get rolling at American Tire Stores in ')+store.city;
  widgetLead.innerHTML=kind==='shop'?'<b>Shop tires that fit.</b> Search by vehicle or tire size with this store selected.':'<b>Request an appointment.</b> Select a service, vehicle, and preferred time — the shop confirms.';
  widgetTarget.innerHTML='<span class="ats-store-widget__loading">Loading '+(kind==='shop'?'tire search':'appointment request form')+'...<small>Locked to '+store.city+'.</small></span>';
  const mountId='ats-location-'+kind+'-widget';
  widgetTarget.innerHTML='<div id="'+mountId+'"></div>';
  const init=()=>{
    if(!window.TCWidget){widgetTarget.innerHTML='<span class="ats-store-widget__loading">Please refresh to load TireConnect.</span>';return;}
    const config={apikey:tcKey,apiKey:tcKey,api_key:tcKey,key:tcKey,container:mountId,locationId:String(store.id),location_id:String(store.id),location_lock:true,locationLock:true,locale:'en_US',searchParams:{location_id:String(store.id),locationId:String(store.id)}};
    if(kind==='shop'&&typeof window.TCWidget.init==='function')window.TCWidget.init(config);
    else if(kind==='book'&&typeof window.TCWidget.initServices==='function')window.TCWidget.initServices(config);
    else widgetTarget.innerHTML='<span class="ats-store-widget__loading">TireConnect is temporarily unavailable. Please refresh and try again.</span>';
  };
  if(window.TCWidget)init();else{let script=document.querySelector('script[src="https://app.tireconnect.ca/js/widget.js"]');if(!script){script=document.createElement('script');script.src='https://app.tireconnect.ca/js/widget.js';script.async=true;document.head.appendChild(script);}script.addEventListener('load',init,{once:true});script.addEventListener('error',()=>{widgetTarget.innerHTML='<span class="ats-store-widget__loading">TireConnect is temporarily unavailable. Please refresh and try again.</span>';},{once:true});}
 }
 document.querySelectorAll('[data-ats-tc]').forEach(button=>button.addEventListener('click',()=>showWidget(button.dataset.atsTc)));
 showWidget('book');
})();
</script>
