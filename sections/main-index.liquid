function valuesFromPayload(payload){
  if(Array.isArray(payload))return payload;
  if(payload&&Array.isArray(payload.values))return payload.values;
  if(payload&&payload.data&&Array.isArray(payload.data.values))return payload.data.values;
  if(payload&&Array.isArray(payload.data))return payload.data;
  if(payload&&Array.isArray(payload.years))return payload.years;
  if(payload&&Array.isArray(payload.makes))return payload.makes;
  if(payload&&Array.isArray(payload.models))return payload.models;
  return [];
}
function normalizeVehicleValues(values){
  return values.map(v=>{
    if(typeof v==='string'||typeof v==='number')return String(v);
    return String(v.name||v.value||v.label||v.year||v.make||v.model||v.trim||'');
  }).filter(Boolean);
}
function vehicleApi(endpoint,params={}){
  const url=new URL(`https://wl.tireconnect.ca/api/v2/vehicle/${endpoint}`);
  url.searchParams.set('key',TC_API_KEY);
  Object.entries(params).forEach(([k,v])=>{if(v)url.searchParams.set(k,v);});
  return fetch(url.toString()).then(r=>r.ok?r.json():Promise.reject(new Error('Vehicle API failed'))).then(valuesFromPayload).then(normalizeVehicleValues);
}
function setLoading(sel,label){if(!sel)return;sel.disabled=true;sel.innerHTML=`<option value="" disabled selected hidden>${label}</option>`;}
async function initVehicleDropdowns(){
  setLoading($('year'),'Select');setLoading($('hyear'),'Select');
  try{
    const years=await vehicleApi('years');
    if(years.length){VEH={};years.forEach(y=>VEH[y]={});fillOpts($('year'),years,'Select');fillOpts($('hyear'),years,'Select');reflectState();return;}
  }catch(e){}
  VEH=JSON.parse(JSON.stringify(FALLBACK_VEH));
  fillOpts($('year'),Object.keys(VEH),'Select');fillOpts($('hyear'),Object.keys(VEH),'Select');reflectState();
}
async function loadMakesForYear(year){
  if(!year)return [];
  if(VEH[year]&&Object.keys(VEH[year]).length)return Object.keys(VEH[year]);
  setLoading($('make'),'Select');setLoading($('hmake'),'Select');
  try{
    const makes=await vehicleApi('makes',{year});
    VEH[year]=VEH[year]||{};
    makes.forEach(m=>{VEH[year][m]=VEH[year][m]||[];});
    return makes;
  }catch(e){
    VEH[year]=VEH[year]||{};
    return Object.keys(VEH[year]);
  }
}
async function loadModelsForMake(year,make){
  if(!year||!make)return [];
  if(VEH[year]&&Array.isArray(VEH[year][make])&&VEH[year][make].length)return VEH[year][make];
  setLoading($('model'),'Select');setLoading($('hmodel'),'Select');
  try{
    const models=await vehicleApi('models',{year,make});
    VEH[year]=VEH[year]||{};VEH[year][make]=models;
    return models;
  }catch(e){
    VEH[year]=VEH[year]||{};VEH[year][make]=VEH[year][make]||[];
    return VEH[year][make];
  }
}
const $=id=>document.getElementById(id);
