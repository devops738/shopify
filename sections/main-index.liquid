function toast(b,m,s){$('toastBadge').textContent=b;$('toastMsg').innerHTML=m+(s?`<small>${s}</small>`:"");const t=$('toast');t.classList.add('show');clearTimeout(window._t);window._t=setTimeout(()=>t.classList.remove('show'),3600);}

const BRANDS=["Michelin", "Goodyear", "Continental", "Pirelli", "Falken", "Hankook", "Yokohama", "Nitto", "Kumho", "General", "Nexen", "Sumitomo", "Kelly", "Atturo", "Arroyo", "Lionhart", "Lexani", "Hercules", "Ironman", "Gladiator", "AMP", "Zestino"];
const TIRE_LOGOS={"Michelin": "{{ 'ats-inline-23.png' | asset_url }}", "Goodyear": "{{ 'ats-inline-24.png' | asset_url }}", "Continental": "{{ 'ats-inline-25.png' | asset_url }}", "Pirelli": "{{ 'ats-inline-26.png' | asset_url }}", "Falken": "{{ 'ats-inline-27.png' | asset_url }}", "Hankook": "{{ 'ats-inline-28.png' | asset_url }}", "Yokohama": "{{ 'ats-inline-29.png' | asset_url }}", "Nitto": "{{ 'ats-inline-30.png' | asset_url }}", "Kumho": "{{ 'ats-inline-31.png' | asset_url }}", "General": "{{ 'ats-inline-32.png' | asset_url }}", "Nexen": "{{ 'ats-inline-33.png' | asset_url }}", "Sumitomo": "{{ 'ats-inline-34.png' | asset_url }}", "Kelly": "{{ 'ats-inline-35.png' | asset_url }}", "Atturo": "{{ 'ats-inline-36.png' | asset_url }}", "Arroyo": "{{ 'ats-inline-37.png' | asset_url }}", "Lionhart": "{{ 'ats-inline-38.png' | asset_url }}", "Lexani": "{{ 'ats-inline-39.png' | asset_url }}", "Hercules": "{{ 'ats-inline-40.png' | asset_url }}", "Ironman": "{{ 'ats-inline-41.png' | asset_url }}", "Gladiator": "{{ 'ats-inline-42.png' | asset_url }}", "AMP": "{{ 'ats-inline-43.png' | asset_url }}", "Zestino": "{{ 'ats-inline-44.png' | asset_url }}"};
$('chips').innerHTML=BRANDS.map(b=>`<button class="blogo" onclick="goBrand('${b}','tires')" aria-label="Shop ${b} tires"><img class="blogo-img" src="${TIRE_LOGOS[b]}" alt="${b} tires" loading="lazy"></button>`).join('');
const SYM=[["Oil light on?","or 5,000+ miles since last change","Oil change"],["Pulling to one side?","or uneven tire wear","Wheel alignment"],["Squealing brakes?","or a soft pedal","Brake repair"],["Low-pressure warning?","sensor light won't clear","TPMS service"],["Slow to start?","or 3+ years on the battery","Battery service"],["Tires bought elsewhere?","need mounting & balancing","Tire installation"]];
$('symptoms').innerHTML=SYM.map(s=>`<button class="symptom" onclick="bookService()"><span class="sy-q">${s[0]}</span><span class="sy-s">${s[1]}</span><span class="sy-go">→ ${s[2]}</span></button>`).join('');
$('locs').innerHTML=STORES.map(s=>`<a class="loc-card-home" href="${storePageUrl(s)}" onclick="st.store=s;persistTireConnectState()"><div class="loc-card-home__img"><img src="${s.img}" alt="${s.name} storefront" loading="lazy"></div><div class="loc-card-home__body"><h3>${s.city}</h3><p class="addr">${s.addr}, CA ${s.zip}</p><div class="phone">${s.ph}</div><div class="hours">Mon–Fri 8–6 · Sat 8–5</div><span class="view">Store Details →</span></div></a>`).join('');
const FAQ=[["Where can I find a tire shop near me in Southern California?","American Tire Stores has 7 locations across Southern California — Ventura, Thousand Oaks, Glendale (two locations), Los Angeles, Bellflower, and Cathedral City. Choose your store above to see local pricing and same-day availability."],["Do you install tires I bought somewhere else?","Yes. Book a tire installation appointment and bring your tires — we'll mount, balance, and reset your TPMS at your local store, usually the same day."],["Do I need an appointment for tire installation or service?","Walk-ins are welcome, but booking online guarantees your spot and the shortest wait. Most fitments qualify for same-day service."],["What tire and wheel brands do you carry?","40+ tire and wheel brands, including Michelin, Goodyear, Bridgestone, Continental, Cooper, Falken, Pirelli, and more — with live local availability once you enter your vehicle and store."],["Do you offer tire financing?","Yes — $0-down financing with quick approval, so tires and service never have to wait. Apply online in minutes and use it at any location."],["How do I find the right tire size for my car?","Enter your year, make, and model and we'll show only tires and wheels that fit. Prefer to shop by size? Switch to the tire-size tab and enter your width, ratio, and rim."],["How much does a wheel alignment or brake repair cost near me?","Pricing depends on your vehicle and store. Choose your vehicle and nearest American Tire Stores location above for real, out-the-door local pricing — no calls required."]];
$('faq').innerHTML=FAQ.map(([q,a],i)=>`<div class="qa" id="qa${i}"><button onclick="toggleFaq(${i})"><span>${q}</span><span class="ic">+</span></button><div class="a"><p>${a}</p></div></div>`).join('');
function toggleFaq(i){document.getElementById('qa'+i).classList.toggle('open');}
function storePageUrl(s){const byId={52820:'/pages/location-ventura-ca',52819:'/pages/location-thousand-oaks-ca',61758:'/pages/location-los-angeles-ca',52816:'/pages/location-glendale-ca',52818:'/pages/location-glendale-ii-ca',52814:'/pages/location-bellflower-ca',52815:'/pages/location-cathedral-city-ca'};return byId[s.id]||'/pages/locations';}
function goStore(s){st.store=s;persistTireConnectState();window.location.href=storePageUrl(s);}
function toggleMenu(o){const m=document.getElementById('mobileMenu');m.classList.toggle('show',o===undefined?!m.classList.contains('show'):o);}

/* ---- close the vehicle picker on outside click / escape; init ---- */
document.addEventListener('click',e=>{const p=$('vehPop');if(p&&p.classList.contains('show')&&!e.target.closest('#vehPop')&&!e.target.closest('#vehField'))setVehPop(false);});
document.addEventListener('keydown',e=>{if(e.key==='Escape')setVehPop(false);});
restoreTireConnectState();
reflectState();
preloadTireConnect();
</script>

