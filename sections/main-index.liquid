function tireConnectUrl(path){
  const url=new URL(path,window.location.origin);
  if(st.store&&st.store.id){
    url.searchParams.set('location_id',st.store.id);
    url.searchParams.set('locationId',st.store.id);
    url.searchParams.set('store',st.store.slug||st.store.name);
  }
  if(st.mode==='vehicle'){
    if(st.year)url.searchParams.set('year',st.year);
    if(st.make)url.searchParams.set('make',st.make);
    if(st.model)url.searchParams.set('model',st.model);
  }else{
    if(st.w)url.searchParams.set('width',st.w);
    if(st.r)url.searchParams.set('ratio',st.r);
    if(st.d)url.searchParams.set('rim',st.d);
  }
  return url.toString();
}
function persistTireConnectState(){
  try{
    if(st.store){
      const storePayload={name:st.store.name,city:st.store.city,address:st.store.addr,addr:st.store.addr,zip:st.store.zip,phone:st.store.ph,id:st.store.id,location_id:st.store.id,locationId:st.store.id};
      localStorage.setItem('atsTireConnectStore',JSON.stringify(storePayload));
      sessionStorage.setItem('atsTireConnectStore',JSON.stringify(storePayload));
      ['atsTireConnectLocationId','tcLocationId','tc_location_id','location_id','locationId'].forEach(k=>{localStorage.setItem(k,String(st.store.id));sessionStorage.setItem(k,String(st.store.id));});
    }
    if(st.mode==='vehicle'&&st.year&&st.make&&st.model){
      const vehiclePayload={year:st.year,make:st.make,model:st.model};
      ['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'].forEach(k=>{localStorage.setItem(k,JSON.stringify(vehiclePayload));sessionStorage.setItem(k,JSON.stringify(vehiclePayload));});
    }else{
      ['atsTireConnectVehicle','tcVehicle','tc_vehicle','tcwlwVehicle','tcwlw_vehicle','TCWidgetVehicle'].forEach(k=>{localStorage.removeItem(k);sessionStorage.removeItem(k);});
    }
    window.dispatchEvent(new CustomEvent('ats:tireconnect-updated'));
  }catch(e){}
}
function writeTireConnectQueryState(){
  try{
    const params=new URLSearchParams(window.location.search);
    if(st.store&&st.store.id){params.set('location_id',st.store.id);params.set('locationId',st.store.id);}
    if(st.year)params.set('year',st.year);
    if(st.make)params.set('make',st.make);
    if(st.model)params.set('model',st.model);
    const next=`${window.location.pathname}?${params.toString()}${window.location.hash||''}`;
    if(!isShopifyThemePreview()&&params.toString())window.history.replaceState({},'',next);
  }catch(e){}
}
function restoreTireConnectState(){
  try{
    const params=new URLSearchParams(window.location.search);
    const locationId=params.get('location_id')||params.get('locationId')||localStorage.getItem('atsTireConnectLocationId')||sessionStorage.getItem('atsTireConnectLocationId')||'';
    if(locationId){const match=STORES.find(s=>String(s.id)===String(locationId));if(match)st.store=match;}
    st.year=params.get('year')||'';
    st.make=params.get('make')||'';
    st.model=params.get('model')||'';
  }catch(e){}
}
function isShopifyThemePreview(){
  return !!(window.Shopify&&Shopify.designMode)||/[?&](preview_theme_id|_fd|pb)=/.test(window.location.search);
}
function loadTireConnectScript(){
  return new Promise((resolve,reject)=>{
    if(window.TCWidget){resolve();return;}
    const existing=document.querySelector('script[src="https://app.tireconnect.ca/js/widget.js"]');
    if(existing){existing.addEventListener('load',resolve,{once:true});existing.addEventListener('error',reject,{once:true});return;}
    const script=document.createElement('script');
    script.src='https://app.tireconnect.ca/js/widget.js';
    script.async=true;
    script.addEventListener('load',resolve,{once:true});
    script.addEventListener('error',reject,{once:true});
    document.head.appendChild(script);
  });
}
function preloadTireConnect(){
  if(isShopifyThemePreview()||window._tcPreloaded)return;
  window._tcPreloaded=true;
  persistTireConnectState();
  loadTireConnectScript().catch(()=>{window._tcPreloaded=false;});
}
function normTxt(v){return String(v||'').trim().toLowerCase();}
function selectWidgetValue(select,value){
  if(!select||!value)return false;
  const want=normTxt(value);
  const opt=[...select.options].find(o=>normTxt(o.value)===want||normTxt(o.textContent)===want||normTxt(o.textContent).includes(want));
  if(!opt)return false;
  select.value=opt.value;
  select.dispatchEvent(new Event('input',{bubbles:true}));
  select.dispatchEvent(new Event('change',{bubbles:true}));
  return true;
}
function syncTireConnectRenderedVehicle(){
  if(!(st.year&&st.make&&st.model))return;
  const root=$('tcInlineWidget');
  if(!root)return;
  let tries=0;
  const tick=()=>{
    tries++;
    let selects=[...root.querySelectorAll('select')];
    if(!selects.length){
      try{
        const frame=root.querySelector('iframe');
        if(frame&&frame.contentDocument)selects=[...frame.contentDocument.querySelectorAll('select')];
      }catch(e){}
    }
    const yearSel=selects.find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.year)||normTxt(o.value)===normTxt(st.year)));
    const makeSel=selects.find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.make)||normTxt(o.value)===normTxt(st.make)));
    const modelSel=selects.find(s=>[...s.options].some(o=>normTxt(o.textContent)===normTxt(st.model)||normTxt(o.value)===normTxt(st.model)));
    if(yearSel)selectWidgetValue(yearSel,st.year);
    setTimeout(()=>{if(makeSel)selectWidgetValue(makeSel,st.make);},180);
    setTimeout(()=>{if(modelSel)selectWidgetValue(modelSel,st.model);},380);
    if(tries<24&&(!yearSel||!makeSel||!modelSel))setTimeout(tick,350);
  };
  setTimeout(tick,250);
}
function syncTireConnectRenderedSearchMode(){
  const root=$('tcInlineWidget');
  if(!root)return;
  const mode=st.mode==='size'?'size':'vehicle';
  let tries=0;
  const tick=()=>{
    tries++;
    let selects=[...root.querySelectorAll('select')];
    if(!selects.length){
      try{
        const frame=root.querySelector('iframe');
        if(frame&&frame.contentDocument)selects=[...frame.contentDocument.querySelectorAll('select')];
      }catch(e){}
    }
    const searchBy=selects.find(s=>s.getAttribute('data-tcwlw')==='search_by'||[...s.options].some(o=>['size','vehicle','license_plate'].includes(normTxt(o.value))));
    const changed=searchBy?selectWidgetValue(searchBy,mode):false;
    if(tries<24&&!changed)setTimeout(tick,350);
  };
  setTimeout(tick,180);
}
function widgetSelects(){
  const root=$('tcInlineWidget');
  if(!root)return [];
  let selects=[...root.querySelectorAll('select')];
  if(!selects.length){
    try{
      const frame=root.querySelector('iframe');
      if(frame&&frame.contentDocument)selects=[...frame.contentDocument.querySelectorAll('select')];
    }catch(e){}
  }
  return selects;
}
function syncTireConnectRenderedTireSize(){
  if(!(st.mode==='size'&&st.w&&st.r&&st.d))return;
  let tries=0;
  const pickByName=(names)=>{
    const list=widgetSelects();
    return list.find(s=>names.some(n=>String(s.name||'').toLowerCase()===n||String(s.getAttribute('data-tcwlw')||'').toLowerCase()===n));
  };
  const tick=()=>{
    tries++;
    const widthSel=pickByName(['width_0','width','tire_width']);
    const widthOk=widthSel?selectWidgetValue(widthSel,st.w):false;
    setTimeout(()=>{
      const profileSel=pickByName(['height_0','height','profile','ratio']);
      if(profileSel)selectWidgetValue(profileSel,st.r);
    },260);
    setTimeout(()=>{
      const rimSel=pickByName(['rim_0','rim','wheel_size','wheel']);
      if(rimSel)selectWidgetValue(rimSel,st.d);
    },620);
    const allNow=()=>{
      const width=pickByName(['width_0','width','tire_width']);
      const profile=pickByName(['height_0','height','profile','ratio']);
      const rim=pickByName(['rim_0','rim','wheel_size','wheel']);
      return width&&normTxt(width.value)===normTxt(st.w)&&profile&&normTxt(profile.value)===normTxt(st.r)&&rim&&normTxt(rim.value)===normTxt(st.d);
    };
    setTimeout(()=>{if(tries<30&&!allNow())setTimeout(tick,350);},780);
  };
  setTimeout(tick,360);
}
