async function hOnYear(){st.year=$('hyear').value;st.make='';st.model='';reflectState();await loadMakesForYear(st.year);reflectState();if(st.year&&$('hmake'))$('hmake').focus();}
async function hOnMake(){st.make=$('hmake').value;st.model='';reflectState();await loadModelsForMake(st.year,st.make);reflectState();if(st.make&&$('hmodel'))$('hmodel').focus();}
