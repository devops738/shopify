    const base={apikey:apiKey,apiKey:apiKey,api_key:apiKey,key:apiKey,container:'tcInlineWidget',locationId:locId,location_id:locId,location:locId,locationID:locId,location_lock:!!locId,locationLock:!!locId,locationSelector:'lock',locationList:true,locator:true,locale:'en_US',allowed_products:['tire','wheel','package'],product_type:'tire,wheel,package',productType:'tire,wheel,package',layout:'full',view:'full',display:'full',redirect_url:'/pages/tire-search',redirectUrl:'/pages/tire-search',catalog_url:'/pages/tire-search',catalogUrl:'/pages/tire-search',services_widget_url:'/pages/services',servicesUrl:'/pages/services',searchParams:{location_id:locId,locationId:locId}};
    if(st.mode==='vehicle'&&st.year&&st.make&&st.model){base.fitment='vehicle';base.searchBy='vehicle';base.search_by='vehicle';base.searchType='vehicle';base.type='vehicle';base.year=st.year;base.make=st.make;base.model=st.model;base.vehicleYear=st.year;base.vehicleMake=st.make;base.vehicleModel=st.model;base.vehicle_year=st.year;base.vehicle_make=st.make;base.vehicle_model=st.model;base.selectedYear=st.year;base.selectedMake=st.make;base.selectedModel=st.model;base.vehicle={year:st.year,make:st.make,model:st.model};base.vehicleParams={year:st.year,make:st.make,model:st.model};base.searchParams.search_by='vehicle';base.searchParams.searchBy='vehicle';base.searchParams.year=st.year;base.searchParams.make=st.make;base.searchParams.model=st.model;base.searchParams.vehicle={year:st.year,make:st.make,model:st.model};}
    if(st.mode==='size'&&st.w&&st.r&&st.d){base.fitment='size';base.searchBy='size';base.search_by='size';base.searchType='size';base.type='size';base.tire_size=`${st.w}/${st.r}R${st.d}`;base.tireSize=`${st.w}/${st.r}R${st.d}`;base.width=st.w;base.width_0=st.w;base.profile=st.r;base.height=st.r;base.height_0=st.r;base.ratio=st.r;base.wheel_size=st.d;base.wheelSize=st.d;base.rim=st.d;base.rim_0=st.d;base.diameter=st.d;base.searchParams.search_by='size';base.searchParams.searchBy='size';base.searchParams.width=st.w;base.searchParams.width_0=st.w;base.searchParams.profile=st.r;base.searchParams.height=st.r;base.searchParams.height_0=st.r;base.searchParams.ratio=st.r;base.searchParams.wheel_size=st.d;base.searchParams.rim=st.d;base.searchParams.rim_0=st.d;}
    if(typeof window.TCWidget.init==="function"){window.TCWidget.init(base);syncTireConnectRenderedSearchMode();syncTireConnectRenderedTireSize();syncTireConnectRenderedVehicle();return;}
    target.innerHTML='<div class="tc-loading">TireConnect loaded, but the Tire & Wheel widget initializer was not found.</div>';
  }).catch(()=>{target.innerHTML='<div class="tc-loading">TireConnect failed to load. Check API key or network settings.</div>';});
}
function closeTireConnect(){const overlay=$('tcOverlay');if(overlay)overlay.classList.remove('show');}
function pathWithState(path){return tireConnectUrl(path);}
function goPath(path){persistTireConnectState();window.location.href=pathWithState(path);}
function brandSlug(name){return String(name||'').toLowerCase().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');}
function goBrand(name,type='tires'){goPath(`/pages/brand-${brandSlug(name)}-${type}`);}
