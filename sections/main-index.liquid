<script>
(function(){
  function removeAtsTopGap(){
    var section=document.getElementById('shopify-section-main-index');
    if(!section)return;
    [document.documentElement,document.body,section,section.parentElement,section.closest('main'),document.getElementById('MainContent')].forEach(function(el){
      if(!el)return;
      el.style.marginTop='0px';
      el.style.paddingTop='0px';
    });
    var promo=section.querySelector('.promo');
    if(promo){
      promo.style.marginTop='0px';
      promo.style.paddingTop='0px';
      promo.style.top='0px';
    }
    var top=section.getBoundingClientRect().top;
    if(top>1 && top<180){
      section.style.transform='translateY(-'+Math.ceil(top)+'px)';
      section.style.marginBottom='-'+Math.ceil(top)+'px';
    }
  }
  removeAtsTopGap();
  window.addEventListener('load',removeAtsTopGap,{once:true});
  requestAnimationFrame(removeAtsTopGap);
  setTimeout(removeAtsTopGap,300);
})();
</script>
